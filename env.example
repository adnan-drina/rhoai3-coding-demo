# Local environment for rhoai3-coding-demo — copy to .env and fill in.
# All deploy/validate scripts call load_env() which sources .env if present.
# This template mirrors the keys the demo actually uses, nothing more.
# Optional tuning knobs (GuideLLM, GPU resume, MCP tokens) are documented
# in the consuming stage READMEs and default sensibly when unset.

# Git source for Argo CD Applications; deploy.sh rewrites repoURL and
# targetRevision from these (supports forks and branches).
GIT_REPO_URL=https://github.com/adnan-drina/rhoai3-coding-demo.git
GIT_REPO_BRANCH=main

# Safety guard: scripts refuse live OpenShift work unless the current API
# server contains this substring (unique cluster id or full API hostname).
RHOAI_EXPECTED_API_SERVER=

# Cluster login convenience (not consumed by any script):
#   oc login "$OPENSHIFT_API_URL" -u "$OPENSHIFT_USER" -p "$OPENSHIFT_PASSWORD"
OPENSHIFT_API_URL=
OPENSHIFT_CONSOLE_URL=
OPENSHIFT_USER=
OPENSHIFT_PASSWORD=

# Demo persona passwords (Stage 010 setup-access.sh). If left empty,
# setup-access.sh GENERATES RANDOM values at run time — set explicit values
# so walkthrough credentials stay stable across re-runs.
AI_ADMIN_PASSWORD=
AI_DEVELOPER_PASSWORD=

# OpenAI API key for the governed external model gpt-4o-mini (Stage 040).
# deploy.sh provisions this into the openai-provider-api-key Secret.
OPENAI_API_KEY=

# Red Hat internal models (Stage 040 external models for AI coding).
# One upstream API key covers qwen3-235b and minimax-m2 (key is named
# "rhoai3-coding-demo" on the internal LiteLLM platform). deploy.sh
# provisions it into the redhat-models-provider-api-key Secret.
REDHAT_MODELS_API_KEY=
# Shared OpenAI-compatible base URL of the internal platform,
# e.g. https://maas-rhdp.apps.maas.redhatworkshops.io
REDHAT_MODELS_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────
# Stage 050 one-time external setup (GitHub + Quay.io)
#
# A new deployer must configure two external services before stage 050's
# delivery chain (git push → pipeline → registry) works end to end.
#
# 1) GitHub — application repositories, GitHub App, and a PAT
#    a. Fork/clone the app repositories into your GitHub account or org
#       (at minimum `coolstore-inventory-service`, keeping its `golden`
#       branch — the demo-reset baseline). Update GIT_REPO_URL above if
#       you forked the platform repo itself.
#    b. Create a GitHub App (github.com → Settings → Developer settings →
#       GitHub Apps → New): one App serves ALL demo repositories because
#       the platform runs a single dispatcher EventListener in the
#       `app-platform-build` namespace.
#       - Webhook URL: the EventListener route after stage 050 deploys —
#         `oc get route -n app-platform-build` (set a placeholder first,
#         update the App once the route exists).
#       - Webhook secret: the exact value of GITHUB_WEBHOOK_SECRET below
#         (any random string; generate with `openssl rand -hex 20`).
#       - Permissions: Repository → Contents: Read-only, Metadata:
#         Read-only. Subscribe to events: Push.
#       - Install the App on the account/org and grant it the demo
#         repositories (or all repositories, so stage 070's scaffolded
#         repos are covered automatically as they are created).
#    c. Create a classic PAT with `repo` scope on the same account/org.
#       It is used by the RHDH scaffolder (create + push new repos), the
#       pipeline git-clone task, catalog generation hooks, and
#       scripts/reset-coolstore-demo.sh (force-push main to golden).
#
# 2) Quay.io — organization and robot account
#    a. Create a quay.io organization (e.g. `rhoai3-coding-demo`) and set
#       IMAGE_REGISTRY to `quay.io/<org>`.
#    b. Create a robot account (org → Robot Accounts) and grant it
#       **Write** at the organization level. The pipeline pushes per-SHA
#       tags and re-tags `:latest`; repositories are auto-created on
#       first push.
#    c. Visibility caveat: quay.io has NO org-wide default-visibility
#       setting — every auto-created repository starts PRIVATE. In-cluster
#       pulls work via the provisioned quay pull Secret, but flip each app
#       repository to Public (repo → Settings → Repository Visibility)
#       if you want anonymous pulls or browsable image links in the demo.
#
# deploy.sh provisions the four values below into cluster Secrets; rotate
# by updating .env and re-running the stage 050 deploy.
# ─────────────────────────────────────────────────────────────────────────

# GitHub webhook shared secret — must match the Webhook secret configured
# on the GitHub App (see 1b above).
GITHUB_WEBHOOK_SECRET=
# GitHub PAT (classic, `repo` scope) — scaffolder, git-clone, hooks, reset
# script (see 1c above).
GITHUB_TOKEN=

# External image registry prefix, e.g. quay.io/rhoai3-coding-demo (see 2a
# above). When empty, the pipeline falls back to the internal OpenShift
# registry and no Quay setup is needed.
IMAGE_REGISTRY=
# Robot account credentials with org-level write permission (see 2b above),
# e.g. QUAY_ROBOT_USER=rhoai3-coding-demo+demo_robot
QUAY_ROBOT_USER=
QUAY_ROBOT_TOKEN=
