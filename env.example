# Local environment overrides for rhoai3-coding-demo
# Copy to .env and fill in values as needed.
# All deploy/validate scripts call load_env() which sources .env if present.

# Git source for Argo CD Applications; deploy.sh rewrites repoURL and
# targetRevision from these (supports forks and branches).
GIT_REPO_URL=https://github.com/adnan-drina/rhoai3-coding-demo.git
GIT_REPO_BRANCH=main

# Safety guard: scripts refuse live OpenShift work unless the current API server
# contains this substring. Use a unique cluster id or full API hostname.
RHOAI_EXPECTED_API_SERVER=
# RHOAI_ALLOW_UNGUARDED_CLUSTER=false
# RHOAI_OC_REQUEST_TIMEOUT=10s

# --- Required for external model inference (Stage 040) ---
# OpenAI API key for governed external models (gpt-4o, gpt-4o-mini).
# deploy.sh provisions this into the openai-api-key Secret in the maas namespace.
# Without this, external models register but inference calls fail.
OPENAI_API_KEY=

# --- Optional: MCP server credentials (Stage 040) ---
# These enable optional MCP components. Leave empty to skip.

# Slack MCP server — enables AI assistants to post to Slack channels.
# Requires a Slack App with chat:write scope. Get from: https://api.slack.com/apps
SLACK_BOT_TOKEN=

# BrightData MCP server — enables AI assistants to browse/search the public web.
# Get from: https://brightdata.com/cp/setting/users
BRIGHTDATA_API_TOKEN=

# --- Optional: GPU demo resume controls ---
# Used by scripts/resume-gpu-demo.sh when resuming Stage 020/030 after GPU
# nodes were scaled to zero for cost saving.
GPU_MACHINESET_REPLICAS=2
GPU_RESUME_TIMEOUT_SECONDS=1800

# --- Optional: Stage 040 GuideLLM load test controls ---
# Stage 040 validation runs a short GuideLLM load test when a MaaS API key is
# available. Defaults are intentionally small for demo environments.
GUIDELLM_SKIP_LOAD_TEST=false
GUIDELLM_MODEL=nemotron-3-nano-30b-a3b
GUIDELLM_PROFILE=constant
GUIDELLM_RATE=1
GUIDELLM_MAX_SECONDS=20
GUIDELLM_REQUESTS=5
GUIDELLM_PROCESSOR=gpt2
GUIDELLM_OUTPUT_TOKENS=64
GUIDELLM_PROMPT="Explain why governed model access matters for enterprise software teams. Keep the answer concise."
GUIDELLM_COMPARE_MODELS="qwen3-6-35b-a3b nemotron-3-nano-30b-a3b"

# --- Optional: Stage 040 external model smoke test controls ---
# External inference validation is opt-in because it can spend provider tokens.
GUIDELLM_EXTERNAL_SMOKE_TEST=false

# --- Optional: Stage 050 app-platform build pipeline credentials ---
# deploy.sh provisions these into the app-platform-build namespace.
# GitHub webhook shared secret for the shared EventListener (any random
# string; the golden-path templates register webhooks with the same value).
GITHUB_WEBHOOK_SECRET=
# GitHub PAT used by the pipeline git-clone task for private repositories.
# Leave empty when the template-provisioned repos are public.
GITHUB_TOKEN=

# --- Optional: Stage 050 external image registry (quay.io) ---
# When set, deploy.sh provisions the quay-push-secret and the
# app-platform-build-config ConfigMap; the shared pipeline then pushes
# images to ${IMAGE_REGISTRY}/<repo-name>:<revision>. When empty, the
# pipeline falls back to the internal OpenShift registry.
# Registry/namespace prefix, e.g. quay.io/adnan-drina
IMAGE_REGISTRY=
# Robot account credentials with push permission on the organization
QUAY_ROBOT_USER=
QUAY_ROBOT_TOKEN=
