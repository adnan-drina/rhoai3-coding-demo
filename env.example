# Local environment for rhoai3-coding-demo — copy to .env and fill in.
# All deploy/validate scripts call load_env() which sources .env if present.
# This template mirrors the keys the demo actually uses, nothing more.
# Optional tuning knobs (GuideLLM, GPU resume, MCP tokens) are documented
# in the consuming stage READMEs and default sensibly when unset.

# Git source for Argo CD Applications; deploy.sh rewrites repoURL and
# targetRevision from these (supports forks and branches).
GIT_REPO_URL=https://github.com/adnan-drina/rhoai3-coding-demo.git
GIT_REPO_BRANCH=main

# Safety guard: scripts refuse live OpenShift work unless the current API
# server contains this substring (unique cluster id or full API hostname).
RHOAI_EXPECTED_API_SERVER=

# Cluster login convenience (not consumed by any script):
#   oc login "$OPENSHIFT_API_URL" -u "$OPENSHIFT_USER" -p "$OPENSHIFT_PASSWORD"
OPENSHIFT_API_URL=
OPENSHIFT_CONSOLE_URL=
OPENSHIFT_USER=
OPENSHIFT_PASSWORD=

# Demo persona passwords (Stage 010 stages/010-openshift-ai-platform-foundation/deploy.sh). If left empty,
# stages/010-openshift-ai-platform-foundation/deploy.sh GENERATES RANDOM values at run time — set explicit values
# so walkthrough credentials stay stable across re-runs.
AI_ADMIN_PASSWORD=
AI_DEVELOPER_PASSWORD=

# OpenAI API key for the governed external model gpt-6-luna (Stage 040).
# deploy.sh provisions this into the openai-provider-api-key Secret.
OPENAI_API_KEY=
# Anthropic provider credential, supplied privately; never commit a value.
ANTHROPIC_API_KEY=
# NVIDIA API key (build.nvidia.com) for the governed external model
# nemotron-3-ultra-550b-a55b; deploy.sh provisions it into the
# nvidia-provider-api-key Secret. Never commit a value.
NVIDIA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Stage 070 uses private GitLab groups and project-bound webhooks. GitOps
# generates scoped integrations and the bootstrap administrator credential.
# No GitHub App or PAT is required for its new developer workflows. The public
# GitHub platform source remains the bootstrap upstream until root cutover.

# External registry prefix for selected shared releases only. Stage 070
# application pipelines do not read this value.
IMAGE_REGISTRY=
# Robot credentials for authorized shared-image release scripts only,
# e.g. QUAY_ROBOT_USER=rhoai3-coding-demo+demo_robot
QUAY_ROBOT_USER=
QUAY_ROBOT_TOKEN=

# Stage 010 existing OpenID personas (authenticate each through the provider).
RHOAI_ADMIN_USER=ai-admin
RHOAI_DEVELOPER_USER=ai-developer
# Private local kubeconfigs for actual persona acceptance; never commit them.
# Create or refresh them with stages/010-openshift-ai-platform-foundation/personas/login.sh (browser sign-in; tokens expire).
RHOAI_ADMIN_KUBECONFIG=
RHOAI_DEVELOPER_KUBECONFIG=

# Fresh demo operator lifecycle: standard cluster credentials only.
# Cloud STS/workload-identity configurations require their documented Manual flow.
RHOAI_OPERATOR_CREDENTIAL_MODE=standard

# Stage 060 deploy.sh: the OpenShell CLI binary pinned in
# gitops/stages/060-agent-runtime-and-agentops/060-openshell-runtime/chart/source-pins.json
# (cliBinarySha256); it configures the ai-agents gateway workspace.
RHOAI_STAGE060_OPENSHELL_CLI=
