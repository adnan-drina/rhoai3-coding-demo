  templates__agentic-quarkus-scaffold__template.yaml: |
    apiVersion: scaffolder.backstage.io/v1beta3
    kind: Template
    metadata:
      name: agentic-quarkus-scaffold
      title: New Quarkus app
      description: "Scaffolds a brand-new Quarkus application repository with corporate\nstandards as agent-executable assets (AGENTS.md + OpenCode skills) and a\nspec template for spec-driven development. Registered in the catalog, and\nprovisioned with its own namespace and delivery pipeline (SonarQube\nquality gate included) \u2014 the repository's first push bootstraps the\nproject stack through the platform dispatcher.\n"
      tags:
      - golden-path
      - agentic
      - quarkus
      - spec-driven
    spec:
      owner: ai-modernization-team
      type: service
      parameters:
      - title: Application repository
        required:
        - name
        properties:
          name:
            title: Application name
            type: string
            description: 'Name for the new application (e.g. claims-notification-service).

              Lowercase letters, numbers, and hyphens.

              '
            pattern: ^[a-z][a-z0-9-]{2,40}$
            ui:autofocus: true
      steps:
      - id: platform-entity
        name: Read platform link endpoints from the catalog
        action: catalog:fetch
        input:
          entityRef: component:default/coolstore-inventory-service
      - id: fetch-golden
        name: Fetch Quarkus scaffold golden repository
        action: fetch:plain
        input:
          url: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/application-golden-url'] }}
      - id: add-catalog-info
        name: Add catalog metadata
        action: fetch:template
        input:
          url: ./skeleton
          replace: true
          values:
            name: ${{ parameters.name }}
            sonarqubeUrl: ${{ steps['platform-entity'].output.entity.metadata.links[3].url | replace('coolstore-inventory-service', parameters.name) }}
            devspacesUrl: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/devspaces-base-url'] }}/#${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-base-url'] }}/${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-workload-group'] }}/${{ parameters.name }}?revision=main&existing=${{ parameters.name }}
            gitlabBaseUrl: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-base-url'] }}
            gitlabGroup: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-workload-group'] }}
      - id: publish
        name: Publish private repository to GitLab
        action: publish:gitlab
        input:
          repoUrl: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-host'] }}?owner=${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-workload-group'] }}&repo=${{ parameters.name }}
          defaultBranch: main
          settings:
            description: 'Quarkus application scaffold (golden path: agentic, spec-driven development)'
            visibility: private
            topics:
            - rhoai3-golden-path
            - rhoai3-scaffolded
      - id: enroll
        name: Request platform enrollment of the immutable first commit
        action: gitlab:issues:create
        input:
          repoUrl: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-host'] }}?owner=rhoai-platform&repo=platform-enrollment
          projectId: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-registration-project-id'] | int }}
          title: Enroll ${{ parameters.name }}
          labels: platform-enrollment
          confidential: true
          description: '{"project_id": ${{ steps.publish.output.projectId }}, "initial_commit": "${{ steps.publish.output.commitHash }}", "kind": "application", "requester": "${{ user.ref }}"}'
      output:
        links:
        - title: Source repository
          url: ${{ steps.publish.output.remoteUrl }}
        - title: Open in catalog
          icon: catalog
          entityRef: component:default/${{ parameters.name }}
        text:
        - title: Next steps
          content: "The publish above requested platform enrollment. The catalog discovers your project automatically; Argo CD is\ncreating the `<name>-dev` namespace with the project's own delivery\npipeline, and build credentials arrive within two minutes.\n\nOpen the repository in Dev Spaces and start OpenCode in the\nterminal. The project ships spec-kit: run `/speckit.specify` with\nyour requirements (the stage 070 exercise provides coolstore-catalog\nbriefs) \u2014 it creates `specs/<n>-<feature>/spec.md` \u2014 then\n`/speckit.plan`, `/speckit.tasks`, and `/speckit.implement`. The\nagent reads AGENTS.md and `.opencode/skills/` \u2014 corporate\nstandards steer the build. Every push to `main` runs the project's\nown pipeline in `<name>-dev` with the SonarQube quality gate.\n"
