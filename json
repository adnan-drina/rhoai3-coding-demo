        exec:
          label: "2. Start Development mode (Hot reload + debug)"
          component: development-tooling
          workingDir: ${PROJECT_SOURCE}
          commandLine: 'export JAVA_HOME="${JAVA_HOME_21:-${JAVA_HOME}}" && export PATH="${JAVA_HOME}/bin:${PATH}" && mvn compile quarkus:dev'
          group:
            kind: run
            isDefault: true
    events:
      postStart:
        - init-ai-tools
