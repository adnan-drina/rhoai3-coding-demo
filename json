  jobs__catalog__generate.sh: |
    #!/usr/bin/env bash
    # RHDH runtime catalog generator (B2). Runs from the rhdh-catalog-bundle
    # ConfigMap: this script, render_catalog.py, the catalog and every template
    # and skeleton file, generated by kustomize from ONE checkout. Consumed by
    # BOTH the Sync-hook Job (immediate regeneration on full syncs) and the
    # refresh CronJob (convergence after the selective syncs that skip hooks;
    # SKIP_IF_CURRENT=true exits fast when the published catalog already carries
    # this bundle at this revision).
    #
    # The revision is the one Argo CD synced, never the branch head: the bundle
    # name carries a content hash, so a catalog-only or template-only commit IS a
    # manifest change Argo applies, and the old reason to chase HEAD is gone.
    # Nothing is published unless every bundled file is what that revision holds
    # (FACTORY_BUNDLE_MISMATCH) and the rendered catalog resolves every
    # placeholder; on any refusal the runtime catalog stays as it was.
    set -euo pipefail

    # A recurring refresh is not the publisher for an in-flight platform upgrade.
    # The mandatory wave-17 Sync hook verifies that transaction after its mirror
    # exists. Keep the last catalog during the transaction; publish nothing here.
    if [ "${SKIP_IF_CURRENT:-false}" = "true" ]; then
      ACTIVE_OPERATION=$(oc get application 070-rhdh -n openshift-gitops \
        -o jsonpath='{.operation}' 2>/dev/null || true)
      ACTIVE_PHASE=$(oc get application 070-rhdh -n openshift-gitops \
        -o jsonpath='{.status.operationState.phase}' 2>/dev/null || true)
      if [ -n "$ACTIVE_OPERATION" ] && [[ "$ACTIVE_PHASE" = Running || "$ACTIVE_PHASE" = Terminating ]]; then
        echo 'Catalog refresh deferred to the active source-bound platform Sync hook; nothing published'
        exit 0
      fi
    fi

    SRC="${BUNDLE_DIR:-/bundle}"
    BUNDLE="$(mktemp -d /tmp/rhdh-catalog-bundle.XXXXXX)"
    # one local copy per invocation: a projected-volume update mid-run cannot mix
    # two generations of the bundle
    for f in "${SRC}"/*; do
      [ -f "$f" ] && cp "$f" "${BUNDLE}/"
    done
    RENDER="python3 ${BUNDLE}/jobs__catalog__render_catalog.py"
    BUNDLE_ID=$(${RENDER} digest --bundle "${BUNDLE}")

    APP_SYNC_REVISION=$(oc get application 070-rhdh -n openshift-gitops \
      -o jsonpath='{.status.operationState.syncResult.revision}' 2>/dev/null || true)
    [ -z "$APP_SYNC_REVISION" ] && APP_SYNC_REVISION=$(oc get application 070-rhdh -n openshift-gitops \
      -o jsonpath='{.status.sync.revision}' 2>/dev/null || true)
    # The private GitLab mirror must contain this exact bundle revision before
    # the portal publishes any template links. No stale GitHub reader fallback.
    SCM_CONFIG_FILE="${SCM_CONFIG_FILE:-/gitlab-config/platform.json}"
    REPO_NO_GIT=$(python3 - "${SCM_CONFIG_FILE}" <<'PYSCM'
    import json, re, sys
    from urllib.parse import urlsplit
    value = json.load(open(sys.argv[1]))['PLATFORM_CATALOG_REPO']
    parsed = urlsplit(value)
    if (parsed.scheme != 'https' or not re.fullmatch(r'gitlab-gitlab-system\.[a-z0-9.-]+', parsed.hostname or '')
            or parsed.username or parsed.password or parsed.port or parsed.query or parsed.fragment
            or parsed.path not in ('/rhoai-platform/rhoai3-coding-demo', '/rhoai-platform/rhoai3-coding-demo.git')
            or '\n' in value):
        raise SystemExit('Invalid GitLab platform catalog repository')
    print(value[:-4] if value.endswith('.git') else value)
    PYSCM
    )
    if [ -n "${CATALOG_RAW_BASE:-}" ]; then
      # Tests only: a file:// repository standing in for the private GitLab API.
      RAW_BASE="${CATALOG_RAW_BASE}"
    else
      RAW_BASE="gitlab+${REPO_NO_GIT}"
    fi

    if [ "${SKIP_IF_CURRENT:-false}" = "true" ]; then
      STAMPED=$(oc get configmap catalog-runtime-rhdh -n rhdh \
        -o jsonpath='{.metadata.annotations.rhoai3\.redhat\.com/catalog-revision}' 2>/dev/null || true)
      STAMPED_BUNDLE=$(oc get configmap catalog-runtime-rhdh -n rhdh \
        -o jsonpath='{.metadata.annotations.rhoai3\.redhat\.com/catalog-bundle}' 2>/dev/null || true)
      PENDING=$(oc get configmap catalog-runtime-rhdh -n rhdh \
        -o jsonpath='{.data.all\.yaml}' 2>/dev/null | grep -c -E "pending.local|__RHOAI3_" || true)
      if [ -n "$STAMPED" ] && [ "$STAMPED" = "$APP_SYNC_REVISION" ] && [ "$STAMPED_BUNDLE" = "$BUNDLE_ID" ] && [ "${PENDING:-0}" = "0" ]; then
        echo "Catalog current (bundle ${BUNDLE_ID:0:16} at ${STAMPED}, no pending links); nothing to do"
        exit 0
      fi
      echo "Catalog stale (stamped=${STAMPED:-none}/${STAMPED_BUNDLE:0:16}, synced=${APP_SYNC_REVISION}/${BUNDLE_ID:0:16}, pending-links=${PENDING:-0}); regenerating"
    fi

    ${RENDER} verify --bundle "${BUNDLE}" --raw-base "${RAW_BASE}" --revision "${APP_SYNC_REVISION}"

    echo "Discovering Dev Spaces route..."
    DEVSPACES_HOST=$(oc get route devspaces -n openshift-devspaces -o jsonpath='{.spec.host}' 2>/dev/null || true)
    if [ -z "$DEVSPACES_HOST" ]; then
      DEVSPACES_HOST=$(oc get route -n openshift-devspaces --no-headers 2>/dev/null \
        | awk '/devspaces/ {print $2; exit}' || true)
    fi
    if [ -z "$DEVSPACES_HOST" ]; then
      # On a first-ever sync the CheCluster (wave 10) has not created the
      # route yet; the host is deterministic, derive it from the ingress domain.
      APPS_DOMAIN=$(oc get ingresses.config.openshift.io cluster \
        -o jsonpath='{.spec.domain}' 2>/dev/null || true)
      if [ -n "$APPS_DOMAIN" ]; then
        DEVSPACES_HOST="devspaces.${APPS_DOMAIN}"
        echo "Dev Spaces route not created yet; derived host ${DEVSPACES_HOST} from cluster ingress domain"
      fi
    fi
    if [ -z "$DEVSPACES_HOST" ]; then
      echo "ERROR: Dev Spaces route not found and cluster ingress domain unavailable"
      exit 1
    fi

    # Coolstore dev route (deployed-app link on the inventory component);
    # tolerate absence — the wave-21 Route may not exist on first sync.
    COOLSTORE_HOST=$(oc get route coolstore-inventory-service -n coolstore-dev \
      -o jsonpath='{.spec.host}' 2>/dev/null || true)
    SONARQUBE_HOST=$(oc get route sonarqube -n sonarqube \
      -o jsonpath='{.spec.host}' 2>/dev/null || true)

    # In-cluster MaaS route for migration workspaces. The app-migration template
    # reads these two values from the platform entity and stamps a pod hostAlias
    # at creation, so no workspace starts on the public ELB path. Read from the
    # platform Gateway and internal Service; render refuses
    # to publish without valid values.
    MAAS_HOST=$(oc get gateway maas-default-gateway -n openshift-ingress \
      -o json | python3 -c 'import json,sys; hosts=[l.get("hostname","") for l in json.load(sys.stdin)["spec"]["listeners"] if l.get("hostname","").startswith("maas.")]; assert len(hosts)==1, "Expected one maas. listener"; print(hosts[0])')
    MAAS_INTERNAL_IP=$(oc get service maas-gateway-internal -n openshift-ingress \
      -o jsonpath='{.spec.clusterIP}' 2>/dev/null || true)

    echo "Rendering runtime catalog (bundle ${BUNDLE_ID:0:16} at ${APP_SYNC_REVISION})..."
    # The Backstage CR consumes this ConfigMap and creates the RHDH Route later;
    # TechDocs links stay relative during catalog bootstrap (empty RHDH URL).
    ${RENDER} render --bundle "${BUNDLE}" --out ${BUNDLE}/.catalog-runtime.yaml \
      --revision "${APP_SYNC_REVISION}" --devspaces-url "https://${DEVSPACES_HOST}" --rhdh-url "" \
      --coolstore-url "https://${COOLSTORE_HOST:-coolstore-pending.local}" \
      --sonarqube-url "https://${SONARQUBE_HOST:-sonarqube-pending.local}" \
      --maas-host "${MAAS_HOST}" --maas-internal-ip "${MAAS_INTERNAL_IP}" \
      --scm-config "${SCM_CONFIG_FILE}"

    python3 - ${BUNDLE}/.catalog-runtime.yaml ${BUNDLE}/.catalog-patch.json "${APP_SYNC_REVISION}" "${BUNDLE_ID}" <<'PY'
    import json
    import pathlib
    import sys

    content = pathlib.Path(sys.argv[1]).read_text()
    pathlib.Path(sys.argv[2]).write_text(json.dumps({
        "metadata": {"annotations": {"rhoai3.redhat.com/catalog-revision": sys.argv[3],
                                     "rhoai3.redhat.com/catalog-bundle": sys.argv[4]}},
        "data": {"all.yaml": content}}))
    PY

    if oc get configmap catalog-runtime-rhdh -n rhdh >/dev/null 2>&1; then
      oc patch configmap catalog-runtime-rhdh -n rhdh --type=merge -p "$(cat ${BUNDLE}/.catalog-patch.json)"
    else
      oc create configmap catalog-runtime-rhdh -n rhdh --from-file=all.yaml=${BUNDLE}/.catalog-runtime.yaml
      oc annotate configmap catalog-runtime-rhdh -n rhdh "rhoai3.redhat.com/catalog-revision=${APP_SYNC_REVISION}" \
        "rhoai3.redhat.com/catalog-bundle=${BUNDLE_ID}" --overwrite
    fi

    echo "Runtime catalog generated from bundle ${BUNDLE_ID:0:16} at revision ${APP_SYNC_REVISION}"

    # Template Locations are pinned to the published revision (B2), so each
    # re-stamp registers one new Location; the ones for any OTHER revision are
    # superseded and pruned here (Lead:catalog-location-must-not-accumulate).
    # No catalog API token is provisioned; same postgres path as
    # scripts/demo/delete-scaffolded-project.sh. Best-effort: a missing postgres pod
    # must not fail catalog generate.
    PSQL_POD=$(oc get pods -n rhdh --no-headers 2>/dev/null \
      | awk '/psql|postgres/ {print $1; exit}' || true)
    if [ -n "$PSQL_POD" ]; then
      if oc exec -n rhdh "$PSQL_POD" -- psql -d backstage_plugin_catalog -v ON_ERROR_STOP=1 -c "
        DELETE FROM locations
        WHERE target ~ '/blob/[0-9a-f]{40}/gitops/stages/070-advanced-app-platform/(base/)?rhdh/templates/[^/]+/template\\.yaml'
          AND target !~ '/blob/${APP_SYNC_REVISION}/';
        DELETE FROM refresh_state
        WHERE entity_ref LIKE 'location:%'
          AND unprocessed_entity ~ '/blob/[0-9a-f]{40}/gitops/stages/070-advanced-app-platform/(base/)?rhdh/templates/'
          AND unprocessed_entity !~ '/blob/${APP_SYNC_REVISION}/';
      "; then
        echo "Pruned template Locations of superseded revisions"
      else
        echo "WARN: Location prune failed; catalog generate already wrote the ConfigMap"
      fi
    else
      echo "No postgres pod in rhdh; skip superseded Location prune"
    fi
  jobs__catalog__render_catalog.py: |
    #!/usr/bin/env python3
    """RHDH runtime catalog: one bundle, one revision (B2).

    The generator used to run from a synced ConfigMap while fetching all.yaml
    from the branch HEAD. On 2026-09-24 an older script published a newer
    catalog's __RHOAI3_MAAS_*__ placeholders verbatim, and a later change that
    added no new placeholder would not have been caught at all.

    Now the generator script, this renderer, the catalog and every template and
    skeleton file are ONE ConfigMap produced by kustomize's configMapGenerator
    from the same checkout. Its name carries a content hash, so a catalog-only or
    template-only change is a manifest change Argo CD applies. This module:

      digest   -- the bundle's identity: sha256 over (key, sha256(content))
      verify   -- every bundled file is byte-identical at the revision the
                  catalog will link to; otherwise FACTORY_BUNDLE_MISMATCH and the
                  runtime catalog is left as it was
      render   -- substitutes the platform values and the ONE revision into the
                  bundled catalog; refuses any placeholder it did not resolve

    A bundle key is the file's path under gitops/.../base/rhdh with "/" spelled
    "__" (a ConfigMap key cannot hold "/").
    """
    import argparse
    import hashlib
    import re
    import json
    import os
    from urllib.parse import quote, urlsplit
    import sys
    import urllib.request
    from pathlib import Path
    from typing import Callable, Dict, List, Optional

    RHDH_BASE = "gitops/stages/070-advanced-app-platform/rhdh"
    CATALOG_KEY = "catalog__all.yaml"
    HOST_RE = re.compile(r"[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*")
    IPV4_RE = re.compile(r"(25[0-5]|2[0-4]\d|1?\d?\d)(\.(25[0-5]|2[0-4]\d|1?\d?\d)){3}")
    SHA_RE = re.compile(r"[0-9a-f]{40}")


    class Refusal(SystemExit):
        pass


    def key_path(key: str) -> str:
        return "%s/%s" % (RHDH_BASE, key.replace("__", "/"))


    def bundle_files(bundle: Path) -> Dict[str, bytes]:
        """The bundle's files by key; a ConfigMap volume's ..data links and the
        generator's own dot-named work files are not files of it."""
        out = {}
        for p in sorted(Path(bundle).iterdir()):
            if p.name.startswith(".") or not p.is_file():
                continue
            out[p.name] = p.read_bytes()
        return out


    def digest(files: Dict[str, bytes]) -> str:
        h = hashlib.sha256()
        for key in sorted(files):
            h.update(key.encode("utf-8") + b"\0" + hashlib.sha256(files[key]).digest())
        return h.hexdigest()


    def fetch_raw(raw_base: str) -> Callable[[str, str], Optional[bytes]]:
        def fetch(revision: str, path: str) -> Optional[bytes]:
            try:
                if raw_base.startswith('gitlab+'):
                    repository = raw_base[len('gitlab+'):].rstrip('/')
                    if repository.endswith('.git'): repository = repository[:-4]
                    parsed = urlsplit(repository)
                    project = quote(parsed.path.lstrip('/'), safe='')
                    url = '%s://%s/api/v4/projects/%s/repository/files/%s/raw?ref=%s' % (parsed.scheme, parsed.netloc, project, quote(path, safe=''), revision)
                    token = Path(os.environ.get('GITLAB_READER_TOKEN_FILE', '/gitlab-reader/token')).read_text().strip()
                    request = urllib.request.Request(url, headers={'PRIVATE-TOKEN': token})
                else:
                    request = '%s/%s/%s' % (raw_base.rstrip('/'), revision, path)
                with urllib.request.urlopen(request, timeout=20) as resp:
                    return resp.read()
            except Exception:
                return None
        return fetch


    def verify(files: Dict[str, bytes], revision: str, fetch: Callable[[str, str], Optional[bytes]]) -> List[str]:
        """Every bundled file as the repository holds it at `revision`, or why not.

        The catalog's links, its template Locations and the scaffolder's skeleton
        fetches all resolve at that one revision; a bundle that is not what that
        revision holds would publish links to content the generator never saw."""
        if not SHA_RE.fullmatch(revision or ""):
            return ["the revision %r is not a commit sha; a catalog is only ever pinned to one" % revision]
        if CATALOG_KEY not in files:
            return ["the bundle carries no %s" % CATALOG_KEY]
        gaps = []
        for key in sorted(files):
            got = fetch(revision, key_path(key))
            if got is None:
                gaps.append("%s is not readable at %s" % (key_path(key), revision[:12]))
            elif hashlib.sha256(got).digest() != hashlib.sha256(files[key]).digest():
                gaps.append("%s at %s is not the bundled file (%s vs %s)" % (
                    key_path(key), revision[:12], hashlib.sha256(got).hexdigest()[:12],
                    hashlib.sha256(files[key]).hexdigest()[:12]))
        return gaps


    def render(content: str, *, revision: str, devspaces_url: str, rhdh_url: str, coolstore_url: str,
               sonarqube_url: str, maas_host: str, maas_internal_ip: str, scm: Optional[dict] = None) -> str:
        # A hostAlias hostname must be a bare RFC 1123 host: a URL fragment here
        # made the v7 workspace deployment invalid. Refuse rather than publish one.
        if not HOST_RE.fullmatch(maas_host or ""):
            raise Refusal("MaaS gateway https listener hostname %r is not an RFC 1123 host" % maas_host)
        if not IPV4_RE.fullmatch(maas_internal_ip or ""):
            raise Refusal("maas-gateway-internal clusterIP %r is not an IPv4 address" % maas_internal_ip)
        if not SHA_RE.fullmatch(revision or ""):
            raise Refusal("the catalog revision %r is not a commit sha" % revision)
        out = content.replace("https://coolstore-inventory-route.placeholder.example.com", coolstore_url.rstrip("/"))
        for placeholder in ("https://devspaces.placeholder.example.com", "https://devspaces-inventory.placeholder.example.com"):
            out = out.replace(placeholder, devspaces_url.rstrip("/"))
        out = out.replace("https://rhdh.placeholder.example.com", rhdh_url.rstrip("/"))
        out = out.replace("https://sonarqube.placeholder.example.com", sonarqube_url.rstrip("/"))
        # B2: template Locations resolve at the SAME revision as every other link,
        # so the template and its skeleton are the bundled ones, never a moving
        # branch head (superseded Locations are pruned by the generator).
        out = out.replace("__RHOAI3_DEMO_LOCATION_REF__", revision)
        out = out.replace("__RHOAI3_DEMO_REVISION__", revision)
        out = out.replace("__RHOAI3_MAAS_HOST__", maas_host)
        out = out.replace("__RHOAI3_MAAS_INTERNAL_IP__", maas_internal_ip)
        if scm is not None:
            platform_repo = scm['PLATFORM_CATALOG_REPO'].rstrip('/')
            if platform_repo.endswith('.git'):
                platform_repo = platform_repo[:-4]
            replacements = {
                'GITLAB_HOST': scm['GITLAB_HOST'], 'GITLAB_BASE_URL': scm['GITLAB_BASE_URL'],
                'GITLAB_WORKLOAD_GROUP': scm['GITLAB_WORKLOAD_GROUP'],
                'GITLAB_REGISTRATION_PROJECT_ID': str(scm['GITLAB_REGISTRATION_PROJECT_ID']),
                'DEVSPACES_BASE_URL': devspaces_url.rstrip('/'),
                'APPLICATION_GOLDEN_URL': scm['agentic-quarkus-scaffold'],
                'MIGRATION_GOLDEN_URL': scm['quarkus-migration-scaffold-v2'],
                'MTA_HUB_URL': scm['MTA_HUB_URL'],
                'PLATFORM_TREE_URL': platform_repo + '/-/tree/' + revision,
                'PLATFORM_BLOB_URL': platform_repo + '/-/blob/' + revision,
            }
            for key, value in replacements.items():
                if not value or '\n' in value or '\r' in value:
                    raise Refusal('Invalid SCM catalog value: ' + key)
                out = out.replace('__RHOAI3_' + key + '__', value)
        if "placeholder.example.com" in out:
            raise Refusal("a placeholder link was not replaced: %s" % sorted(set(re.findall(r"https://[\w.-]*placeholder\.example\.com", out))))
        leftover = sorted(set(re.findall(r"__RHOAI3_[A-Z0-9_]+__", out)))
        if leftover:
            raise Refusal("unreplaced catalog placeholders %s" % leftover)
        return out


    def main(argv: Optional[List[str]] = None) -> int:
        ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
        sub = ap.add_subparsers(dest="cmd")
        sub.required = True   # add_subparsers(required=...) is Python 3.7+; the job image has 3.6
        d = sub.add_parser("digest")
        d.add_argument("--bundle", required=True)
        v = sub.add_parser("verify")
        v.add_argument("--bundle", required=True)
        v.add_argument("--raw-base", required=True)
        v.add_argument("--revision", required=True)
        r = sub.add_parser("render")
        r.add_argument("--bundle", required=True)
        r.add_argument("--out", required=True)
        r.add_argument("--scm-config", default="")
        for name in ("revision", "devspaces-url", "rhdh-url", "coolstore-url", "sonarqube-url", "maas-host", "maas-internal-ip"):
            r.add_argument("--" + name, default="")
        a = ap.parse_args(argv)
        files = bundle_files(Path(a.bundle))
        if a.cmd == "digest":
            print(digest(files))
            return 0
        if a.cmd == "verify":
            gaps = verify(files, a.revision, fetch_raw(a.raw_base))
            if gaps:
                print("REFUSE FACTORY_BUNDLE_MISMATCH: bundle %s, revision %s: %s; runtime catalog unchanged"
                      % (digest(files)[:16], a.revision[:12], "; ".join(gaps[:3])), file=sys.stderr)
                return 1
            print("bundle %s is what %s holds (%d files)" % (digest(files)[:16], a.revision[:12], len(files)))
            return 0
        content = files[CATALOG_KEY].decode("utf-8")
        try:
            out = render(content, revision=a.revision, devspaces_url=a.devspaces_url, rhdh_url=a.rhdh_url,
                         coolstore_url=a.coolstore_url, sonarqube_url=a.sonarqube_url, maas_host=a.maas_host,
                         maas_internal_ip=a.maas_internal_ip, scm=json.loads(Path(a.scm_config).read_text()) if a.scm_config else None)
        except Refusal as exc:
            print("REFUSE CATALOG_RENDER: %s; runtime catalog unchanged" % exc.code, file=sys.stderr)
            return 1
        Path(a.out).write_text(out, encoding="utf-8")
        return 0


    if __name__ == "__main__":
        raise SystemExit(main())
