apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    argocd.argoproj.io/hook: Sync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation,HookSucceeded
    argocd.argoproj.io/sync-wave: "18"
  name: job-configure-rhdh
  namespace: rhdh
spec:
  activeDeadlineSeconds: 1200
  backoffLimit: 6
  template:
    spec:
      containers:
      - command:
        - /bin/bash
        - -c
        - |
          set -euo pipefail

          # Platform RHBK (identity component). RHBK 26 serves at the root
          # path (no /auth prefix); in-cluster calls use the HTTP service,
          # browsers use the edge-terminated platform-rhbk Route.
          RHBK_URL=""
          REALM="platform"
          RHDH_CLIENT_ID="rhdh"

          # --- 1. Discover RHDH route ---
          echo "Discovering RHDH route..."
          RHDH_HOST=""
          for i in {1..30}; do
            RHDH_HOST=$(oc get route -n rhdh --no-headers 2>/dev/null \
              | grep backstage | awk '{print $2}' | head -1 || true)
            if [ -n "$RHDH_HOST" ]; then break; fi
            echo "Waiting for RHDH route... ($i/30)"
            sleep 10
          done
          if [ -z "$RHDH_HOST" ]; then
            echo "ERROR: RHDH route not found"
            exit 1
          fi
          RHDH_URL="https://${RHDH_HOST}"
          echo "RHDH URL: ${RHDH_URL}"

          # --- 2. Discover the platform RHBK route (for the metadata URL) ---
          echo "Discovering platform RHBK route..."
          RHBK_HOST=""
          for i in {1..30}; do
            RHBK_HOST=$(oc get route keycloak -n keycloak -o jsonpath='{.spec.host}' 2>/dev/null || true)
            if [ -n "$RHBK_HOST" ]; then break; fi
            echo "Waiting for platform RHBK route... ($i/30)"
            sleep 10
          done
          if [ -z "$RHBK_HOST" ]; then
            echo "ERROR: platform RHBK route not found"
            exit 1
          fi
          RHBK_URL="https://${RHBK_HOST}"
          RHBK_METADATA_URL="https://${RHBK_HOST}/realms/${REALM}"
          echo "RHBK metadata URL: ${RHBK_METADATA_URL}"

          # --- 3. Use the runtime catalog generated by the Sync hook ---
          RHDH_CATALOG_URL="/opt/app-root/src/catalog/all.yaml"
          echo "RHDH catalog URL: ${RHDH_CATALOG_URL}"

          # --- 4. Get RHBK admin token ---
          echo "Getting RHBK admin token..."
          ADMIN_TOKEN=$(RHBK_IDENTITY_BASE="${RHBK_URL}" python3 - <<'CLIENT_TOKEN'
          import base64, json, os, subprocess, urllib.parse, urllib.request
          value=json.loads(subprocess.check_output(['oc','get','secret','stage070-rhdh-provisioner','-n','rhdh','-o','json']))['data']
          credentials={k:base64.b64decode(value[k]).decode() for k in ('client_id','client_secret')}
          request=urllib.request.Request(os.environ['RHBK_IDENTITY_BASE']+'/realms/platform/protocol/openid-connect/token',urllib.parse.urlencode(dict(grant_type='client_credentials',**credentials)).encode())
          with urllib.request.urlopen(request,timeout=30) as response: print(json.load(response)['access_token'])
          CLIENT_TOKEN
          )

          AUTH_HEADER="Authorization: Bearer ${ADMIN_TOKEN}"

          # --- 5. Generate OIDC client secret ---
          echo "Checking RHDH OIDC client in RHBK..."
          REDIRECT_URI="${RHDH_URL}/api/auth/oidc/handler/frame"

          EXISTING_CLIENT=$(curl -fsS -H "${AUTH_HEADER}" \
            "${RHBK_URL}/admin/realms/${REALM}/clients?clientId=${RHDH_CLIENT_ID}" 2>/dev/null \
            | python3 -c "import sys,json; clients=json.load(sys.stdin); print(clients[0]['id'] if clients else '')" 2>/dev/null || echo "")

          CURRENT_CLIENT_SECRET=$(oc get secret rhdh-secrets -n rhdh \
            -o jsonpath='{.data.RHDH_OIDC_CLIENT_SECRET}' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          if [ -n "$CURRENT_CLIENT_SECRET" ] && ! echo "$CURRENT_CLIENT_SECRET" | grep -qi "placeholder"; then
            CLIENT_SECRET="$CURRENT_CLIENT_SECRET"
          else
            CLIENT_SECRET=$(head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 40)
          fi

          if [ -n "$EXISTING_CLIENT" ]; then
            echo "Updating existing RHDH client..."
            curl -fsS -X PUT -H "${AUTH_HEADER}" -H "Content-Type: application/json" \
              "${RHBK_URL}/admin/realms/${REALM}/clients/${EXISTING_CLIENT}" \
              -d "{
                \"clientId\": \"${RHDH_CLIENT_ID}\",
                \"enabled\": true,
                \"publicClient\": false,
                \"secret\": \"${CLIENT_SECRET}\",
                \"redirectUris\": [\"${REDIRECT_URI}\"],
                \"webOrigins\": [\"${RHDH_URL}\"],
                \"standardFlowEnabled\": true,
                \"directAccessGrantsEnabled\": false
              }" -o /dev/null
            echo "RHDH client updated"
          else
            echo "Creating new RHDH client..."
            curl -fsS -X POST -H "${AUTH_HEADER}" -H "Content-Type: application/json" \
              "${RHBK_URL}/admin/realms/${REALM}/clients" \
              -d "{
                \"clientId\": \"${RHDH_CLIENT_ID}\",
                \"enabled\": true,
                \"publicClient\": false,
                \"secret\": \"${CLIENT_SECRET}\",
                \"redirectUris\": [\"${REDIRECT_URI}\"],
                \"webOrigins\": [\"${RHDH_URL}\"],
                \"standardFlowEnabled\": true,
                \"directAccessGrantsEnabled\": false,
                \"protocol\": \"openid-connect\"
              }" -o /dev/null
            echo "RHDH client created"
          fi

          # --- 5b. Discover SonarQube and Dev Spaces URLs for app-launcher tiles ---
          SONARQUBE_HOST=$(oc get route sonarqube -n sonarqube \
            -o jsonpath='{.spec.host}' 2>/dev/null || true)
          SONARQUBE_URL="https://${SONARQUBE_HOST:-sonarqube-pending.local}"
          echo "SonarQube URL: ${SONARQUBE_URL}"

          DEVSPACES_HOST=$(oc get route devspaces -n openshift-devspaces \
            -o jsonpath='{.spec.host}' 2>/dev/null || true)
          DEVSPACES_URL="https://${DEVSPACES_HOST:-devspaces-pending.local}"
          echo "Dev Spaces URL: ${DEVSPACES_URL}"

          # --- 5c. Kubernetes SA token + Argo CD access for plugins ---
          KUBE_SA_TOKEN=$(oc get secret rhdh-kubernetes-reader-token -n rhdh \
            -o jsonpath='{.data.token}' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          if [ -z "$KUBE_SA_TOKEN" ]; then
            echo "WARNING: rhdh-kubernetes-reader-token not populated yet"
          fi

          ARGOCD_HOST=$(oc get route openshift-gitops-server -n openshift-gitops \
            -o jsonpath='{.spec.host}' 2>/dev/null || echo "")
          ARGOCD_URL="https://${ARGOCD_HOST}"
          ARGOCD_TOKEN=$(oc get secret rhdh-argocd-reader -n openshift-gitops \
            -o jsonpath='{.data.token}' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          if [ -z "$ARGOCD_HOST" ] || [ -z "$ARGOCD_TOKEN" ]; then
            echo "WARNING: Argo CD route or reader token not found"
          fi

          # --- 6. Reuse or generate session secret ---
          CURRENT_SESSION_SECRET=$(oc get secret rhdh-secrets -n rhdh \
            -o jsonpath='{.data.SESSION_SECRET}' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          if [ -n "$CURRENT_SESSION_SECRET" ] && ! echo "$CURRENT_SESSION_SECRET" | grep -qi "placeholder"; then
            SESSION_SECRET="$CURRENT_SESSION_SECRET"
          else
            SESSION_SECRET=$(head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 40)
          fi

          # --- 7. Patch rhdh-secrets ---
          echo "Checking rhdh-secrets..."
          CURRENT_BASE_URL=$(oc get secret rhdh-secrets -n rhdh \
            -o jsonpath='{.data.RHDH_BASE_URL}' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          CURRENT_METADATA_URL=$(oc get secret rhdh-secrets -n rhdh \
            -o jsonpath='{.data.RHBK_METADATA_URL}' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          CURRENT_CATALOG_URL=$(oc get secret rhdh-secrets -n rhdh \
            -o jsonpath='{.data.RHDH_CATALOG_URL}' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          CURRENT_KUBE_SA_TOKEN=$(oc get secret rhdh-secrets -n rhdh \
            -o jsonpath='{.data.RHDH_KUBERNETES_SA_TOKEN}' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          CURRENT_ARGOCD_URL=$(oc get secret rhdh-secrets -n rhdh \
            -o jsonpath='{.data.RHDH_ARGOCD_URL}' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          CURRENT_ARGOCD_TOKEN=$(oc get secret rhdh-secrets -n rhdh \
            -o jsonpath='{.data.RHDH_ARGOCD_TOKEN}' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          CURRENT_SONARQUBE_URL=$(oc get secret rhdh-secrets -n rhdh \
            -o jsonpath='{.data.SONARQUBE_URL}' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          CURRENT_DEVSPACES_URL=$(oc get secret rhdh-secrets -n rhdh \
            -o jsonpath='{.data.DEVSPACES_URL}' 2>/dev/null | base64 -d 2>/dev/null || echo "")
          SECRETS_CHANGED=false
          if [ "$CURRENT_BASE_URL" != "$RHDH_URL" ] || \
             [ "$CURRENT_METADATA_URL" != "$RHBK_METADATA_URL" ] || \
             [ "$CURRENT_CATALOG_URL" != "$RHDH_CATALOG_URL" ] || \
             [ "$CURRENT_CLIENT_SECRET" != "$CLIENT_SECRET" ] || \
             [ "$CURRENT_SESSION_SECRET" != "$SESSION_SECRET" ] || \
             [ "$CURRENT_KUBE_SA_TOKEN" != "$KUBE_SA_TOKEN" ] || \
             [ "$CURRENT_ARGOCD_URL" != "$ARGOCD_URL" ] || \
             [ "$CURRENT_ARGOCD_TOKEN" != "$ARGOCD_TOKEN" ] || \
             [ "$CURRENT_SONARQUBE_URL" != "$SONARQUBE_URL" ] || \
             [ "$CURRENT_DEVSPACES_URL" != "$DEVSPACES_URL" ]; then
            SECRETS_CHANGED=true
          fi

          ENCODED_SESSION=$(echo -n "${SESSION_SECRET}" | base64 -w0 2>/dev/null || echo -n "${SESSION_SECRET}" | base64)
          ENCODED_CLIENT_SECRET=$(echo -n "${CLIENT_SECRET}" | base64 -w0 2>/dev/null || echo -n "${CLIENT_SECRET}" | base64)
          ENCODED_BASE_URL=$(echo -n "${RHDH_URL}" | base64 -w0 2>/dev/null || echo -n "${RHDH_URL}" | base64)
          ENCODED_METADATA_URL=$(echo -n "${RHBK_METADATA_URL}" | base64 -w0 2>/dev/null || echo -n "${RHBK_METADATA_URL}" | base64)
          ENCODED_CATALOG_URL=$(echo -n "${RHDH_CATALOG_URL}" | base64 -w0 2>/dev/null || echo -n "${RHDH_CATALOG_URL}" | base64)
          ENCODED_KUBE_SA_TOKEN=$(echo -n "${KUBE_SA_TOKEN}" | base64 -w0 2>/dev/null || echo -n "${KUBE_SA_TOKEN}" | base64)
          ENCODED_ARGOCD_URL=$(echo -n "${ARGOCD_URL}" | base64 -w0 2>/dev/null || echo -n "${ARGOCD_URL}" | base64)
          ENCODED_ARGOCD_TOKEN=$(echo -n "${ARGOCD_TOKEN}" | base64 -w0 2>/dev/null || echo -n "${ARGOCD_TOKEN}" | base64)
          ENCODED_SONARQUBE_URL=$(echo -n "${SONARQUBE_URL}" | base64 -w0 2>/dev/null || echo -n "${SONARQUBE_URL}" | base64)
          ENCODED_DEVSPACES_URL=$(echo -n "${DEVSPACES_URL}" | base64 -w0 2>/dev/null || echo -n "${DEVSPACES_URL}" | base64)

          if [ "$SECRETS_CHANGED" = "true" ]; then
            echo "Patching rhdh-secrets..."
            oc patch secret rhdh-secrets -n rhdh --type=merge \
              -p "{\"data\":{
                \"SESSION_SECRET\":\"${ENCODED_SESSION}\",
                \"RHDH_OIDC_CLIENT_SECRET\":\"${ENCODED_CLIENT_SECRET}\",
                \"RHDH_BASE_URL\":\"${ENCODED_BASE_URL}\",
                \"RHBK_METADATA_URL\":\"${ENCODED_METADATA_URL}\",
                \"RHDH_CATALOG_URL\":\"${ENCODED_CATALOG_URL}\",
                \"RHDH_KUBERNETES_SA_TOKEN\":\"${ENCODED_KUBE_SA_TOKEN}\",
                \"RHDH_ARGOCD_URL\":\"${ENCODED_ARGOCD_URL}\",
                \"RHDH_ARGOCD_TOKEN\":\"${ENCODED_ARGOCD_TOKEN}\",
                \"SONARQUBE_URL\":\"${ENCODED_SONARQUBE_URL}\",
                \"DEVSPACES_URL\":\"${ENCODED_DEVSPACES_URL}\"
              }}"
            echo "rhdh-secrets patched"
          else
            echo "rhdh-secrets already match desired values"
          fi

          # --- 8. Patch ConsoleLink ---
          echo "Patching ConsoleLink..."
          oc patch consolelink rhdh --type=merge \
            -p "{\"spec\":{\"href\":\"${RHDH_URL}\",\"applicationMenu\":{\"imageURL\":\"${RHDH_URL}/favicon.ico\"}}}"
          echo "ConsoleLink patched: ${RHDH_URL}"

          # --- 9. Restart RHDH ---
          RHDH_DEPLOY=$(oc get deployment -n rhdh --no-headers 2>/dev/null \
            | grep backstage | awk '{print $1}' | head -1 || true)
          if [ -n "$RHDH_DEPLOY" ] && [ "$SECRETS_CHANGED" = "true" ]; then
            echo "Restarting RHDH deployment..."
            oc rollout restart deployment/${RHDH_DEPLOY} -n rhdh
            oc rollout status deployment/${RHDH_DEPLOY} -n rhdh --timeout=900s
            echo "RHDH restarted"
          elif [ -n "$RHDH_DEPLOY" ]; then
            echo "RHDH deployment restart not needed"
          else
            echo "WARNING: RHDH deployment not found for restart"
          fi

          echo ""
          echo "=== RHDH configured ==="
          echo "URL: ${RHDH_URL}"
          echo "Auth: OIDC via platform RHBK (${RHBK_METADATA_URL})"
          echo "Catalog: ${RHDH_CATALOG_URL}"
          echo "Users log in with OpenShift credentials (brokered through RHBK)"
        image: registry.redhat.io/openshift4/ose-cli@sha256:69762925e16053d77685ff3a08b3b45dd2bfa5d68277851bc6969b368bbd0cb9
        name: configure
      restartPolicy: OnFailure
      serviceAccountName: job-configure-rhdh
