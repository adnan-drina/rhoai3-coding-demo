            # /etc/config/<ConfigMap_name>/<key>. The platform ConfigMap is
            # devspace-ai-tools-init / init-ai-tools.sh (fenced file).
            INIT_VOL="/etc/config/devspace-ai-tools-init/init-ai-tools.sh"
