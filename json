  templates__app-migration__skeleton__migration.yaml: |
    # Migration provenance + harness contract — stamped by the app-migration
    # template. Specimen-layering: the golden scaffold stays specimen-free; this
    # skeleton is the only place demo-specimen contracts are written.
    #
    # Profile selection is by legacyRepoUrl (known demo freeze-forks). Unknown
    # URLs get provenance + analysis only and contract.status: undecided — never
    # Coolstore cart literals. Do not "edit after create" for the known demo
    # specimens; recreate from the template if the stamp is wrong. dest-3
    # gs-rest-service-legacy was stamped on the already-materialised dest file
    # (Operator GO); this branch is for the next cut.
    # Plain set tags below, NOT the whitespace-stripping dash form: stripping eats
    # the newline before migration: and glues it onto this comment block.
    # Do not write template tag syntax in these comments — the scaffolder renders
    # this file before YAML parsing, so a tag inside a "#" comment is still parsed.
    {% set url = (values.legacyRepoUrl | default('', true) | lower) %}
    {% set is_petclinic = ('spring-petclinic-rest-legacy' in url) or ('petclinic-rest-legacy' in url) %}
    {% set is_cart = ('coolstore-cart-legacy' in url) %}
    {% set is_gs_rest = ('gs-rest-service-legacy' in url) %}
    migration:
      legacyRepoUrl: ${{ values.legacyRepoUrl }}
      target: quarkus
      provisionedBy: app-migration golden-path template
    {%- if is_petclinic %}
      legacyBasePackage: org.springframework.samples.petclinic
      legacyPackage: org.springframework.samples.petclinic
      targetPackage: com.demo
      path_rewrites:
        - from: src/main/java/com/demo/
          to: src/main/java/org/springframework/samples/petclinic/
        - from: src/test/java/com/demo/
          to: src/test/java/org/springframework/samples/petclinic/
      # Dest↔legacy leaves under the rewritten package root (from=dest, to=legacy).
      # The deriver applies these; the plan may rename a leaf.
      intra_package_maps:
        - from: entity/
          to: model/
    {%- elif is_cart %}
      legacyBasePackage: com.redhat.coolstore
