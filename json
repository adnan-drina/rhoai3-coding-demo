        action: fetch:plain
        input:
          url: ./refusals/FACTORY_MTA_HUB_MISSING
          targetPath: ./.refusal
      - id: add-catalog-info
        name: Add catalog metadata and stamp the migration working set
        action: fetch:template
        input:
          url: ./skeleton
          replace: true
          values:
            name: ${{ parameters.name }}
            legacyRepoUrl: ${{ parameters.legacyRepoUrl }}
            autoStartMigration: ${{ parameters.autoStartMigration }}
            boardProtocol: ${{ parameters.boardProtocol }}
            model: ${{ parameters.model }}
            scaffolderTaskId: ${{ context.task.id }}
            mtaHubUrl: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/mta-hub-url'] }}
            maasHost: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/maas-host'] }}
            maasInternalIp: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/maas-internal-ip'] }}
            sonarqubeUrl: ${{ steps['platform-entity'].output.entity.metadata.links[3].url | replace('coolstore-inventory-service', parameters.name) }}
            devspacesUrl: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/devspaces-base-url'] }}/#${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-base-url'] }}/${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-workload-group'] }}/${{ parameters.name }}?revision=main&existing=${{ parameters.name }}
            gitlabBaseUrl: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-base-url'] }}
            gitlabGroup: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-workload-group'] }}
      - id: publish
        name: Publish private repository to GitLab
        action: publish:gitlab
        input:
          repoUrl: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-host'] }}?owner=${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-workload-group'] }}&repo=${{ parameters.name }}
          defaultBranch: main
          settings:
            description: 'Quarkus migration destination (golden path: AI-autonomous migration)'
            visibility: private
            topics:
            - rhoai3-golden-path
            - rhoai3-scaffolded
            - rhoai3-migration-run
      - id: enroll
        name: Request platform enrollment of the immutable first commit
        action: gitlab:issues:create
        input:
          repoUrl: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-host'] }}?owner=rhoai-platform&repo=platform-enrollment
          projectId: ${{ steps['platform-entity'].output.entity.metadata.annotations['rhoai3.redhat.com/gitlab-registration-project-id'] | int }}
          title: Enroll ${{ parameters.name }}
          labels: platform-enrollment
          confidential: true
          description: '{"project_id": ${{ steps.publish.output.projectId }}, "initial_commit": "${{ steps.publish.output.commitHash }}", "kind": "migration", "requester": "${{ user.ref }}"}'
      output:
        links:
        - title: Destination repository
          url: ${{ steps.publish.output.remoteUrl }}
        - title: Open in catalog
          icon: catalog
          entityRef: component:default/${{ parameters.name }}
        text:
        - title: Next steps
          content: "The publish above requested platform enrollment. The catalog discovers your project automatically; Argo CD is\ncreating the `<name>-dev` namespace with the project's own\ndelivery pipeline, and build credentials arrive within two\nminutes.\n\nOpen the destination repository in Dev Spaces: the workspace\nclones the legacy application to `/projects/legacy` (read-only,\nworkspace-only) next to `/projects/modernized` (this repository),\nwith the MTA analysis extension preconfigured against the\nplatform hub. Run the MTA analysis of the legacy project first \u2014\nits findings are the migration's ground truth \u2014 then build the\nmodernized service in `/projects/modernized`. Every push to\n`main` runs the project's own pipeline in `<name>-dev` with the\nSonarQube quality gate.\n"
