  templates__app-migration__template.yaml: |
    apiVersion: scaffolder.backstage.io/v1beta3
    kind: Template
    metadata:
      name: app-migration
      title: Application migration
      description: 'Provisions a migration working set for a legacy application: a Quarkus

        destination repository carrying corporate migration standards

        (AGENTS.md) and a Dev Spaces workspace

        that clones the legacy code next to it (/projects/legacy, read-only,

        workspace-only) with the MTA analysis extension preconfigured. The

        destination repository is registered in the catalog and provisioned

        with its own namespace and delivery pipeline (SonarQube quality gate

        included); the legacy application is not cataloged.

        '
      tags:
      - golden-path
      - migration
      - quarkus
      - mta
    spec:
      owner: ai-modernization-team
      type: service
      parameters:
      - title: Migration input
        required:
        - name
        - legacyRepoUrl
        properties:
          name:
            title: Project name
            type: string
            description: 'Name for the migration project (e.g. coolstore-cart-v6). It

