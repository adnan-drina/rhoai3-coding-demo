              echo "ConfigMap devspace-ai-tools-init must carry"
              echo "controller.devfile.io/mount-to-devworkspace=true"
              echo "(Dev Spaces 3.28 User Guide, Mount a ConfigMap)."
              echo "Agent tooling is required; refusing a healthy workspace without it."
              exit 1
            fi
            echo "init-ai-tools.sh from ConfigMap volume ${INIT_VOL}"
            chmod 700 "${INIT_VOL}" 2>/dev/null || true
            bash "${INIT_VOL}" "${PROJECT_DIR}" "${PROFILE}" \
              || { echo "ERROR: init-ai-tools.sh failed"; exit 1; }
      - id: package
        exec:
          label: "Package"
          component: development-tooling
          workingDir: ${PROJECT_SOURCE}
          commandLine: 'export JAVA_HOME="${JAVA_HOME_21:-${JAVA_HOME}}" && export PATH="${JAVA_HOME}/bin:${PATH}" && mvn -q -DskipTests package'
          group:
            kind: build
            isDefault: true
      - id: test
        exec:
          label: "1. Run tests"
          component: development-tooling
          workingDir: ${PROJECT_SOURCE}
          commandLine: 'export JAVA_HOME="${JAVA_HOME_21:-${JAVA_HOME}}" && export PATH="${JAVA_HOME}/bin:${PATH}" && mvn -q test'
          group:
