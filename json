apiVersion: v1
data:
  catalog__all.yaml: |
    ---
    apiVersion: backstage.io/v1alpha1
    kind: User
    metadata:
      name: ai-admin
    spec:
      memberOf: [ai-modernization-team]
    ---
    apiVersion: backstage.io/v1alpha1
    kind: User
    metadata:
      name: ai-developer
    spec:
      memberOf: [ai-modernization-team]
    ---
    apiVersion: backstage.io/v1alpha1
    kind: Group
    metadata:
      name: ai-modernization-team
      description: Platform and developer team for AI-assisted application modernization
    spec:
      type: team
      children: []
    ---
    apiVersion: backstage.io/v1alpha1
    kind: Domain
    metadata:
      name: application-modernization
      description: Modernizing brownfield applications onto the governed AI development platform.
      tags:
        - modernization
    spec:
      owner: ai-modernization-team
    ---
    apiVersion: backstage.io/v1alpha1
    kind: System
    metadata:
      name: coolstore
      description: Coolstore modernization system for the governed AI developer workflow.
      annotations:
        backstage.io/source-location: url:https://github.com/rhpds/mca-coolstore
        backstage.io/techdocs-ref: url:__RHOAI3_PLATFORM_TREE_URL__
      links:
        - url: https://github.com/rhpds/mca-coolstore
          title: Source Repo
          icon: github
      tags:
        - coolstore
        - modernization
        - agentic-engineering
    spec:
      owner: ai-modernization-team
      domain: application-modernization
    ---
    # Catalog scope (2026-07-13 decision): coolstore-inventory-service is the
    # one and only Component — the getting-started-ai-coding onboarding entry
    # and the MCA Coolstore brownfield entry were removed; stage 080's entry
    # point is the app-migration golden-path template (registered below).
    # The MaaS model Resources stay as unattached AI assets.
    apiVersion: backstage.io/v1alpha1
    kind: Component
    metadata:
      name: coolstore-inventory-service
      title: Coolstore Inventory Service
      description: |
        Quarkus inventory service used for AI-assisted engineering and golden-path
        delivery work connected to the Coolstore domain.
      annotations:
        backstage.io/source-location: url:__RHOAI3_GITLAB_BASE_URL__/__RHOAI3_GITLAB_WORKLOAD_GROUP__/coolstore-inventory-service
        backstage.io/techdocs-ref: url:__RHOAI3_PLATFORM_TREE_URL__
        gitlab.com/project-slug: __RHOAI3_GITLAB_WORKLOAD_GROUP__/coolstore-inventory-service
        backstage.io/kubernetes-id: coolstore-inventory-service
        janus-idp.io/tekton: coolstore-inventory-service
        argocd/app-name: project-coolstore-inventory-service
        rhoai3.redhat.com/current-repository: adnan-drina/coolstore-inventory-service
        rhoai3.redhat.com/repository: adnan-drina/coolstore-inventory-service
        rhoai3.redhat.com/stage-070-role: target-service
        # Stamped by the catalog generator from the MaaS Gateway listener and the
        # maas-gateway-internal Service (validated there); the app-migration
        # template turns them into the workspace's in-cluster hostAlias.
        rhoai3.redhat.com/maas-host: __RHOAI3_MAAS_HOST__
        rhoai3.redhat.com/maas-internal-ip: __RHOAI3_MAAS_INTERNAL_IP__
        rhoai3.redhat.com/gitlab-host: __RHOAI3_GITLAB_HOST__
        rhoai3.redhat.com/gitlab-base-url: __RHOAI3_GITLAB_BASE_URL__
        rhoai3.redhat.com/gitlab-workload-group: __RHOAI3_GITLAB_WORKLOAD_GROUP__
        rhoai3.redhat.com/gitlab-registration-project-id: "__RHOAI3_GITLAB_REGISTRATION_PROJECT_ID__"
        rhoai3.redhat.com/devspaces-base-url: __RHOAI3_DEVSPACES_BASE_URL__
        rhoai3.redhat.com/application-golden-url: __RHOAI3_APPLICATION_GOLDEN_URL__
        rhoai3.redhat.com/mta-hub-url: __RHOAI3_MTA_HUB_URL__
        rhoai3.redhat.com/migration-golden-url: __RHOAI3_MIGRATION_GOLDEN_URL__
      links:
        - url: __RHOAI3_GITLAB_BASE_URL__/__RHOAI3_GITLAB_WORKLOAD_GROUP__/coolstore-inventory-service
          title: Source Repo
          icon: github
        - url: "https://coolstore-inventory-route.placeholder.example.com/api/inventory"
          title: Deployed App (dev)
          icon: web
        - url: "https://devspaces-inventory.placeholder.example.com/dashboard/#/ide/wksp-ai-developer/agentic-coolstore"
          title: Dev Spaces
          icon: catalog
        - url: "https://sonarqube.placeholder.example.com/dashboard?id=coolstore-inventory-service"
          title: SonarQube (code quality)
          icon: dashboard
      tags:
        - java
        - quarkus
        - inventory
        - coolstore
        - agentic-engineering
    spec:
      type: service
      lifecycle: experimental
      owner: ai-modernization-team
      system: coolstore
      providesApis:
        - inventory-api
    ---
    apiVersion: backstage.io/v1alpha1
    kind: API
    metadata:
      name: inventory-api
      title: Coolstore Inventory API
      description: REST API exposing inventory levels for Coolstore catalog items.
      tags:
        - rest
        - quarkus
        - inventory
    spec:
      type: openapi
      lifecycle: experimental
      owner: ai-modernization-team
      system: coolstore
      definition: |
        openapi: "3.0.0"
        info:
          title: Coolstore Inventory API
          version: "1.0"
          description: |
            REST API for inventory levels of Coolstore catalog items, provided by
            the Quarkus inventory service and consumed by the Coolstore storefront.
        paths:
          /api/inventory:
            get:
              summary: List inventory for all items
              responses:
                '200':
                  description: A JSON array of inventory records
          /api/inventory/{itemId}:
            get:
              summary: Get inventory for an item
              parameters:
                - name: itemId
                  in: path
                  required: true
                  schema:
                    type: string
              responses:
                '200':
                  description: Inventory record with itemId and quantity
                '404':
                  description: Item not found
    ---
    apiVersion: backstage.io/v1alpha1
    kind: Resource
    metadata:
      name: maas-private-code-model-qwen
      title: Qwen3.8 27B
      description: |
        Private MaaS model for Kilo Code, OpenCode, and Hermes, served as NVFP4
        on an RTX PRO 6000 Blackwell GPU. Context is the deployed 262144-token
        window.
      annotations:
        rhoai3.redhat.com/model-id: qwen3-8-27b
        rhoai3.redhat.com/model-path: private-maas
        rhoai3.redhat.com/data-classification: source-code-context
      links:
