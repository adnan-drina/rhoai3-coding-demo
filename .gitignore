# Environment and secrets
.env
.env.local
*.secret
*.secrets

# Temporary files
*.tmp
*.bak
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
# Track scaffold JDT LS heap settings (Operator E-20260811T104500Z demo-noise fix).
!stages/080-ai-autonomous-migration/scaffold-repo/quarkus-migration-scaffold/.vscode/
!stages/080-ai-autonomous-migration/scaffold-repo/quarkus-migration-scaffold/.vscode/settings.json
*.code-workspace

# Tool-specific agent config (local runtime preferences, not project governance)
# Shared rules, skills, and hooks live in .agents/ and are tracked in git.
# .cursor/ tracks only hooks.json and agents/*.md as thin tool bridges.
.claude/
.codex/
.cursor/.DS_Store
.cursor/chat/
.cursor/context/
.cursor/prompts/
.cursor/mcp*.json

# Build outputs
/output/

# Instrument / local fixture pollution must never land at demo-repo root.
# Scaffold sources live under stages/*/scaffold-repo/; a root /src/ is never legitimate.
/src/

# Repo-root tmp/: local runtime only. Version the Stage 080 docs archive.
/tmp/*
!/tmp/docs-archive/
!/tmp/docs-archive/**

# Kubeconfig
kubeconfig
*.kubeconfig

# Python
__pycache__/
*.pyc
.venv/
.venv-*/
venv/

# local run poll artifacts
docs/*-RUN-POLL.log
docs/V5-RUN-POLL.log
