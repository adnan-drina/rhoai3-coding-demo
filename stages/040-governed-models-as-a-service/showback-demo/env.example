# Runtime inputs only. Export these in a private shell after deployment is authorized.
# No credentials are created or read by default preview/offline validation.
SHOWBACK_GATEWAY_URL=https://maas.example.invalid
SHOWBACK_ENGINEERING_KEY=
SHOWBACK_MARKETING_KEY=
SHOWBACK_SUPPORT_KEY=
# Explicit native RHOAI Thanos endpoint or an already-authorized local tunnel.
SHOWBACK_PROMETHEUS_URL=http://127.0.0.1:10902
SHOWBACK_PROMETHEUS_TOKEN=
# Only archive.sh upload uses MLflow. Kubernetes credentials remain outside this package.
MLFLOW_TRACKING_AUTH=kubernetes-namespaced
MLFLOW_TRACKING_URI=https://dashboard.example.invalid/mlflow
MLFLOW_WORKSPACE=showback-reporting
# Private file containing an existing authorized bearer token; never place the token in this template.
MLFLOW_TOKEN_PATH=
