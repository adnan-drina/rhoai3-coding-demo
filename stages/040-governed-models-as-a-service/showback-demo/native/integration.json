{
  "schema_version": 1,
  "state": "inert-review-inputs",
  "gateway": {
    "name": "maas-default-gateway",
    "namespace": "openshift-ingress"
  },
  "loki": {
    "config_target": {
      "apiVersion": "maas.opendatahub.io/v1alpha1",
      "kind": "Config",
      "name": "default"
    },
    "config_patch_candidate": {
      "spec": {
        "usageLogging": true
      }
    },
    "stack_candidate": {
      "apiVersion": "loki.grafana.com/v1",
      "kind": "LokiStack",
      "metadata": {
        "name": "usage",
        "namespace": "redhat-ods-monitoring",
        "labels": {
          "app.kubernetes.io/name": "usage",
          "app.kubernetes.io/component": "usage-log-store",
          "app.kubernetes.io/part-of": "observability",
          "app.kubernetes.io/managed-by": "argocd",
          "demo.rhoai.io/stage": "040"
        }
      },
      "spec": {
        "limits": {
          "global": {
            "otlp": {
              "streamLabels": {
                "resourceAttributes": [
                  {
                    "name": "service.name"
                  },
                  {
                    "name": "subscription"
                  },
                  {
                    "name": "model"
                  },
                  {
                    "name": "response_type"
                  },
                  {
                    "name": "kubernetes_namespace_name"
                  }
                ]
              }
            },
            "retention": {
              "days": 30
            }
          }
        },
        "managementState": "Managed",
        "size": "1x.demo",
        "storage": {
          "schemas": [
            {
              "effectiveDate": "2024-10-01",
              "version": "v13"
            }
          ],
          "secret": {
            "credentialMode": "static",
            "name": "showback-native-loki-objectstorage",
            "type": "s3"
          }
        },
        "tenants": {
          "mode": "openshift-logging"
        },
        "storageClassName": "gp3-csi"
      }
    },
    "config_usage_logging_behavior": "enable_switch",
    "identity_capture": "The shipped usage filter always includes user_id, subscription, key and organization fields; telemetry.metrics.captureUser controls metrics only.",
    "operator_candidate": {
      "package": "loki-operator",
      "channel": "stable-6.6",
      "startingCSV": "loki-operator.v6.6.1",
      "namespace": "openshift-operators-redhat",
      "source": "redhat-operators",
      "sourceNamespace": "openshift-marketplace",
      "installPlanApproval": "Manual",
      "state": "not-installed-review-input-only"
    }
  },
  "metering": {
    "backend_state": "unselected-no-service-deployed",
    "plugin_parameters": {
      "meteringURL": "https://metering.invalid",
      "timeoutSeconds": 5,
      "featureKey": "inference-tokens",
      "source": "maas-default-gateway",
      "failOpen": true
    },
    "plugin_types": [
      "external-metering",
      "external-metering-streaming"
    ],
    "profile_requirements": [
      "Preserve the existing pre-processing data, default gateway and subscriptions. The saved downstream default profile already contains the trusted MaaS guard and stream-usage-enforcer.",
      "The shipped controller explicitly preserves the existing plugins ConfigMap when opendatahub.io/managed=false; changing it to true restores defaults. Source: tenantreconcile/apply.go and apply_plugins_configmap_test.go.",
      "Use parameters, not the stale example json property. The existing chunk path permits external-metering-streaming only; never mix it with full-body response api-translation or external-metering in one profile.",
      "The framework has no automatic multi-profile picker. The shipped chunk plugin reassembles nonstreaming JSON and also parses SSE; this candidate covers both response modes in source, subject to one-event/usage-completeness qualification. It does not support mixing full-body provider response translation into the chunk profile.",
      "The shipped documentation prescribes a controlled payload-processing Deployment restart after ConfigMap edits. No restart or patch is implemented here.",
      "The invalid metering URL is deliberately inert. Select and qualify a backend artifact and its customer/feature/pricing semantics before constructing an active patch.",
      "failOpen=true governs backend errors only; hasAccess=false still denies. Review quota overshoot and failure behavior before monetary enforcement claims."
    ],
    "backend_contract": {
      "balance": {
        "method": "GET",
        "path": "/api/v1/customers/{escaped-user}/entitlements/{escaped-feature}/value?model={escaped-model}",
        "success_status": 200,
        "response_fields": [
          "hasAccess",
          "balance",
          "usage",
          "overage"
        ]
      },
      "events": {
        "method": "POST",
        "path": "/api/v1/events",
        "content_type": "application/json",
        "success_statuses": [
          200,
          204
        ],
        "specversion": "1.0",
        "type": "inference.tokens.used",
        "deduplication_key": [
          "source",
          "id"
        ]
      }
    },
    "selected_plugin": "external-metering-streaming",
    "profile_target": {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "name": "payload-processing-plugins",
      "namespace": "openshift-ingress",
      "data_key": "custom-ipp-config.yaml"
    },
    "managed_override": {
      "annotation": "opendatahub.io/managed",
      "value": "false",
      "applies_to": "existing ConfigMap only; do not mark source before bootstrap",
      "preserve": "All other metadata and data, especially custom-pre-processing-ipp-config.yaml",
      "activation_state": "review-only-no-patch-no-restart"
    },
    "profile_candidate": {
      "apiVersion": "llm-d.ai/v1alpha1",
      "kind": "PayloadProcessorConfig",
      "plugins": [
        {
          "type": "maas-headers-guard",
          "name": "maas-headers-guard"
        },
        {
          "type": "stream-usage-enforcer"
        },
        {
          "type": "model-provider-resolver"
        },
        {
          "type": "external-metering-streaming",
          "name": "external-metering-streaming",
          "parameters": {
            "meteringURL": "https://metering.invalid",
            "timeoutSeconds": 5,
            "featureKey": "inference-tokens",
            "source": "maas-default-gateway",
            "failOpen": true
          }
        },
        {
          "type": "api-translation"
        },
        {
          "type": "apikey-injection"
        }
      ],
      "profiles": [
        {
          "name": "default",
          "plugins": {
            "request": [
              {
                "pluginRef": "maas-headers-guard"
              },
              {
                "pluginRef": "stream-usage-enforcer"
              },
              {
                "pluginRef": "model-provider-resolver"
              },
              {
                "pluginRef": "external-metering-streaming"
              },
              {
                "pluginRef": "api-translation"
              },
              {
                "pluginRef": "apikey-injection"
              }
            ],
            "response": [
              {
                "pluginRef": "external-metering-streaming"
              }
            ]
          }
        }
      ]
    }
  }
}
