@@ -0,0 +1,103 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"log/slog"
+	"net/http"
+	"os"
+	"os/signal"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/noyitz/ai-gateway-metering-service/internal/handler"
+	"github.com/noyitz/ai-gateway-metering-service/internal/storage"
+)
+
+// This mode deliberately does not start upstream pricing fetchers, quota logic,
+// administrative pages or dollar rollups as financial authorities.
+func runShowback(path string) {
+	store, err := storage.New(os.Getenv("DATABASE_URL"), 0)
+	if err != nil {
+		slog.Error("showback database unavailable")
+		os.Exit(1)
+	}
+	defer store.Close()
+	if err := store.EnableShowback(path); err != nil {
+		slog.Error("invalid showback catalog or database schema", "error", err)
+		os.Exit(1)
+	}
+	mux := http.NewServeMux()
+	events := handler.NewEventsHandler(store)
+	mux.HandleFunc("/api/v1/events", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			http.Error(w, "method not allowed", 405)
+			return
+		}
+		raw, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 1048576))
+		var event struct {
+			Source      string `json:"source"`
+			Subject     string `json:"subject"`
+			ContentType string `json:"datacontenttype"`
+			Data        struct {
+				User         string `json:"user"`
+				Subscription string `json:"subscription"`
+				Provider     string `json:"provider"`
+				Model        string `json:"model"`
+				Prompt       int    `json:"prompt_tokens"`
+				Completion   int    `json:"completion_tokens"`
+				Cached       int    `json:"cached_input_tokens"`
+				Write        int    `json:"cache_creation_tokens"`
+				Reasoning    int    `json:"reasoning_tokens"`
+			} `json:"data"`
+		}
+		if err == nil && json.Unmarshal(raw, &event) == nil && event.Source == "maas-default-gateway" &&
+			event.ContentType == "application/json" && event.Subject != "" && event.Subject == event.Data.User && event.Data.Subscription != "" &&
+			event.Data.Provider == "" && strings.HasPrefix(event.Data.Model, "publishers/internal-models/models/") {
+			w.WriteHeader(http.StatusNoContent)
+			return // Explicitly outside external-only capture.
+		}
+		if err != nil || json.Unmarshal(raw, &event) != nil || event.Source != "maas-default-gateway" ||
+			event.ContentType != "application/json" || event.Subject == "" || event.Subject != event.Data.User ||
+			event.Data.Subscription == "" || event.Data.Provider == "" || event.Data.Reasoning > event.Data.Completion ||
+			event.Data.Cached+event.Data.Write > event.Data.Prompt {
+			http.Error(w, "invalid trusted metering envelope or token subsets", 400)
+			return
+		}
+		r.Body = io.NopCloser(bytes.NewReader(raw))
+		events.HandleEvent(w, r)
+	})
+	mux.HandleFunc("/api/v1/customers/", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			http.Error(w, "method not allowed", 405)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		// Existing MaaS remains the authority for access and quotas. No new denial policy.
+		json.NewEncoder(w).Encode(map[string]any{"hasAccess": true, "balance": 0, "usage": 0, "overage": 0})
+	})
+	health := handler.NewHealthHandler(store)
+	mux.HandleFunc("/health", health.HandleHealth)
+	mux.HandleFunc("/ready", health.HandleHealth)
+	mux.HandleFunc("/metrics", store.HandleShowbackMetrics)
+	port := os.Getenv("PORT")
+	if port == "" {
+		port = "8080"
+	}
+	server := &http.Server{Addr: ":" + port, Handler: mux, ReadHeaderTimeout: 5 * time.Second}
+	go func() {
+		if err := server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
+			slog.Error("showback server failed")
+			os.Exit(1)
+		}
+	}()
+	stop := make(chan os.Signal, 1)
+	signal.Notify(stop, syscall.SIGTERM, syscall.SIGINT)
+	<-stop
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	server.Shutdown(ctx)
+}
