@@ -0,0 +1,76 @@
+package storage
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+)
+
+func testShowbackRate() *ShowbackRate {
+	prices := map[string]*json.Number{}
+	for key, value := range map[string]string{"input_uncached": "0.10", "cache_read": "0.01", "cache_write": "0.125", "output": "0.50"} {
+		n := json.Number(value)
+		prices[key] = &n
+	}
+	return &ShowbackRate{Protocol: "openai", Upstream: "gpt-6-luna", ValidFrom: "2026-01-01T00:00:00Z", Prices: prices}
+}
+func TestShowbackFrozenEstimate(t *testing.T) {
+	rate := testShowbackRate()
+	event := UsageEvent{Timestamp: time.Date(2026, 10, 19, 0, 0, 0, 0, time.UTC), PromptTokens: 10000, CompletionTokens: 1000,
+		TotalTokens: 11000, CachedInputTokens: 4000, CacheCreationTokens: 2000, ReasoningTokens: 500}
+	amount, state := estimateShowback(event, rate)
+	if amount != "0.001190000000" || state != "conditional_standard_estimate" {
+		t.Fatalf("estimate %s %s", amount, state)
+	}
+	event.ReasoningTokens = 999
+	second, _ := estimateShowback(event, rate)
+	if second != amount {
+		t.Fatal("reasoning counted twice")
+	}
+	event.PromptTokens = 0
+	event.CompletionTokens = 0
+	event.TotalTokens = 0
+	if amount, state = estimateShowback(event, rate); amount != "" || state != "usage_unknown" {
+		t.Fatal("manufactured zero")
+	}
+	event.PromptTokens = 100
+	event.TotalTokens = 100
+	event.CachedInputTokens = 0
+	event.CacheCreationTokens = 0
+	rate.Prices["input_uncached"] = nil
+	if amount, state = estimateShowback(event, rate); amount != "" || state != "unsupported_category" {
+		t.Fatal("missing rate defaulted")
+	}
+	zero := json.Number("0")
+	rate.Prices["input_uncached"] = &zero
+	rate.Basis = "provider_free_prototype"
+	if amount, state = estimateShowback(event, rate); amount != "0.000000000000" || state != "free_prototype" {
+		t.Fatal("reported free lost")
+	}
+}
+func TestShowbackContextAndIdentity(t *testing.T) {
+	catalog := ShowbackCatalog{Rates: []ShowbackRate{
+		{Protocol: "openai", Upstream: "gpt-6-luna", ContextBand: "input_tokens_lte_272000"},
+		{Protocol: "openai", Upstream: "gpt-6-luna", ContextBand: "input_tokens_gt_272000"},
+		{Provider: "nvidia", Model: "nemotron-3-ultra-550b-a55b", Protocol: "openai", Upstream: "nvidia/nemotron-3-ultra-550b-a55b"},
+	}}
+	for _, count := range []int{272000, 272001} {
+		r := catalog.rateFor(UsageEvent{Provider: "openai", Model: "gpt-6-luna", PromptTokens: count})
+		if r == nil || (count == 272000 && r.ContextBand != "input_tokens_lte_272000") || (count == 272001 && r.ContextBand != "input_tokens_gt_272000") {
+			t.Fatal("context tier mismatch")
+		}
+	}
+	r := catalog.rateFor(UsageEvent{Provider: "openai", Model: "nvidia/nemotron-3-ultra-550b-a55b"})
+	if r == nil || r.Provider != "nvidia" {
+		t.Fatal("protocol mistaken for provider identity")
+	}
+	catalog.Rates = append(catalog.Rates, *r)
+	if catalog.rateFor(UsageEvent{Provider: "openai", Model: r.Upstream}) != nil {
+		t.Fatal("ambiguous identity accepted")
+	}
+	line := showbackMetric("example", "1", map[string]string{"user": "a\"b\\c\n"})
+	if !strings.Contains(line, `user="a\"b\\c\n"`) {
+		t.Fatal("label escape")
+	}
+}
