{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "enabled_providers": [
    "qwen38"
  ],
  "provider": {
    "qwen38": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MaaS Qwen3.8 27B (placeholder: the workspace writes the managed /etc/opencode/opencode.json at start)",
      "models": {
        "publishers/internal-models/models/qwen3-8-27b": {
          "name": "Qwen3.8 27B (Local GPU)",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      },
      "options": {
        "apiKey": "MAAS-SECRET-NOT-READY",
        "baseURL": "https://maas-gateway-not-configured.invalid/v1",
        "timeout": 1200000,
        "chunkTimeout": 600000
      }
    }
  },
  "model": "qwen38/publishers/internal-models/models/qwen3-8-27b",
  "small_model": "qwen38/publishers/internal-models/models/qwen3-8-27b",
  "mcp": {
    "openshift": {
      "type": "remote",
      "url": "http://openshift-mcp-server.mcp-servers.svc.cluster.local:8080/mcp",
      "enabled": true,
      "timeout": 10000
    },
    "quarkus-agent": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/bin/quarkus-agent-mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "git push *": "ask",
      "git reset --hard*": "ask",
      "oc delete *": "ask",
      "kubectl delete *": "ask"
    },
    "openshift_*": "ask"
  }
}
