{
 "schema": "rhoai3.reference-corpus/v1",
 "note": "M-3 reference qualification request corpus for the Owner path of the frozen PetClinic REST source. These are REQUESTS only; every expected response is the frozen source's capture (source-oracle/*.json). Steps run in order against a freshly seeded database; identifiers an application assigns are bound from THAT side's own responses and compared by name. `modes` names the security modes a step is sent in (disabled = petclinic.security.enable=false, the source default; enabled = true, BasicAuthenticationConfig). `engines` limits a step to the engines where it can be measured (sql steps read the committed state on a NEW connection and exist only where the database is reachable outside the application).",
 "application_root": "/petclinic/",
 "application_root_provenance": "frozen source src/main/resources/application.properties server.servlet.context-path=/petclinic/ (catalog application_paths: server.servlet.context-path -> quarkus.http.root-path)",
 "credentials_provenance": "the frozen source's own seed rows (db/postgresql/populateDB.sql: users admin/{noop}admin, roles ROLE_OWNER_ADMIN, ROLE_VET_ADMIN, ROLE_ADMIN); public sample data, not a secret",
 "reference_oracle": {
  "engines": {"http": "hsqldb", "sql": "postgresql"},
  "why": "HTTP exchanges are compared with the frozen source under its SELECTED profiles (hsqldb,spring-data-jpa: the M1 plan's source_profiles, the configuration the run's own captures and the destination's baseline-data.sql -- declared dataset db/hsqldb/populateDB.sql, sequences continued at the hsqldb values -- are derived from). Committed-state SQL steps are compared with the frozen source on PostgreSQL 16 seeded with its own db/postgresql scripts, the only source configuration whose committed state is readable on a new connection. The destination is ALWAYS measured on PostgreSQL; every row names both engines. The source's hsqldb and postgresql datasets differ (e.g. pet birth dates), which the source-engine-sensitivity row reports instead of hiding."
 },
 "compared_headers": ["location", "errors", "content-type", "www-authenticate", "access-control-allow-origin", "access-control-allow-methods", "access-control-allow-headers", "access-control-expose-headers", "access-control-allow-credentials", "access-control-max-age"],
 "normalizations": [
  "Location: the scheme://host:port origin is replaced by {origin}; a trailing identifier this side bound is replaced by its name",
  "identifiers each side assigned (bound from its own Location) are replaced by their names in bodies and the errors header",
  "Content-Type: RFC 9110 canonical form (lower-case type, parameters lower-cased and sorted, whitespace removed)",
  "CORS list headers (allow-methods, allow-headers, expose-headers): case-insensitive sets",
  "errors header: the JSON list of field errors compared as a multiset (the source's BindingResult order follows the validator's constraint iteration, which neither side guarantees)",
  "body_order=unordered: a top-level list whose selected source query declares no ORDER BY is compared as a multiset; nested lists keep their order (the source sorts Owner.pets by name)"
 ],
