+++ b/agent/request_pacer.py
@@ -0,0 +1,406 @@
+"""Per-run model request pacer (RHOAI3 Stage 080).
+
+Enforces a declared request allowance across every Hermes process of one run:
+each model HTTP request (main agent, every retry attempt, auxiliary calls,
+reviewer and other profiles) first takes one slot from a shared sliding-window
+ledger. Disabled unless the platform sets both:
+
+  RHOAI3_REQUEST_BUDGET="<n>/<window_seconds>"   e.g. "200/3600"
+  RHOAI3_REQUEST_LEDGER=<path>                    shared, append-only file
+
+and optionally RHOAI3_REQUEST_BUDGET_MAX_WAIT=<seconds> (default 900): the
+longest TOTAL time one request may wait for a slot (one bound for the main
+loop's reservation and the transport acquisition together). A longer wait
+raises :class:`RequestBudgetExhausted` before anything is sent.
+
+Ledger format: one line per granted slot, ``<epoch seconds> <pid> <label>``,
+appended under an exclusive ``flock`` on the ledger file itself, so
+concurrent processes share it and a restarted process sees the slots already
+spent in the window. Lines older than the window are ignored, never rewritten.
+
+Enforcement point: an httpx ``request`` event hook attached to every OpenAI
+SDK client Hermes constructs (main and auxiliary), so each HTTP attempt is
+counted exactly once, including SDK-internal and Hermes retries. Only POST
+requests are counted (model calls); ``GET /models`` probes are not.
+"""
+
+from __future__ import annotations
+
+import fcntl
+import itertools
+import logging
+import os
+import threading
+import time
+from contextlib import contextmanager
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_MAX_WAIT_SECONDS = 900.0
+_SLEEP_SLICE_SECONDS = 1.0
+
+# Seams for tests (fake clock).
+_now: Callable[[], float] = time.time
+_sleep: Callable[[float], None] = time.sleep
+_monotonic: Callable[[], float] = time.monotonic
+
+
+@dataclass(frozen=True)
+class PacerConfig:
+    limit: int
+    window: float
+    ledger: str
+    max_wait: float
+
+
+class RequestBudgetExhausted(RuntimeError):
+    """The next slot is further away than the permitted wait."""
+
+    def __init__(self, cfg: PacerConfig, next_slot_at: float, wait: float, waited: float = 0.0):
+        self.limit = cfg.limit
+        self.window = cfg.window
+        self.max_wait = cfg.max_wait
+        self.next_slot_at = next_slot_at
+        self.wait = wait
+        self.waited = waited
+        when = datetime.fromtimestamp(next_slot_at, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+        # Wording must not match kanban_db._RESPAWN_BLOCKER_RE (see
+        # turn_finalizer.record_kanban_turn_stop).
+        super().__init__(
+            f"STOP MODEL_REQUEST_BUDGET: {cfg.limit} requests in {int(cfg.window)}s "
+            f"already spent by this run; next slot at {when}; already waited "
+            f"{int(waited)}s, another {int(wait)}s exceeds the {int(cfg.max_wait)}s "
+            "total wait allowed; the worker stopped before sending. Infrastructure "
+            "allowance stop, not a product-repair verdict"
+        )
+
+
+def config() -> Optional[PacerConfig]:
+    """Pacer configuration from the environment, or None when disabled."""
+    raw = (os.environ.get("RHOAI3_REQUEST_BUDGET") or "").strip()
+    ledger = (os.environ.get("RHOAI3_REQUEST_LEDGER") or "").strip()
+    if not raw or not ledger:
+        return None
+    try:
+        limit_s, window_s = raw.split("/", 1)
+        limit, window = int(limit_s), float(window_s)
+    except ValueError:
+        logger.error("RHOAI3_REQUEST_BUDGET=%r is not '<n>/<window_seconds>'; pacer disabled", raw)
+        return None
+    if limit < 1 or window <= 0:
+        logger.error("RHOAI3_REQUEST_BUDGET=%r must be positive; pacer disabled", raw)
+        return None
+    try:
+        max_wait = float(os.environ.get("RHOAI3_REQUEST_BUDGET_MAX_WAIT") or DEFAULT_MAX_WAIT_SECONDS)
+    except ValueError:
+        max_wait = DEFAULT_MAX_WAIT_SECONDS
+    return PacerConfig(limit=limit, window=window, ledger=ledger, max_wait=max(0.0, max_wait))
+
+
+def _open_locked(path: str):
+    parent = os.path.dirname(path)
+    if parent:
+        os.makedirs(parent, exist_ok=True)
+    fh = open(path, "a+", encoding="utf-8")
+    fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
+    return fh
+
+
+def _slots_in_window(fh, now: float, window: float) -> list[float]:
+    fh.seek(0)
+    cutoff = now - window
+    out = []
+    for line in fh:
+        head = line.split(" ", 1)[0].strip()
+        try:
+            ts = float(head)
+        except ValueError:
+            continue
+        if ts > cutoff:
+            out.append(ts)
+    out.sort()
+    return out
+
+
+def _try_take(cfg: PacerConfig, label: str, take: bool) -> tuple[bool, float]:
+    """Under the ledger lock: take a slot (or just check). Returns (ok, next_slot_at)."""
+    fh = _open_locked(cfg.ledger)
+    try:
+        now = _now()
+        slots = _slots_in_window(fh, now, cfg.window)
+        if len(slots) < cfg.limit:
+            if take:
+                fh.seek(0, os.SEEK_END)
+                fh.write(f"{now:.6f} {os.getpid()} {label}\n")
+                fh.flush()
+                os.fsync(fh.fileno())
+            return True, now
+        # The slot that must expire for one more request to fit.
+        return False, slots[len(slots) - cfg.limit] + cfg.window
+    finally:
+        try:
+            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
+        finally:
+            fh.close()
+
+
+class RequestCancelledWhileWaiting(RuntimeError):
+    """The request attempt was cancelled (interrupt / superseded stream attempt)
+    before it was allowed onto the transport; nothing was sent."""
+
+
+# Header that carries a PacedAttempt id from the caller to the transport hook.
+# The hook removes it before the request is sent, so the provider never sees it.
+ATTEMPT_HEADER = "X-RHOAI3-Pace-Attempt"
+
+
+class PacedAttempt:
+    """One logical model request attempt and everything the pacer knows about it.
+
+    Created by the main loop for each API attempt and handed to the transport
+    hook EXPLICITLY (via ``ATTEMPT_HEADER`` on that attempt's own request), so
+    ownership does not depend on which thread runs the HTTP call:
+
+    - its reservation (a slot taken before the call) can only be consumed by a
+      request carrying this attempt's id -- never by an auxiliary call or by a
+      different (retried) attempt;
+    - its monotonic deadline (created + max_wait) bounds every wait made for
+      it: the reservation and any later acquisition (stream reconnect);
+    - its cancellation predicate is checked before the reservation is
+      consumed and before a request is allowed onto the transport;
+    - ``waiting`` is true only while THIS attempt sleeps for a slot before
+      sending, so the stream stale watchdog exempts only its own pre-send wait.
+    """
+
+    def __init__(self, label: str, max_wait: float,
+                 cancelled: Optional[Callable[[], bool]] = None):
+        self.id = f"{os.getpid()}-{next(_attempt_ids)}"
+        self.label = label
+        self.started = _monotonic()
+        self.max_wait = max_wait
+        self.slept = 0.0
+        self.waiting = False
+        self._prepaid = False
+        self._cancelled = cancelled
+        self._lock = threading.Lock()
+
+    def waited(self) -> float:
+        return max(self.slept, _monotonic() - self.started)
+
+    def is_cancelled(self) -> bool:
+        pred = self._cancelled
+        try:
+            return bool(pred is not None and pred())
+        except Exception:
+            return False
+
+    def set_cancel(self, predicate: Optional[Callable[[], bool]]) -> None:
+        self._cancelled = predicate
+
+    def take_prepaid(self) -> bool:
+        with self._lock:
+            if self._prepaid:
+                self._prepaid = False
+                return True
+            return False
+
+    def close(self) -> None:
+        """Forget this attempt (an unused reservation stays counted)."""
+        with _registry_lock:
+            _registry.pop(self.id, None)
+
+
+_attempt_ids = itertools.count(1)
+_registry_lock = threading.Lock()
+_registry: "dict[str, PacedAttempt]" = {}
+_tls = threading.local()
+
+
+def attempt_for_kwargs(api_kwargs: Any) -> Optional[PacedAttempt]:
+    """The PacedAttempt an API kwargs dict was tagged with, if any."""
+    try:
+        headers = (api_kwargs or {}).get("extra_headers") or {}
+        attempt_id = headers.get(ATTEMPT_HEADER)
+    except Exception:
+        return None
+    if not attempt_id:
+        return None
+    with _registry_lock:
+        return _registry.get(str(attempt_id))
+
+
+def tag_kwargs(api_kwargs: dict, attempt: Optional[PacedAttempt]) -> dict:
+    """Carry ``attempt`` on this call's request (a header the hook strips)."""
+    if attempt is None:
+        return api_kwargs
+    headers = dict(api_kwargs.get("extra_headers") or {})
+    headers[ATTEMPT_HEADER] = attempt.id
+    api_kwargs["extra_headers"] = headers
+    return api_kwargs
+
+
+@contextmanager
+def cancel_check(predicate: Callable[[], bool]):
+    """Register, for untagged requests sent from this thread, a cancellation
+    predicate (auxiliary callers). Tagged attempts carry their own."""
+    previous = getattr(_tls, "cancelled", None)
+    _tls.cancelled = predicate
+    try:
+        yield
+    finally:
+        _tls.cancelled = previous
+
+
+def _acquire_or_wait(
+    label: str,
+    activity: Optional[Callable[[str], Any]] = None,
+    cancelled: Optional[Callable[[], bool]] = None,
+    attempt: Optional[PacedAttempt] = None,
+) -> None:
+    """Take one slot within the attempt's total wait bound.
+
+    The whole wait of the attempt (reservation and any later acquisition) is
+    charged against ``max_wait``: the elapsed wait on a monotonic clock, and at
+    least the sum of the sleeps taken, since the attempt was created. A
+    competitor that keeps winning the expiring slots cannot extend it. When the
+    first predicted slot already lies beyond the allowance it stops at once.
+    Cancellation is checked before every look at the ledger, so a cancelled
+    attempt never takes a slot or reaches the transport.
+    """
+    cfg = config()
+    if cfg is None:
+        return
+    if attempt is None:
+        attempt = PacedAttempt(label, cfg.max_wait, cancelled)
+    while True:
+        if attempt.is_cancelled():
+            raise RequestCancelledWhileWaiting(f"request cancelled while waiting for a slot ({label})")
+        ok, next_at = _try_take(cfg, label, True)
+        if ok:
+            return
+        waited = attempt.waited()
+        wait = max(0.0, next_at - _now())
+        if wait > attempt.max_wait - waited:
+            raise RequestBudgetExhausted(cfg, next_at, wait, waited)
+        logger.info("request pacer: window full (%d/%ss); waiting %.1fs for %s (waited %.1fs)",
+                    cfg.limit, cfg.window, wait, label, waited)
+        if activity is not None:
+            try:
+                activity(f"request pacer: waiting {int(wait)}s for a model request slot")
+            except Exception:
+                pass
+        step = min(wait, _SLEEP_SLICE_SECONDS) if wait > 0 else 0.01
+        attempt.waiting = True
+        try:
+            _sleep(step)
+        finally:
+            attempt.waiting = False
+        attempt.slept += step
+
+
+def acquire(label: str = "request", activity: Optional[Callable[[str], Any]] = None) -> None:
+    """Take one slot for an untagged request (own deadline, thread's cancel check)."""
+    _acquire_or_wait(label, activity, getattr(_tls, "cancelled", None))
+
+
+def reserve(activity: Optional[Callable[[str], Any]] = None,
+            cancelled: Optional[Callable[[], bool]] = None) -> Optional[PacedAttempt]:
+    """Main loop, before its API call: create the attempt, take its slot now
+    (a long wait happens here, outside the stream stale detector) and keep it
+    prepaid for this attempt's own request. Returns the attempt to tag the
+    call with (``tag_kwargs``), or None when the pacer is disabled."""
+    cfg = config()
+    if cfg is None:
+        return None
+    attempt = PacedAttempt("reserve", cfg.max_wait, cancelled)
+    _acquire_or_wait("reserve", activity, None, attempt)
+    with attempt._lock:
+        attempt._prepaid = True
+    with _registry_lock:
+        _registry[attempt.id] = attempt
+    return attempt
+
+
+def _label_for(request) -> str:
+    try:
+        return str(request.url.path or "request").rsplit("/", 1)[-1] or "request"
+    except Exception:
+        return "request"
+
+
+def _hook_acquire(label: str, cancelled: Optional[Callable[[], bool]],
+                  attempt: Optional[PacedAttempt] = None) -> None:
+    """Admit one HTTP request to the transport.
+
+    A tagged request uses its own attempt: cancellation is checked first, then
+    its reservation is consumed; without one (a stream reconnect) it acquires a
+    new slot within the attempt's ORIGINAL deadline. An untagged request
+    (auxiliary call) never touches another attempt's reservation: it acquires
+    its own slot with its own deadline and cancellation.
+    """
+    if config() is None:
+        return
+    if attempt is not None:
+        if attempt.is_cancelled():
+            raise RequestCancelledWhileWaiting(f"request cancelled before transport ({label})")
+        if attempt.take_prepaid():
+            return
+        _acquire_or_wait(label, None, None, attempt)
+        return
+    if cancelled is not None and cancelled():
+        raise RequestCancelledWhileWaiting(f"request cancelled before transport ({label})")
+    _acquire_or_wait(label, None, cancelled)
+
+
+def _attempt_from_request(request) -> Optional[PacedAttempt]:
+    try:
+        attempt_id = request.headers.get(ATTEMPT_HEADER)
+        if attempt_id is not None:
+            del request.headers[ATTEMPT_HEADER]
+    except Exception:
+        return None
+    if not attempt_id:
+        return None
+    with _registry_lock:
+        return _registry.get(attempt_id)
+
+
+def _sync_hook(request) -> None:
+    attempt = _attempt_from_request(request)
+    if getattr(request, "method", "").upper() != "POST":
+        return
+    _hook_acquire(_label_for(request), getattr(_tls, "cancelled", None), attempt)
+
+
+async def _async_hook(request) -> None:
+    attempt = _attempt_from_request(request)
+    if getattr(request, "method", "").upper() != "POST":
+        return
+    import asyncio
+
+    await asyncio.to_thread(_hook_acquire, _label_for(request), None, attempt)
+
+
+def attach(openai_client: Any) -> Any:
+    """Install the pacer hook on an OpenAI SDK client's httpx client (idempotent).
+
+    A no-op when the pacer is disabled, so clients built without the platform
+    environment are unchanged.
+    """
+    if config() is None or openai_client is None:
+        return openai_client
+    http = getattr(openai_client, "_client", None)
+    hooks = getattr(http, "event_hooks", None)
+    if not isinstance(hooks, dict):
+        return openai_client
+    import httpx
+
+    hook = _async_hook if isinstance(http, httpx.AsyncClient) else _sync_hook
+    request_hooks = list(hooks.get("request") or [])
+    if hook not in request_hooks:
+        request_hooks.append(hook)
+        http.event_hooks = {**hooks, "request": request_hooks}
+    return openai_client
