+++ b/agent/request_pacer.py
@@ -0,0 +1,301 @@
+"""Per-run model request pacer (RHOAI3 Stage 080).
+
+Enforces a declared request allowance across every Hermes process of one run:
+each model HTTP request (main agent, every retry attempt, auxiliary calls,
+reviewer and other profiles) first takes one slot from a shared sliding-window
+ledger. Disabled unless the platform sets both:
+
+  RHOAI3_REQUEST_BUDGET="<n>/<window_seconds>"   e.g. "200/3600"
+  RHOAI3_REQUEST_LEDGER=<path>                    shared, append-only file
+
+and optionally RHOAI3_REQUEST_BUDGET_MAX_WAIT=<seconds> (default 900): the
+longest TOTAL time one request may wait for a slot (one bound for the main
+loop's reservation and the transport acquisition together). A longer wait
+raises :class:`RequestBudgetExhausted` before anything is sent.
+
+Ledger format: one line per granted slot, ``<epoch seconds> <pid> <label>``,
+appended under an exclusive ``flock`` on the ledger file itself, so
+concurrent processes share it and a restarted process sees the slots already
+spent in the window. Lines older than the window are ignored, never rewritten.
+
+Enforcement point: an httpx ``request`` event hook attached to every OpenAI
+SDK client Hermes constructs (main and auxiliary), so each HTTP attempt is
+counted exactly once, including SDK-internal and Hermes retries. Only POST
+requests are counted (model calls); ``GET /models`` probes are not.
+"""
+
+from __future__ import annotations
+
+import fcntl
+import logging
+import os
+import threading
+import time
+from contextlib import contextmanager
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_MAX_WAIT_SECONDS = 900.0
+_SLEEP_SLICE_SECONDS = 1.0
+
+# Seams for tests (fake clock).
+_now: Callable[[], float] = time.time
+_sleep: Callable[[float], None] = time.sleep
+_monotonic: Callable[[], float] = time.monotonic
+
+
+@dataclass(frozen=True)
+class PacerConfig:
+    limit: int
+    window: float
+    ledger: str
+    max_wait: float
+
+
+class RequestBudgetExhausted(RuntimeError):
+    """The next slot is further away than the permitted wait."""
+
+    def __init__(self, cfg: PacerConfig, next_slot_at: float, wait: float, waited: float = 0.0):
+        self.limit = cfg.limit
+        self.window = cfg.window
+        self.max_wait = cfg.max_wait
+        self.next_slot_at = next_slot_at
+        self.wait = wait
+        self.waited = waited
+        when = datetime.fromtimestamp(next_slot_at, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+        # Wording must not match kanban_db._RESPAWN_BLOCKER_RE (see
+        # turn_finalizer.record_kanban_turn_stop).
+        super().__init__(
+            f"STOP MODEL_REQUEST_BUDGET: {cfg.limit} requests in {int(cfg.window)}s "
+            f"already spent by this run; next slot at {when}; already waited "
+            f"{int(waited)}s, another {int(wait)}s exceeds the {int(cfg.max_wait)}s "
+            "total wait allowed; the worker stopped before sending. Infrastructure "
+            "allowance stop, not a product-repair verdict"
+        )
+
+
+def config() -> Optional[PacerConfig]:
+    """Pacer configuration from the environment, or None when disabled."""
+    raw = (os.environ.get("RHOAI3_REQUEST_BUDGET") or "").strip()
+    ledger = (os.environ.get("RHOAI3_REQUEST_LEDGER") or "").strip()
+    if not raw or not ledger:
+        return None
+    try:
+        limit_s, window_s = raw.split("/", 1)
+        limit, window = int(limit_s), float(window_s)
+    except ValueError:
+        logger.error("RHOAI3_REQUEST_BUDGET=%r is not '<n>/<window_seconds>'; pacer disabled", raw)
+        return None
+    if limit < 1 or window <= 0:
+        logger.error("RHOAI3_REQUEST_BUDGET=%r must be positive; pacer disabled", raw)
+        return None
+    try:
+        max_wait = float(os.environ.get("RHOAI3_REQUEST_BUDGET_MAX_WAIT") or DEFAULT_MAX_WAIT_SECONDS)
+    except ValueError:
+        max_wait = DEFAULT_MAX_WAIT_SECONDS
+    return PacerConfig(limit=limit, window=window, ledger=ledger, max_wait=max(0.0, max_wait))
+
+
+def _open_locked(path: str):
+    parent = os.path.dirname(path)
+    if parent:
+        os.makedirs(parent, exist_ok=True)
+    fh = open(path, "a+", encoding="utf-8")
+    fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
+    return fh
+
+
+def _slots_in_window(fh, now: float, window: float) -> list[float]:
+    fh.seek(0)
+    cutoff = now - window
+    out = []
+    for line in fh:
+        head = line.split(" ", 1)[0].strip()
+        try:
+            ts = float(head)
+        except ValueError:
+            continue
+        if ts > cutoff:
+            out.append(ts)
+    out.sort()
+    return out
+
+
+def _try_take(cfg: PacerConfig, label: str, take: bool) -> tuple[bool, float]:
+    """Under the ledger lock: take a slot (or just check). Returns (ok, next_slot_at)."""
+    fh = _open_locked(cfg.ledger)
+    try:
+        now = _now()
+        slots = _slots_in_window(fh, now, cfg.window)
+        if len(slots) < cfg.limit:
+            if take:
+                fh.seek(0, os.SEEK_END)
+                fh.write(f"{now:.6f} {os.getpid()} {label}\n")
+                fh.flush()
+                os.fsync(fh.fileno())
+            return True, now
+        # The slot that must expire for one more request to fit.
+        return False, slots[len(slots) - cfg.limit] + cfg.window
+    finally:
+        try:
+            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
+        finally:
+            fh.close()
+
+
+class RequestCancelledWhileWaiting(RuntimeError):
+    """The request was cancelled (interrupt / superseded stream attempt) while
+    it waited for a slot; no slot was taken and nothing was sent."""
+
+
+# Process-local wait state: how many threads are sleeping in the pacer right
+# now (the stream stale watchdog treats a pacer wait as activity, not as a
+# silent provider), and slots the main loop reserved before its API call that
+# the transport hook consumes instead of taking a second slot.
+_state_lock = threading.Lock()
+_waiting_threads = 0
+_prepaid: list[float] = []
+_PREPAID_TTL_SECONDS = 60.0
+_tls = threading.local()
+
+
+def waiting() -> bool:
+    """True while any thread of this process is waiting for a request slot."""
+    with _state_lock:
+        return _waiting_threads > 0
+
+
+@contextmanager
+def cancel_check(predicate: Callable[[], bool]):
+    """Register, for requests sent from this thread, a predicate that aborts a
+    pacer wait (raising :class:`RequestCancelledWhileWaiting`) once true."""
+    previous = getattr(_tls, "cancelled", None)
+    _tls.cancelled = predicate
+    try:
+        yield
+    finally:
+        _tls.cancelled = previous
+
+
+def _acquire_or_wait(
+    label: str,
+    activity: Optional[Callable[[str], Any]] = None,
+    cancelled: Optional[Callable[[], bool]] = None,
+) -> None:
+    """Take one slot. The whole wait of this acquisition is bounded by
+    ``max_wait``: the elapsed wait (monotonic clock, and at least the sum of the
+    sleeps taken) is charged against the allowance, so a competitor that keeps
+    winning the expiring slots cannot extend it. The first check still stops
+    immediately when the predicted slot already lies beyond the allowance."""
+    global _waiting_threads
+    cfg = config()
+    if cfg is None:
+        return
+    started = _monotonic()
+    slept = 0.0
+    while True:
+        if cancelled is not None and cancelled():
+            raise RequestCancelledWhileWaiting(f"request cancelled while waiting for a slot ({label})")
+        ok, next_at = _try_take(cfg, label, True)
+        if ok:
+            return
+        waited = max(slept, _monotonic() - started)
+        wait = max(0.0, next_at - _now())
+        if wait > cfg.max_wait - waited:
+            raise RequestBudgetExhausted(cfg, next_at, wait, waited)
+        logger.info("request pacer: window full (%d/%ss); waiting %.1fs for %s (waited %.1fs)",
+                    cfg.limit, cfg.window, wait, label, waited)
+        if activity is not None:
+            try:
+                activity(f"request pacer: waiting {int(wait)}s for a model request slot")
+            except Exception:
+                pass
+        step = min(wait, _SLEEP_SLICE_SECONDS) if wait > 0 else 0.01
+        with _state_lock:
+            _waiting_threads += 1
+        try:
+            _sleep(step)
+        finally:
+            with _state_lock:
+                _waiting_threads -= 1
+        slept += step
+
+
+def acquire(label: str = "request", activity: Optional[Callable[[str], Any]] = None) -> None:
+    """Take one slot, waiting (bounded by ``max_wait``) when the window is full."""
+    _acquire_or_wait(label, activity, getattr(_tls, "cancelled", None))
+
+
+def reserve(activity: Optional[Callable[[str], Any]] = None) -> None:
+    """Main loop, before its API call: take the slot now (a long wait happens
+    here, outside the stream stale detector) and leave it prepaid for the
+    transport hook, so the hook does not wait again or take a second slot and
+    the allowance to wait is not renewed between the two."""
+    if config() is None:
+        return
+    _acquire_or_wait("reserve", activity, None)
+    with _state_lock:
+        _prepaid.append(_monotonic())
+
+
+def _take_prepaid() -> bool:
+    now = _monotonic()
+    with _state_lock:
+        while _prepaid and now - _prepaid[0] > _PREPAID_TTL_SECONDS:
+            _prepaid.pop(0)  # reserved but never sent; the slot stays counted
+        if _prepaid:
+            _prepaid.pop(0)
+            return True
+    return False
+
+
+def _label_for(request) -> str:
+    try:
+        return str(request.url.path or "request").rsplit("/", 1)[-1] or "request"
+    except Exception:
+        return "request"
+
+
+def _hook_acquire(label: str, cancelled: Optional[Callable[[], bool]]) -> None:
+    if config() is None or _take_prepaid():
+        return
+    _acquire_or_wait(label, None, cancelled)
+
+
+def _sync_hook(request) -> None:
+    if getattr(request, "method", "").upper() != "POST":
+        return
+    _hook_acquire(_label_for(request), getattr(_tls, "cancelled", None))
+
+
+async def _async_hook(request) -> None:
+    if getattr(request, "method", "").upper() != "POST":
+        return
+    import asyncio
+
+    await asyncio.to_thread(_hook_acquire, _label_for(request), None)
+
+
+def attach(openai_client: Any) -> Any:
+    """Install the pacer hook on an OpenAI SDK client's httpx client (idempotent).
+
+    A no-op when the pacer is disabled, so clients built without the platform
+    environment are unchanged.
+    """
+    if config() is None or openai_client is None:
+        return openai_client
+    http = getattr(openai_client, "_client", None)
+    hooks = getattr(http, "event_hooks", None)
+    if not isinstance(hooks, dict):
+        return openai_client
+    import httpx
+
+    hook = _async_hook if isinstance(http, httpx.AsyncClient) else _sync_hook
+    request_hooks = list(hooks.get("request") or [])
+    if hook not in request_hooks:
+        request_hooks.append(hook)
+        http.event_hooks = {**hooks, "request": request_hooks}
+    return openai_client
