+"""Near-duplicate loop guard (RHOAI3 V21): the live loops halt, real work does not.
+
+The five loop shapes are replays of v21 worker runs (Qwen3.8-27B, 2026-09-27/28)
+that ran 10-40 minutes because identical_call_streak_halt only matches
+byte-identical arguments. Each replay drives the controller the way
+run_agent._append_guardrail_observation does: after_call, then observe_call.
+"""
+
+import json
+
+from agent.tool_guardrails import (
+    NEAR_DUPLICATE_HALT_CODE,
+    NEAR_DUPLICATE_WARN_CODE,
+    NearDuplicateConfig,
+    ToolCallGuardrailConfig,
+    ToolCallGuardrailController,
+    _terminal_command_mutates,
+)
+
+REPO = "src/main/java/org/springframework/samples/petclinic"
+BRIEF = "verification/loop/brief-u-cd4a81a71d9f.json"
+
+
+def _hard_stop():
+    return ToolCallGuardrailController(ToolCallGuardrailConfig(hard_stop_enabled=True))
+
+
+def _term(command, output="", exit_code=0):
+    return ("terminal", {"command": command}, json.dumps({"output": output, "exit_code": exit_code, "error": None}))
+
+
+def _patch(path):
+    return ("patch", {"path": path, "old_string": "a", "new_string": "b"}, json.dumps({"success": True}))
+
+
+def _replay(controller, calls):
+    """Drive the controller like the runtime; return (index, halt, warnings)."""
+    warnings = []
+    for index, (tool, args, result) in enumerate(calls):
+        decision = controller.after_call(tool, args, result, failed=False)
+        controller.observe_call(tool, args, result)
+        if decision.action == "warn":
+            warnings.append(decision.code)
+        halt = decision if decision.should_halt else controller.halt_decision
+        if halt is not None:
+            return index, halt, warnings
+    return None, None, warnings
+
+
+def _lines(prefix, n, start=0):
+    return "\n".join(f"{prefix} line {i}" for i in range(start, start + n))
+
+
+# ── the five live loop shapes halt ───────────────────────────────────────
+
+
+def test_alternating_pair_run44_halts():
+    spring = "\n".join(
+        [f"[INFO] +- org.springframework:spring-mod{i}:jar:6.1.{i}:compile" for i in range(25)]
+        + [f"[INFO] |  +- io.spring.gradle:spring-extra{i}:jar:1.{i}:compile" for i in range(15)]
+    )
+    org = "\n".join(line for line in spring.splitlines() if "org.springframework" in line)
+    calls = []
+    for _ in range(20):
+        calls.append(_term('mvn dependency:tree | grep "spring"', spring))
+        calls.append(_term('mvn dependency:tree | grep "org.springframework"', org))
+    index, halt, warnings = _replay(_hard_stop(), calls)
+    assert halt is not None and halt.code == NEAR_DUPLICATE_HALT_CODE
+    assert index <= 13  # 12 non-progressing near-duplicates after the first call
+    assert NEAR_DUPLICATE_WARN_CODE in warnings
+    assert "near-duplicate" in halt.message
+
+
+def test_growing_argument_run35_halts():
+    calls = [
+        _term('grep -rn "@Profile" src/main/java', f"{REPO}/repository/jdbc/JdbcOwnerRepositoryImpl.java:52:@Profile(\"jdbc\")"),
+        _term('grep -rln "context.annotation.Profile" src/main/java', f"{REPO}/repository/jpa/JpaOwnerRepositoryImpl.java"),
+    ]
+    package = "springframework.web.servlet.handler"
+    for part in ["support", "converter", "avro", "generic", "datatype", "protobuf", "smile",
+                 "msgpack", "bson", "cbor", "ion", "yaml", "toml", "xml", "json", "csv",
+                 "thrift", "capnp", "flatbuf", "orc"]:
+        package += "." + part
+        calls.append(_term(f'find src/main/java -name "*.java" | xargs grep -l "{package}"', ""))
+    index, halt, _ = _replay(_hard_stop(), calls)
+    assert halt is not None and halt.code == NEAR_DUPLICATE_HALT_CODE
+    assert index <= 2 + 12
+
