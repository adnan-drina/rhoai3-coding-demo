+def test_widening_context_run39_halts_when_it_keeps_widening():
+    section = [f"attempt record {n}" for n in range(300)]
+    section[290] = "outcome REVERTED: jakarta.enterprise.inject.ApplicationScoped not on the classpath"
+
+    def before(n):
+        cmd = f'python3 verification/loop/brief.py --section previous_attempts | grep -B{n} "REVERTED"'
+        return _term(cmd, "\n".join(section[max(0, 290 - n):291]))
+
+    series = [20, 50, 100, 200, 400, 800, 1500]
+    # The seven logged calls alone stay under the threshold ...
+    index, halt, _ = _replay(_hard_stop(), [before(n) for n in series])
+    assert halt is None
+    # ... the loop halts once the widening goes on without new output.
+    more = [2000, 3000, 5000, 10000, 20000, 50000, 100000, 200000]
+    index, halt, _ = _replay(_hard_stop(), [before(n) for n in series + more])
+    assert halt is not None and halt.code == NEAR_DUPLICATE_HALT_CODE
+    assert index <= 13
+
+
+def test_dissimilar_alternating_cycle_halts():
+    # A cycle of two unrelated read probes, neither showing anything new.
+    calls = []
+    for _ in range(10):
+        calls.append(_term(f"cat {REPO}/model/Owner.java | sed -n '1,5p'", _lines("owner", 5)))
+        calls.append(_term('mvn -q help:evaluate -Dexpression=project.version -DforceStdout', "3.4.0"))
+    index, halt, _ = _replay(_hard_stop(), calls)
+    assert halt is not None and halt.code == NEAR_DUPLICATE_HALT_CODE
+    assert "cycle of 2" in halt.message
+    assert index == 13  # 6 laps of 2 after the first (new-output) lap
+
+
+# ── real work does not halt ──────────────────────────────────────────────
+
+
+def test_fix_until_green_sequence_does_not_halt():
+    calls = []
+    brief = _lines("brief digest", 40)
+    for i in range(8):
+        calls.append(_term("python3 verification/loop/brief.py", brief))
+        calls.append(_term(f'grep -n "findById" {REPO}/repository/Repo{i}.java', f"{i}:  Owner findById(int id);"))
+        calls.append(_term(f"cat {REPO}/repository/jpa/Impl{i}.java", _lines(f"impl{i}", 30)))
+        calls.append(_term(f'grep -rn "Repo{i}" {REPO}', _lines(f"usage{i}", 4)))
+        calls.append(_patch(f"{REPO}/repository/jpa/Impl{i}.java"))
+        calls.append(_term("bash verification/loop/run-verify.sh", "BUILD FAILURE\n[ERROR] cannot find symbol", exit_code=1))
+        calls.append(_patch(f"{REPO}/repository/jpa/Impl{i}.java"))
+        calls.append(_term("bash verification/loop/run-verify.sh", "BUILD SUCCESS\nmeasure [0, 179, 0]"))
+        calls.append(_term("python3 verification/loop/advance.py", f"ACCEPTED u:{i}, OUTCOME ACCEPTED"))
+    index, halt, warnings = _replay(_hard_stop(), calls)
+    assert halt is None, (index, halt)
+    assert NEAR_DUPLICATE_WARN_CODE not in warnings
