+def test_sed_window_walk_run37_halts():
+    path = f"{REPO}/repository/PetRepository.java"
+    source = [f"    // PetRepository source line {n}" for n in range(1, 81)]
+
+    def window(a, b):
+        return _term(f"cat {path} | sed -n '{a},{b}p'", "\n".join(source[a - 1:b]))
+
+    calls = []
+    for _ in range(3):
+        calls.append(window(45, 80))
+        calls.extend(window(n, n + 5) for n in range(45, 0, -1))
+    index, halt, _ = _replay(_hard_stop(), calls)
+    assert halt is not None and halt.code == NEAR_DUPLICATE_HALT_CODE
+    assert index <= 13
+
