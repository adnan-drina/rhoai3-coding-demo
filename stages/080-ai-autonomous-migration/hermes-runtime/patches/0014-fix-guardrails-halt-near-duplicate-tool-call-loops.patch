+def test_chained_variant_run36_halts():
+    head = f"grep -o '\"status\":\"open\",\"unit\":{{.\\{{3900,4250\\}}' {BRIEF} | cut -c 60-120"
+    window = '"requirement":"fragment implementation of OwnerRepository'
+    tails = [
+        (f"wc -c {BRIEF}", f"153211 {BRIEF}"),
+        (f"python3 -c \"import json; print(len(json.load(open('{BRIEF}'))['units']))\"", "15"),
+        (f"grep -c '\"unit\"' {BRIEF}", "47"),
+        ("ls -la verification/loop", "total 212\n-rw-r--r-- 1 u u 153211 brief.json"),
+    ]
+    calls = []
+    for i in range(65):
+        tail, out = tails[i % len(tails)]
+        calls.append(_term(f'{head} && echo "---" && {tail}', f"{window}\n---\n{out}"))
+    index, halt, _ = _replay(_hard_stop(), calls)
+    assert halt is not None and halt.code == NEAR_DUPLICATE_HALT_CODE
+    assert index <= 13
