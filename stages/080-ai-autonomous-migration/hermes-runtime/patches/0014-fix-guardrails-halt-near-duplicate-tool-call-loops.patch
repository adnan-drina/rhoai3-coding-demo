     return lines
 
+# ── Near-duplicate loop guard (_observe_near_duplicate) ──────────────────
+
+NEAR_DUPLICATE_HALT_CODE = "near_duplicate_loop_halt"
+NEAR_DUPLICATE_WARN_CODE = "near_duplicate_loop_warning"
+# Board transitions: after one of these the model is on a new step. Reads of
+# the board (kanban_show/kanban_list), heartbeats and comments are not.
+_KANBAN_TRANSITION_TOOLS = frozenset(
+    {"kanban_complete", "kanban_block", "kanban_request_review",
+     "kanban_request_changes", "kanban_create", "kanban_unblock", "kanban_link",
+     "kanban_attach", "kanban_attach_url"}
+)
+# Shell tokens: quoted literals (an unterminated one runs to the end),
+# substitutions, redirections, operators, newlines and plain words.
+_ND_TOKEN = re.compile(
+    r"'[^']*'?"
+    r'|"(?:\\.|[^"\\])*"?'
+    r"|\$\((?:[^()]|\([^()]*\))*\)?"
+    r"|`[^`]*`?"
+    r"|\d*>>?[|&]?\d*-?|&>>?|<<<?-?|<"
+    r"|\|\||&&|[|;&()\n]"
+    r"|[^\s'\"|;&<>()`]+"
+)
+_ND_SEPARATORS = frozenset({"|", "||", "&&", ";", "&", "\n", "(", ")"})
+_ND_DIGITS = re.compile(r"\d+")
+_ND_FD_DUP = re.compile(r">&\d*-?$")
+_ND_SINKS = frozenset({"/dev/null", "/dev/stdout", "/dev/stderr"})
+# Programs that change files or the repository whatever their arguments.
+_ND_WRITING_PROGRAMS = frozenset(
+    {"rm", "mv", "cp", "mkdir", "rmdir", "touch", "tee", "ln", "chmod", "chown",
+     "install", "truncate", "patch", "dd", "rsync", "unzip", "tar", "sponge"}
+)
+_ND_IN_PLACE_PROGRAMS = frozenset({"sed", "gsed", "perl", "ruby"})
+_ND_PREFIX_PROGRAMS = frozenset({"sudo", "env", "command", "time", "xargs", "nohup"})
+_ND_GIT_WRITING = frozenset(
+    {"add", "am", "apply", "checkout", "cherry-pick", "clean", "clone", "commit",
+     "init", "merge", "mv", "pull", "rebase", "reset", "restore", "revert", "rm",
+     "stash", "switch", "tag"}
+)
+# A script body (python -c, heredoc) that writes files.
+_ND_SCRIPT_WRITES = re.compile(
+    r"\.write\(|write_text\(|write_bytes\("
+    r"|\bos\.(?:remove|rename|replace|unlink|makedirs|mkdir)\("
+    r"|\bshutil\."
+    r"|\bopen\([^)]*,\s*(?:mode\s*=\s*)?['\"][^'\"]*[wax]"
+)
+
+
+@dataclass(frozen=True)
+class _NearDuplicateCall:
+    tool_name: str
+    tokens: tuple
+    progressing: bool
+    description: str
+
+
+def _shell_tokens(command: str) -> list:
+    return _ND_TOKEN.findall(command)
+
+
+def _shell_segments(tokens: list) -> list:
+    segments: list = [[]]
+    for tok in tokens:
+        if tok in _ND_SEPARATORS:
+            segments.append([])
+        else:
+            segments[-1].append(tok)
+    return [seg for seg in segments if seg]
+
+
+def _is_quoted(tok: str) -> bool:
+    return tok[:1] in ("'", '"', "`") or tok.startswith("$(")
+
+
+def _normalise_word(word: str) -> str:
+    return _ND_DIGITS.sub("#", word)
+
+
+def _near_duplicate_tokens(command: str) -> list:
+    """Normalised token sequence of a terminal command.
+
+    Quoted literals and ``$(...)``/backtick substitutions become ``'…'``,
+    digit runs become ``#`` and leading ``cd DIR`` segments are dropped.
+    Operators and every other word are kept, so the programs, their
+    options, the files and the shape of the pipeline decide similarity.
+    """
+    tokens = _shell_tokens(command)
+    while tokens and tokens[0] == "cd":
+        k = 1
+        while k < len(tokens) and tokens[k] not in _ND_SEPARATORS:
+            k += 1
+        tokens = tokens[k + 1:]
+    out = []
+    for tok in tokens:
+        if _is_quoted(tok):
+            out.append("'…'")
+        elif tok == "\n":
+            out.append(";")
+        else:
+            out.append(_normalise_word(tok))
+    return out
+
+
+def _near_duplicate_arg_tokens(args: Mapping[str, Any]) -> list:
+    """Normalised ``key=value`` tokens of a read tool's arguments."""
+    out = []
+    for key in sorted(args, key=str):
+        value = args[key]
+        if isinstance(value, (dict, list)):
+            value = canonical_tool_args({"v": value})
+        out.append(f"{key}={_normalise_word(str(value))}")
+    return out
+
+
+def _terminal_command_mutates(command: str) -> bool:
+    """Whether a terminal command visibly writes a file or the repository.
+
+    Deliberately generous: a write resets the near-duplicate history, so a
+    false "writes" only delays a halt. Counted as writes: output redirection
+    to a file, a writing program (``rm``, ``mv``, ``cp``, ``tee`` …), an
+    in-place editor (``sed -i``, ``perl -pi``), a writing git subcommand, or
+    a script body that writes (``open(…, 'w')``, ``.write(``, ``shutil.``).
+    """
+    tokens = _shell_tokens(command)
+    for i, tok in enumerate(tokens):
+        if ">" in tok and not _is_quoted(tok):
+            if _ND_FD_DUP.search(tok):
+                continue  # descriptor duplication such as 2>&1
+            target = tokens[i + 1] if i + 1 < len(tokens) else ""
+            if target not in _ND_SINKS:
+                return True
+    for seg in _shell_segments(tokens):
+        k = 0
+        while k < len(seg):
+            if _ENV_ASSIGNMENT.match(seg[k]):
+                k += 1
+            elif seg[k] in _ND_PREFIX_PROGRAMS:
+                k += 1
+                while k < len(seg) and seg[k].startswith("-"):
+                    k += 1
+            else:
+                break
+        if k >= len(seg):
+            continue
+        program = seg[k].rsplit("/", 1)[-1]
+        rest = seg[k + 1:]
+        if program in _ND_WRITING_PROGRAMS:
+            return True
+        if program in _ND_IN_PLACE_PROGRAMS:
+            for a in rest:
+                if a == "--in-place" or a.startswith("--in-place="):
+                    return True
+                if a.startswith("-") and not a.startswith("--") and "i" in a[1:].split(".")[0]:
+                    return True
+        if program == "git":
+            m = 0
+            while m < len(rest) and rest[m].startswith("-"):
+                m += 2 if rest[m] in ("-C", "-c", "--git-dir", "--work-tree") else 1
+            if m < len(rest) and rest[m] in _ND_GIT_WRITING:
+                return True
+    return bool(_ND_SCRIPT_WRITES.search(command))
+
+
+def _near_duplicates(a: _NearDuplicateCall, b: _NearDuplicateCall, threshold: float) -> bool:
+    if a.tool_name != b.tool_name:
+        return False
+    if a.tokens == b.tokens:
+        return True
+    return difflib.SequenceMatcher(None, a.tokens, b.tokens, autojunk=False).ratio() >= threshold
+
+
+def _near_duplicate_cycle_laps(history: list, period: int, threshold: float) -> int:
+    """Laps of the trailing cycle of ``period`` calls: every call in it is
+    non-progressing and a near-duplicate of the call one period earlier."""
+    run = 0
+    j = len(history) - 1
+    while j - period >= 0:
+        a, b = history[j], history[j - period]
+        if a.progressing or b.progressing or not _near_duplicates(a, b, threshold):
+            break
+        run += 1
+        j -= 1
+    if run == 0:
+        return 0
+    return (run + period) // period
+
+
+def _unit_float(value: Any, default: float) -> float:
+    if value is None or isinstance(value, bool):
+        return default
+    try:
+        parsed = float(value)
+    except (TypeError, ValueError):
+        return default
+    return parsed if 0.0 < parsed <= 1.0 else default
+
 
 def _as_bool(value: Any, default: bool) -> bool:
     if value is None:
