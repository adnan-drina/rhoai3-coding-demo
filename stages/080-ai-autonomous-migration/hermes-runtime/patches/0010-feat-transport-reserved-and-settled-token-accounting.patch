+def _longest_request_timeout() -> Optional[float]:
+    """Longest request timeout this process is configured with, in seconds.
+
+    The largest of every ``providers.*.request_timeout_seconds``,
+    ``providers.*.models.*.timeout_seconds`` and ``auxiliary.*.timeout`` in the
+    effective config, and ``HERMES_API_TIMEOUT`` (the request timeout of any
+    model path without a provider-configured one; Hermes' default 1800 s when
+    the ``custom`` provider declares none). None when the config cannot be
+    read. NOTE: for a STREAMED response no client timeout bounds the whole
+    response -- the read timeout and the stale detector bound inactivity only;
+    see the README ("retention").
+    """
+    try:
+        from hermes_cli.config import load_config_readonly
+
+        cfg = load_config_readonly() or {}
+    except Exception:
+        return None
+    values: list[float] = []
+
+    def _num(v):
+        try:
+            f = float(v)
+            return f if f > 0 else None
+        except (TypeError, ValueError):
+            return None
+
+    providers = cfg.get("providers") if isinstance(cfg, dict) else None
+    custom_has_timeout = False
+    if isinstance(providers, dict):
+        for name, prov in providers.items():
+            if not isinstance(prov, dict):
+                continue
+            t = _num(prov.get("request_timeout_seconds"))
+            if t:
+                values.append(t)
+                if name == "custom":
+                    custom_has_timeout = True
+            models = prov.get("models")
+            if isinstance(models, dict):
+                for m in models.values():
+                    if isinstance(m, dict) and _num(m.get("timeout_seconds")):
+                        values.append(_num(m.get("timeout_seconds")))
+    aux = cfg.get("auxiliary") if isinstance(cfg, dict) else None
+    if isinstance(aux, dict):
+        for slot in aux.values():
+            if isinstance(slot, dict) and _num(slot.get("timeout")):
+                values.append(_num(slot.get("timeout")))
+    api_timeout = _num(os.environ.get("HERMES_API_TIMEOUT"))
+    if api_timeout:
+        values.append(api_timeout)
+    elif not custom_has_timeout:
+        values.append(1800.0)
+    return max(values) if values else None
+
