+# ---------------------------------------------------------------------------
+# Token mode: reservations and settlements
+# ---------------------------------------------------------------------------
+
+_rid_counter = itertools.count(1)
+
+
+def _token_state(fh, now: float, window: float, hold: Optional[float] = None, with_open: bool = False):
+    """Reconstruct token state by reservation id from the append-only ledger.
+
+    Returns (settled_in_window: list[(settle_ts, charge)], unsettled_sum,
+    reservations: dict rid -> amount, settled: dict rid -> (charge, ts)) and,
+    with ``with_open``, the open reservations as (reserved_at, amount).
+    An open reservation counts until reserved_at + hold + window.
+    """
+    fh.seek(0)
+    reservations: dict[str, int] = {}
+    reserved_at: dict[str, float] = {}
+    settled: dict[str, tuple[int, float]] = {}
+    for line in fh:
+        parts = line.split()
+        if len(parts) >= 5 and parts[0] == "R":
+            try:
+                reservations[parts[3]] = int(parts[4])
+                reserved_at[parts[3]] = float(parts[1])
+            except ValueError:
+                continue
+        elif len(parts) >= 4 and parts[0] == "S":
+            rid = parts[2]
+            if rid in settled:
+                continue                      # duplicate settlement: first one wins
+            try:
+                settled[rid] = (int(parts[3]), float(parts[1]))
+            except ValueError:
+                continue
+    cutoff = now - window
+    settled_in_window = sorted(
+        (ts, charge) for rid, (charge, ts) in settled.items() if ts > cutoff)
+    # Open reservations count until reserved_at + hold + window (hold >= the
+    # longest request timeout); ``hold`` is None => they never stop counting.
+    open_items = sorted(
+        (reserved_at.get(rid, now), amount) for rid, amount in reservations.items()
+        if rid not in settled and (hold is None or reserved_at.get(rid, now) > cutoff - hold))
+    unsettled_sum = sum(amount for _, amount in open_items)
+    if with_open:
+        return settled_in_window, unsettled_sum, reservations, settled, open_items
+    return settled_in_window, unsettled_sum, reservations, settled
+
+
+def _token_try(cfg: PacerConfig, label: str, take: bool) -> "tuple[bool, Optional[float], Optional[str]]":
+    """Under the ledger lock: reserve C tokens (or just check).
+
+    Returns (ok, next_eligible_at, rid). ``next_eligible_at`` is None when no
+    wake time can be computed (open reservations alone fill the allowance).
+    """
+    fh = _open_locked(cfg.ledger)
+    try:
+        now = _now()
+        settled_in_window, unsettled_sum, _res, _set, open_items = _token_state(
+            fh, now, cfg.window, cfg.hold, with_open=True)
+        used = sum(c for _, c in settled_in_window) + unsettled_sum
+        if used + cfg.reservation <= cfg.budget:
+            rid = None
+            if take:
+                rid = f"{os.getpid()}-{int(now * 1000)}-{next(_rid_counter)}"
+                fh.seek(0, os.SEEK_END)
+                fh.write(f"R {now:.6f} {os.getpid()} {rid} {cfg.reservation} {label}\n")
+                fh.flush()
+                os.fsync(fh.fileno())
+            return True, now, rid
+        # When enough charge expires: settled charges at settle + window, open
+        # reservations at reserved_at + hold + window.
+        need = used + cfg.reservation - cfg.budget
+        expiries = sorted(
+            [(ts + cfg.window, charge) for ts, charge in settled_in_window]
+            + [(ts + cfg.hold + cfg.window, amount) for ts, amount in open_items])
+        freed = 0
+        for when, amount in expiries:
+            freed += amount
+            if freed >= need:
+                return False, when, None
+        return False, None, None
+    finally:
+        try:
+            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
+        finally:
+            fh.close()
+
+
+def _try_admit(cfg: PacerConfig, label: str, take: bool) -> "tuple[bool, Optional[float], Optional[str]]":
+    if cfg.mode == "token":
+        return _token_try(cfg, label, take)
+    ok, next_at = _try_take(cfg, label, take)
+    return ok, next_at, None
+
+
+def capacity_available() -> "tuple[bool, Optional[float]]":
+    """Peek (no slot or reservation taken): (free now, next eligible time)."""
+    cfg = config()
+    if cfg is None:
+        return True, None
+    ok, next_at, _rid = _try_admit(cfg, "peek", False)
+    return ok, (None if ok else next_at)
+
+
+def _usage_total(usage: Any, cfg: PacerConfig) -> "tuple[Optional[int], str]":
+    """Validated prompt+completion total of a provider usage record."""
+    if usage is None:
+        return None, "missing_usage"
+    get = (lambda k: usage.get(k)) if isinstance(usage, dict) else (lambda k: getattr(usage, k, None))
+    prompt, completion, total = get("prompt_tokens"), get("completion_tokens"), get("total_tokens")
+    if not (isinstance(prompt, int) and isinstance(completion, int)) or isinstance(prompt, bool) \
+            or isinstance(completion, bool) or prompt < 0 or completion < 0:
+        return None, "invalid_usage"
+    charge = prompt + completion
+    if total is not None and (not isinstance(total, int) or total != charge):
+        return None, "inconsistent_usage"
+    if charge > cfg.reservation:
+        return None, "usage_above_reservation"
+    return charge, "settled"
+
+
+def settle(rid: Optional[str], usage: Any = None, *, terminal: bool = True) -> Optional[int]:
+    """Settle one reservation exactly once.
+
+    - terminal with valid usage: charge = validated prompt+completion;
+    - terminal with missing/invalid usage: charge = the full reservation;
+    - not terminal (uncertain end): nothing is written; the reservation stays
+      open and keeps counting.
+    Duplicate settlements of a rid are ignored. Returns the charge written.
+    """
+    cfg = config()
+    if cfg is None or cfg.mode != "token" or not rid or not terminal:
+        return None
+    charge, status = _usage_total(usage, cfg)
+    if charge is None:
+        charge = cfg.reservation
+    fh = _open_locked(cfg.ledger)
+    try:
+        now = _now()
+        _siw, _uns, reservations, settled = _token_state(fh, now, cfg.window, cfg.hold)
+        if rid in settled or rid not in reservations:
+            return None
+        fh.seek(0, os.SEEK_END)
+        fh.write(f"S {now:.6f} {rid} {int(charge)} {status}\n")
+        fh.flush()
+        os.fsync(fh.fileno())
+        return int(charge)
+    finally:
+        try:
+            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
+        finally:
+            fh.close()
+
+
