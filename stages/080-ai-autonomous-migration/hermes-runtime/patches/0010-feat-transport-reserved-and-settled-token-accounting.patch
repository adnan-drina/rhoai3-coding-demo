+def _call_attempt(kwargs: dict) -> "tuple[PacedAttempt, bool]":
+    """The attempt this physical call belongs to (tagged by the main loop), or
+    a fresh one for an untagged (auxiliary) call, tagged here so the hook
+    reserves for it."""
+    attempt = attempt_for_kwargs(kwargs)
+    if attempt is not None:
+        return attempt, False
+    cfg = config()
+    attempt = PacedAttempt("call", cfg.max_wait if cfg else DEFAULT_MAX_WAIT_SECONDS,
+                           getattr(_tls, "cancelled", None))
+    with _registry_lock:
+        _registry[attempt.id] = attempt
+    tag_kwargs(kwargs, attempt)
+    return attempt, True
+
+
+def _settle_after_error(rid: Optional[str], exc: BaseException) -> None:
+    # An HTTP error response is a known terminal response without usage:
+    # conservative full charge. Anything else (connection error, cancel,
+    # timeout, refusal before send) is uncertain or unsent: no settlement.
+    if rid and getattr(exc, "status_code", None) is not None:
+        settle(rid, None, terminal=True)
+
+
+class _SettlingStream:
+    """Proxy for a streamed response: settles once at the TERMINAL chunk
+    boundary (StopIteration) to the last usage record seen (cumulative frames
+    are not summed); an interrupted or abandoned stream settles nothing."""
+
+    def __init__(self, inner: Any, rid: str):
+        self._inner = inner
+        self._it = None
+        self._rid = rid
+        self._usage = None
+        self._finished = False    # saw a terminal chunk (finish_reason)
+
+    def __iter__(self):
+        self._it = iter(self._inner)
+        return self
+
+    def __next__(self):
+        if self._it is None:
+            self._it = iter(self._inner)
+        try:
+            chunk = next(self._it)
+        except StopIteration:
+            self._end()
+            raise
+        self._observe(chunk)
+        return chunk
+
+    def _observe(self, chunk) -> None:
+        usage = getattr(chunk, "usage", None)
+        if usage is not None:
+            self._usage = usage
+        for choice in getattr(chunk, "choices", None) or []:
+            if getattr(choice, "finish_reason", None) is not None:
+                self._finished = True
+
+    def _end(self) -> None:
+        # A stream that ended WITHOUT a terminal chunk (dropped by the peer) is
+        # an uncertain end: no settlement, the reservation stays open.
+        if self._finished:
+            settle(self._rid, self._usage, terminal=True)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        close = getattr(self._inner, "close", None)
+        if callable(close):
+            close()
+        return False
+
+    def __getattr__(self, name):
+        return getattr(self._inner, name)
+
+
+class _AsyncSettlingStream(_SettlingStream):
+    def __aiter__(self):
+        self._it = self._inner.__aiter__()
+        return self
+
+    async def __anext__(self):
+        if self._it is None:
+            self._it = self._inner.__aiter__()
+        try:
+            chunk = await self._it.__anext__()
+        except StopAsyncIteration:
+            self._end()
+            raise
+        self._observe(chunk)
+        return chunk
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *exc):
+        close = getattr(self._inner, "close", None)
+        if callable(close):
+            res = close()
+            if hasattr(res, "__await__"):
+                await res
+        return False
+
+
+def _wrap_create(openai_client: Any, is_async: bool) -> None:
+    completions = getattr(getattr(openai_client, "chat", None), "completions", None)
+    create = getattr(completions, "create", None)
+    if create is None or getattr(create, "_rhoai3_settling", False):
+        return
+
+    if not is_async:
+        def settling_create(*args, **kwargs):
+            attempt, ephemeral = _call_attempt(kwargs)
+            attempt.current_rid = None
+            try:
+                try:
+                    result = create(*args, **kwargs)
+                except BaseException as exc:
+                    _settle_after_error(attempt.current_rid, exc)
+                    raise
+                rid = attempt.current_rid
+                if not rid:
+                    return result
+                if kwargs.get("stream"):
+                    return _SettlingStream(result, rid)
+                settle(rid, getattr(result, "usage", None), terminal=True)
+                return result
+            finally:
+                if ephemeral:
+                    attempt.close()
+    else:
+        async def settling_create(*args, **kwargs):
+            attempt, ephemeral = _call_attempt(kwargs)
+            attempt.current_rid = None
+            try:
+                try:
+                    result = await create(*args, **kwargs)
+                except BaseException as exc:
+                    _settle_after_error(attempt.current_rid, exc)
+                    raise
+                rid = attempt.current_rid
+                if not rid:
+                    return result
+                if kwargs.get("stream"):
+                    return _AsyncSettlingStream(result, rid)
+                settle(rid, getattr(result, "usage", None), terminal=True)
+                return result
+            finally:
+                if ephemeral:
+                    attempt.close()
+
+    settling_create._rhoai3_settling = True
+    completions.create = settling_create
