diff --git a/tests/run_agent/test_terminal_foreground_limit_result.py b/tests/run_agent/test_terminal_foreground_limit_result.py
new file mode 100644
index 0000000..085bad9
--- /dev/null
+++ b/tests/run_agent/test_terminal_foreground_limit_result.py
@@ -0,0 +1,132 @@
+"""A terminal call cut at the executor's foreground limit says so (RHOAI3 v32).
+
+v32 M1 capture calls requested ``timeout`` 7170 (a Kanban worker's
+TERMINAL_MAX_FOREGROUND_TIMEOUT lets the terminal tool accept it) and were
+cut by the executor's per-call deadline (420s by default). The result said
+only "timed out after 420.0s". It now states the requested and applied
+limits, that the foreground process was killed, and the background + wait
+route. The limit itself is unchanged.
+"""
+
+import threading
+import time
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent.tool_executor import _tool_timeout_message, execute_tool_calls_sequential
+from run_agent import AIAgent
+from tests.run_agent.test_sequential_tool_timeout import _deterministic_worker_start  # noqa: F401
+
+
+def test_terminal_message_states_the_clamp_the_kill_and_the_background_route():
+    message = _tool_timeout_message("terminal", {"command": "python3 capture.py", "timeout": 7170}, 420.0)
+    assert message.startswith("Error executing tool 'terminal': timed out after 420.0s.")
+    assert "killed at the foreground limit of 420s" in message
+    assert "requested 7170s, applied 420s" in message
+    assert "terminal(background=true" in message and 'process(action="wait"' in message
+
+
+@pytest.mark.parametrize(
+    "args,expected",
+    [
+        ({"command": "x"}, "No timeout was requested; applied 420s."),
+        ({"command": "x", "timeout": "7170"}, "requested 7170s, applied 420s"),
+        ({"command": "x", "timeout": 300}, "Requested timeout 300s, applied 420s."),
+    ],
+)
+def test_terminal_message_variants(args, expected):
+    assert expected in _tool_timeout_message("terminal", args, 420.0)
+
+
+@pytest.mark.parametrize(
+    "name,args",
+    [
+        ("web_extract", {"url": "x"}),
+        ("terminal", {"command": "x", "background": True, "timeout": 7170}),
+    ],
+)
+def test_other_timeouts_keep_the_plain_message(name, args):
+    assert _tool_timeout_message(name, args, 420.0) == f"Error executing tool '{name}': timed out after 420.0s"
+
+
+def _terminal_agent(tmp_path: Path) -> AIAgent:
+    with (
+        patch(
+            "run_agent.get_tool_definitions",
+            return_value=[
+                {
+                    "type": "function",
+                    "function": {
+                        "name": "terminal",
+                        "description": "test terminal",
+                        "parameters": {"type": "object", "properties": {}},
+                    },
+                }
+            ],
+        ),
+        patch("run_agent.check_toolset_requirements", return_value={}),
+        patch("run_agent.OpenAI"),
+        patch("run_agent._hermes_home", tmp_path),
+        patch("agent.model_metadata.fetch_model_metadata", return_value={}),
+    ):
+        agent = AIAgent(
+            api_key="test-key",
+            base_url="https://openrouter.ai/api/v1",
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+        )
+    agent._flush_messages_to_session_db = MagicMock(return_value=True)
+    agent._append_guardrail_observation = MagicMock(side_effect=lambda _name, _args, result, **_kw: result)
+    agent._record_file_mutation_result = MagicMock()
+    agent._subdirectory_hints.check_tool_call = MagicMock(return_value="")
+    agent._tool_result_content_for_active_model = MagicMock(side_effect=lambda _name, result: result)
+    return agent
+
+
+def test_cut_foreground_terminal_call_reports_the_limit_and_is_interrupted(tmp_path, monkeypatch):
+    """The cut interrupts the worker thread (the terminal tool's foreground
+    wait kills its process on that interrupt) and the tool result says so."""
+    from tools.interrupt import is_interrupted
+
+    agent = _terminal_agent(tmp_path)
+    interrupted = threading.Event()
+    release = threading.Event()
+
+    def _dispatch(_name, _args, _task_id, **_kwargs):
+        deadline = time.monotonic() + 10
+        while time.monotonic() < deadline and not release.is_set():
+            if is_interrupted():
+                interrupted.set()
+                return "[Command interrupted]"
+            time.sleep(0.02)
+        return "late"
+
+    call = SimpleNamespace(
+        id="cut",
+        type="function",
+        function=SimpleNamespace(
+            name="terminal",
+            arguments='{"command": "python3 capture-source-scenarios.py --root .", "timeout": 7170}',
+        ),
+    )
+    messages: list[dict] = []
+    monkeypatch.setenv("HERMES_CONCURRENT_TOOL_TIMEOUT_S", "1.0")
+    try:
+        with (
+            patch("run_agent.handle_function_call", side_effect=_dispatch),
+            patch("agent.tool_executor._emit_terminal_post_tool_call"),
+        ):
+            execute_tool_calls_sequential(agent, SimpleNamespace(tool_calls=[call]), messages, "task")
+        assert interrupted.wait(timeout=5)
+    finally:
+        release.set()
+
+    content = messages[0]["content"]
+    assert content.startswith("Error executing tool 'terminal': timed out after 1.0s.")
+    assert "killed at the foreground limit of 1s" in content
+    assert "requested 7170s, applied 1s" in content
+    assert "terminal(background=true" in content and 'process(action="wait"' in content
