+def test_same_call_note_and_escalated_requests_end_to_end(monkeypatch, caplog):
+    poll = {"command": "ls out | wc -l; date"}
+    script = [_tool_response("terminal", poll, f"poll_{i}") for i in range(1, 6)]
+    script += [_tool_response("write_file", {"path": "src/A.java", "content": "x"}, "edit_1"), _text_response()]
+    providers = {"qwen27b": {"models": {"qwen3-6-27b": {"loop_escalation": _block()}}}}
+    agent, fake = _agent(monkeypatch, script, providers=providers, hard_stop=True)
+    clock = iter(range(100))
+
+    def _results(name, args, task_id=None, **_kw):
+        if name == "terminal":
+            return json.dumps({"output": f"94\nFri Oct  2 16:34:{next(clock):02d} UTC 2026\n", "exit_code": 0})
+        return json.dumps({"success": True})
+
+    monkeypatch.setattr("run_agent.handle_function_call", _results)
+    with caplog.at_level(logging.INFO, logger="agent.loop_escalation"):
+        agent.run_conversation("poll it")
+
+    reqs = fake.requests
+    assert len(reqs) == 7
+    assert all(_is_normal(r) for r in reqs[:5])
+    assert _is_escalated(reqs[5])  # after the fifth unchanged poll
+    assert _is_normal(reqs[6])  # the write_file ended it
+    tool_messages = [m for m in reqs[5]["messages"] if isinstance(m, dict) and m.get("role") == "tool"]
+    assert tool_messages[-1]["content"].endswith(
+        "[hermes note: the last 5 terminal calls were the same call with unchanged arguments.]"
+    )
+    assert not any("hermes note" in m["content"] for m in tool_messages[:-1])
+    snap = agent._loop_escalation.snapshot()
+    assert snap["trigger"]["kind"] == "same-call" and snap["last_end_reason"] == "edit"
+    assert any(" trigger=same-call " in r.getMessage() for r in caplog.records)
