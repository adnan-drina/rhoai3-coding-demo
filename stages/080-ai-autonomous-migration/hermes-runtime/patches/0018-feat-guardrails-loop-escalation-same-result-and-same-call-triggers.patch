+    clock = iter(range(100))
+
+    def _results(name, args, task_id=None, **_kw):
+        if name == "terminal":
+            return json.dumps({"output": f"94\nFri Oct  2 16:34:{next(clock):02d} UTC 2026\n", "exit_code": 0})
+        return json.dumps({"success": True})
+
+    monkeypatch.setattr("run_agent.handle_function_call", _results)
+    with caplog.at_level(logging.INFO, logger="agent.loop_escalation"):
+        agent.run_conversation("poll it")
+
+    reqs = fake.requests
+    assert len(reqs) == 7
+    assert all(_is_normal(r) for r in reqs[:5])
+    assert _is_escalated(reqs[5])  # after the fifth unchanged poll
+    assert _is_normal(reqs[6])  # the write_file ended it
+    tool_messages = [m for m in reqs[5]["messages"] if isinstance(m, dict) and m.get("role") == "tool"]
+    assert tool_messages[-1]["content"].endswith(
+        "[hermes note: the last 5 terminal calls were the same call with unchanged arguments.]"
+    )
+    assert not any("hermes note" in m["content"] for m in tool_messages[:-1])
+    snap = agent._loop_escalation.snapshot()
+    assert snap["trigger"]["kind"] == "same-call" and snap["last_end_reason"] == "edit"
+    assert any(" trigger=same-call " in r.getMessage() for r in caplog.records)
+
+
+# ── typed repair ends an escalation (RHOAI3 v32 t_6d0f2b9f) ─────────────
+
+TYPED_REPAIR = "python3 .hermes/skills/migration/typed-repair/scripts/typed-repair.py --root . --card T-7"
+
+
+@pytest.mark.parametrize(
+    "tool,args,expected",
+    [
+        ("terminal", {"command": TYPED_REPAIR}, "typed-repair"),
+        ("terminal", {"command": "cd /projects/modernized && python3 typed-repair.py --plan"}, "typed-repair"),
+        ("terminal", {"command": "cat .hermes/skills/migration/typed-repair/SKILL.md"}, None),
+        ("read_file", {"path": "scripts/typed-repair.py"}, None),
+        # the existing patterns are unchanged
+        ("terminal", {"command": "bash run-verify.sh"}, "verification"),
+        ("terminal", {"command": "sed -i 's/a/b/' src/A.java"}, "edit"),
+        ("write_file", {"path": "x"}, "edit"),
+    ],
+)
+def test_classify_typed_repair(tool, args, expected):
+    assert classify_end_call(tool, args) == expected
+
+
+def test_typed_repair_ends_escalation_end_to_end(monkeypatch, caplog):
+    agent, fake = _agent(
+        monkeypatch,
+        _loop_script([
+            _tool_response("terminal", {"command": "cat pom.xml"}, "read_1"),
+            _tool_response("terminal", {"command": TYPED_REPAIR}, "tr_1"),
+            _text_response(),
+        ]),
+    )
+    with caplog.at_level(logging.INFO, logger="agent.loop_escalation"):
+        agent.run_conversation("fix it")
+    reqs = fake.requests
+    assert _is_escalated(reqs[3]) and _is_escalated(reqs[4]) and _is_normal(reqs[5])
+    snap = agent._loop_escalation.snapshot()
+    assert snap["last_end_reason"] == "typed-repair" and snap["events"][-1] == "end:typed-repair"
+    assert any(r.getMessage().startswith(f"{LOG_PREFIX} end reason=typed-repair") for r in caplog.records)
+
+
+def test_typed_repair_restarts_the_counts():
+    replay = _Replay(_providers())
+    call = ("terminal", {"command": "ls build"})
+    for k in range(4):
+        replay.call(*call, json.dumps({"output": f"{k}", "exit_code": 0}))
+    replay.call("terminal", {"command": TYPED_REPAIR}, json.dumps({"output": "repaired 0", "exit_code": 0}))
+    for k in range(4):
+        replay.call(*call, json.dumps({"output": f"{k}", "exit_code": 0}))
+    assert replay.starts == []
+    replay.call(*call, json.dumps({"output": "4", "exit_code": 0}))
+    assert [kind for _i, _l, kind in replay.starts] == ["same-call"]
+
+
+# ── repeat-read: a cycle of different reads with unchanged results ───────
+
+CASE_C = "v32-q38-t_56432803-runs42-43-brief-sections.jsonl"
+
+
+def _terminal_call_number(run, row):
+    """1-based position of a row among the run's terminal calls (journal 'end' rows)."""
+    ends = [r["row"] for r in _journal(CASE_C) if r["run"] == run and r["phase"] == "end"]
+    return ends.index(row) + 1
+
+
+def test_case_c_run43_repeat_read_fires_at_call_31():
+    """t_56432803 run 43: one brief section per call, then from ~20:47Z the
+    same five sections (items, schema, budget, evidence_rule, stop_rule) with
+    identical results, lap after lap. Consecutive calls differ, so no
+    consecutive trigger fires."""
+    replay = _Replay(_providers(), hard_stop=True).journal(CASE_C, run="43")
+    rows = {r["row"]: r for r in _journal(CASE_C)}
+    index, row, kind = replay.starts[0]
+    assert kind == "repeat-read" and row == 147
+    assert _terminal_call_number("43", 147) == 31
+    # the three exact repeats: items (call 29), schema (30), budget (31)
+    for repeat, first in ((143, 133), (145, 125), (147, 127)):
+        assert rows[repeat]["command"] == rows[first]["command"]
+        assert rows[repeat]["output_sha256"] == rows[first]["output_sha256"]
+    assert replay.results[index].endswith(
+        "[hermes note: 3 of the last 8 terminal calls exactly repeated earlier calls "
+        "(same tool and arguments) and returned byte-identical results.]"
+    )
+    # The next lap after the 8-turn escalation starts it again on the SAME
+    # signature (an overlapping set of repeated pairs).
+    assert [(r, k) for _i, r, k in replay.starts] == [(147, "repeat-read"), (179, "repeat-read")]
+    assert list(replay.escalation.snapshot()["starts_by_signature"].values()) == [2]
+    assert replay.guard_halts == []
+
+
+def test_case_c_run43_third_lap_start_is_the_restart_halt():
+    """Continue run 43's five-section cycle past the copied journal: the third
+    repeat-read start on that signature is the restart-bound halt."""
+    rows = [r for r in _journal(CASE_C) if r["run"] == "43"]
+    lap = [r for r in rows if 143 <= r["row"] <= 151]
+    replay = _Replay(_providers(), hard_stop=True)
+    for row in rows + lap * 4:
+        replay.call(*_journal_call(row), label=row["row"])
+        if replay.halts:
+            break
+    assert [k for _i, _r, k in replay.starts] == ["repeat-read", "repeat-read"]
+    assert replay.halts and replay.halts[0][2].code == RESTART_HALT_CODE
+
+
+def test_case_c_run42_same_result_fires_nine_calls_before_the_halt():
+    """t_56432803 run 42: `tail -N` widenings of one value, the output identical
+    from the 100-line window on; near_duplicate_loop_halt ended the run."""
+    replay = _Replay(_providers(), hard_stop=True).journal(CASE_C, run="42")
+    rows = {r["row"]: r for r in _journal(CASE_C)}
+    _index, row, kind = replay.starts[0]
+    assert kind == "same-result" and row == 65
+    assert len({rows[r]["output_sha256"] for r in (61, 63, 65)}) == 1
+    assert replay.guard_halts and replay.guard_halts[0][1:] == (83, "near_duplicate_loop_halt")
+    assert _terminal_call_number("42", 83) - _terminal_call_number("42", 65) == 9
+
+
+def _section(name, value):
+    return ("terminal", {"command": f"python3 brief.py --section {name}"},
+            json.dumps({"output": f'{{"{name}": "{value}"}}', "exit_code": 0}))
+
+
+def test_repeat_read_after_an_edit_does_not_fire():
+    replay = _Replay(_providers())
+    reads = [_section(n, k) for k, n in enumerate(("items", "schema", "budget"))]
+    for call in reads:
+        replay.call(*call)
+    replay.call("patch", {"path": "src/A.java", "old_string": "a", "new_string": "b"}, json.dumps({"success": True}))
+    for call in reads:
+        replay.call(*call)
+    assert replay.starts == []
+    # control: the same re-reads without the edit fire on the third repeat
+    replay = _Replay(_providers())
+    for call in reads + reads:
+        replay.call(*call)
+    assert [(i, k) for i, _l, k in replay.starts] == [(5, "repeat-read")]
+
+
+def test_repeat_read_needs_the_repeats_inside_the_window():
+    replay = _Replay(_providers())
+    first = [_section(f"s{k}", k) for k in range(3)]
+    for call in first:
+        replay.call(*call)
+    for call in first[:2]:  # two repeats
+        replay.call(*call)
+    for k in range(3, 10):  # seven new reads push them out of the last 8
+        replay.call(*_section(f"s{k}", k))
+    replay.call(*first[2])  # a third repeat, but alone in the window
+    assert replay.starts == []
+
+
+def test_repeat_read_counts_only_identical_results():
+    replay = _Replay(_providers())
+    for lap in range(3):
+        for k in range(3):
+            replay.call(*_section(f"s{k}", f"{lap}{k}"))  # same calls, results change
+    assert replay.starts == []
+
+
+def test_repeat_read_absent_keys_mean_off():
+    providers = _providers(repeat_read_count=None, repeat_read_window=None)
+    replay = _Replay(providers).journal(CASE_C, run="43")
+    assert all(k != "repeat-read" for _i, _r, k in replay.starts)
+    cfg = LoopEscalationConfig.from_mapping(_block(repeat_read_window=None))
+    assert (cfg.repeat_read_count, cfg.repeat_read_window) == (3, 8)
+    cfg = LoopEscalationConfig.from_mapping(_block(repeat_read_count=None))
+    assert (cfg.repeat_read_count, cfg.repeat_read_window) == (0, 0)
+
+
+def test_repeat_read_log_line(caplog):
+    with caplog.at_level(logging.INFO, logger="agent.loop_escalation"):
+        _Replay(_providers()).journal(CASE_C, run="43")
+    starts = [r.getMessage() for r in caplog.records if r.getMessage().startswith(f"{LOG_PREFIX} start ")]
+    assert starts and " trigger=repeat-read " in starts[0]
