+def _optional_count(data: Mapping, key: str, minimum: int) -> int:
+    """A positive threshold, or 0 (off) when absent, malformed or below ``minimum``."""
+    value = data.get(key)
+    if value is None or isinstance(value, bool):
+        return 0
+    try:
+        value = int(value)
+    except (TypeError, ValueError):
+        return 0
+    return value if value >= minimum else 0
 
 
