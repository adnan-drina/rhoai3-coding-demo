+"""Loop escalation start triggers beyond the identical-call note (RHOAI3 v32).
+
+Two loops on Qwen 3.8 never produced the identical-call note, so they never
+escalated:
+
+* A (t_449a35e4 run 1): the same ``ls | wc -l; date; ps aux`` poll hundreds
+  of times; the results differed only by the clock line.
+* B (t_2f2509aa run 30): one pipeline varying only ``tail -c N``; every
+  result had the same output_sha256.
+
+``same_call_count`` (5 consecutive calls with identical arguments) covers A;
+``same_result_count`` (3 consecutive near-duplicate calls with a
+byte-identical result) covers B; ``max_starts_per_signature`` bounds the
+restarts. The fixtures under tests/fixtures/loop_escalation are the relevant
+rows of the runs' kanban exec journals. A journal keeps an 800-character
+output tail and the sha256 of the full output, so a replayed result is the
+terminal envelope whose output is one line naming that sha256 followed by
+the tail: two replayed results are identical exactly when the run's outputs
+were.
+"""
+
+import copy
+import json
+import logging
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from agent.loop_escalation import (
+    LOG_PREFIX,
+    RESTART_HALT_CODE,
+    LoopEscalation,
+    LoopEscalationConfig,
+)
+from agent.tool_guardrails import ToolCallGuardrailConfig, ToolCallGuardrailController
+from run_agent import AIAgent
+from tests.agent.test_loop_escalation import (
+    ESCALATION_BODY,
+    _agent,
+    _is_escalated,
+    _is_normal,
+    _text_response,
+    _tool_response,
+)
+
+FIXTURES = Path(__file__).resolve().parents[1] / "fixtures" / "loop_escalation"
+CASE_A = "v32-q38-t_449a35e4-run1-poll.jsonl"
+CASE_B = "v32-q38-t_2f2509aa-run30-tail-c.jsonl"
+CASE_Q36 = "v32-q36-t_9dc305ef-run1-capture.jsonl"
+PROVIDER = "qwen38"
+MODEL = "qwen3-8-27b-int4"
+
+
+def _block(**overrides):
+    block = {
+        "enabled": True,
+        "max_turns": 8,
+        "request_body": copy.deepcopy(ESCALATION_BODY),
+        "same_result_count": 3,
+        "same_call_count": 5,
+        "max_starts_per_signature": 2,
+    }
+    block.update(overrides)
+    return {k: v for k, v in block.items() if v is not None}
+
+
+def _providers(**overrides):
+    return {PROVIDER: {"models": {MODEL: {"loop_escalation": _block(**overrides)}}}}
+
+
+# ── replay of executed calls through the runtime's observation glue ──────
+
+
+def _journal(name):
+    return [json.loads(line) for line in (FIXTURES / name).read_text().splitlines() if line.strip()]
+
+
+def _journal_call(row):
+    """(tool, args, result) of one journal row."""
+    if row["phase"] == "mutation":
+        return row["tool"], {"path": row.get("path", "")}, json.dumps({"success": True})
+    tail = row.get("output_tail", "")
+    args = {"command": row["command"]}
+    if tail.startswith("Background process started"):
+        args["background"] = True  # the terminal tool's reply to background=true
+    if row.get("exit_code") is None:
+        return "terminal", args, tail  # the executor's own error string
+    output = f"journal output_sha256={row.get('output_sha256', '-')}\n{tail}"
+    return "terminal", args, json.dumps({"output": output, "exit_code": row["exit_code"], "error": None})
+
+
+class _Replay:
+    """Feeds executed calls through AIAgent._observe_loop_escalation exactly as
+    _append_guardrail_observation does: one model request per call."""
+
+    def __init__(self, providers, *, hard_stop=False):
+        self.agent = SimpleNamespace(
+            _tool_guardrails=ToolCallGuardrailController(
+                ToolCallGuardrailConfig(hard_stop_enabled=hard_stop)
+            ),
+            _loop_escalation=LoopEscalation(providers, PROVIDER),
+            _tool_guardrail_halt_decision=None,
+            provider=f"custom:{PROVIDER}",
+            model=MODEL,
+        )
+        self.starts = []  # (index, label, trigger kind)
+        self.halts = []  # (index, label, decision)
+        self.results = []
+
+    @property
+    def escalation(self):
+        return self.agent._loop_escalation
+
+    def call(self, tool, args, result, label=None):
+        index = len(self.results)
+        self.escalation.begin_request()
+        controller = self.agent._tool_guardrails
+        controller.after_call(tool, args, result, failed=False)
+        notice = controller.observe_call(tool, args, result).notice
+        shown = result + ("\n\n" + notice if notice else "")
+        before = self.escalation.started
+        shown = AIAgent._observe_loop_escalation(
+            self.agent, tool, args, notice, raw_result=result, function_result=shown
+        )
+        self.results.append(shown)
+        if self.escalation.started > before:
+            self.starts.append((index, label, self.escalation.trigger["kind"]))
+        if self.agent._tool_guardrail_halt_decision is not None and not self.halts:
+            self.halts.append((index, label, self.agent._tool_guardrail_halt_decision))
+        return shown
+
+    def journal(self, name, after=None):
+        for row in _journal(name):
+            tool, args, result = _journal_call(row)
+            self.call(tool, args, result, label=row["row"])
+            if after:
+                for extra in after(row, tool, args):
+                    self.call(*extra, label=f"{row['row']}+")
+            if self.halts:
+                break
+        return self
+
+
+def _process_wait(row, tool, args):
+    """The journal records terminal calls only: a background launch is
+    followed by the worker's process wait."""
+    if tool == "terminal" and args.get("background"):
+        yield ("process", {"action": "wait", "session_id": "proc_1", "timeout": 400},
+               json.dumps({"status": "running", "output": ""}))
+
+
+# ── case A: the M1 poll ──────────────────────────────────────────────────
+
+
+def test_case_a_same_call_fires_on_the_fifth_unchanged_poll():
+    replay = _Replay(_providers()).journal(CASE_A)
+    rows = _journal(CASE_A)
+    assert rows[0]["row"] == 146 and "16:32:26" in rows[0]["output_tail"]
+    first_index, first_row, kind = replay.starts[0]
+    assert kind == "same-call"
+    # Row 176 (16:34:57Z): the fifth consecutive poll with unchanged arguments.
+    # Polls since 16:32:26Z were interrupted by sleep-prefixed variants
+    # (16:33:04, 16:34:38) and four diagnostic commands, so it is call 16 of
+    # the fixture and poll 9 of the unchanged poll (first issued 16:33:27Z).
+    assert first_row == 176 and "16:34:57" in rows[first_index]["output_tail"]
+    assert first_index == 15
+    unchanged = [r["row"] for r in rows if r.get("command") == rows[first_index]["command"]]
+    assert unchanged[0] == 160 and unchanged.index(176) == 7
+    calls_from_unchanged_start = (176 - 160) // 2 + 1
+    assert calls_from_unchanged_start == 9 <= 10
+    assert replay.results[first_index].endswith(
+        "[hermes note: the last 5 terminal calls were the same call with unchanged arguments.]"
+    )
+    # The results differed: the identical-call note never fired.
+    assert "consecutive identical call" not in "".join(replay.results)
+
+
+def test_case_a_restart_bound_halts_the_third_start():
+    replay = _Replay(_providers()).journal(CASE_A)
+    assert [(row, kind) for _i, row, kind in replay.starts] == [
+        (176, "same-call"),
+        (202, "same-call"),  # 8 escalated turns end on the cap, then 5 more polls
+    ]
+    assert len(replay.halts) == 1
+    _index, row, decision = replay.halts[0]
+    assert row == 228 and decision.code == RESTART_HALT_CODE and decision.count == 3
+    assert decision.should_halt and decision.tool_name == "terminal"
+    assert replay.results[-1].rstrip().endswith("Nothing on disk was changed by this stop.]")
+    assert replay.escalation.snapshot()["starts_by_signature"] == {
+        replay.escalation.trigger["signature"]: 2
+    }
+
+
+# ── case B: tail -c doubling ─────────────────────────────────────────────
+
+
+def test_case_b_same_result_fires_by_the_third_tail_c_call():
+    replay = _Replay(_providers()).journal(CASE_B)
+    rows = {r["row"]: r for r in _journal(CASE_B)}
+    index, row, kind = replay.starts[0]
+    assert kind == "same-result" and row == 80
+    loop = [rows[r] for r in (76, 78, 80)]
+    assert all("tail -c" in r["command"] for r in loop)
+    assert len({r["output_sha256"] for r in loop}) == 1
+    assert len({r["command"] for r in loop}) == 3  # the arguments changed every time
+    assert replay.results[index].endswith(
+        "[hermes note: the last 3 terminal calls were near-duplicates of each other "
+        "and returned byte-identical results.]"
+    )
+    # The bisection before it (rows 30-74: near-duplicates whose results all
+    # differed) started nothing.
+    assert all(r >= 80 for _i, r, _k in replay.starts)
+
+
+def test_case_b_start_log_line_names_the_trigger(caplog):
+    with caplog.at_level(logging.INFO, logger="agent.loop_escalation"):
+        _Replay(_providers()).journal(CASE_B)
+    starts = [r.getMessage() for r in caplog.records if r.getMessage().startswith(f"{LOG_PREFIX} start ")]
+    assert starts and "tool=terminal" in starts[0] and " trigger=same-result " in starts[0]
+
+
+# ── must not fire ───────────────────────────────────────────────────────
+
+
+def test_q36_m1_capture_sequence_does_not_fire():
+    """Qwen 3.6 M1: two capture calls cut at the foreground limit, then a
+    background launch and a wait."""
+    replay = _Replay(_providers(), hard_stop=True).journal(CASE_Q36, after=_process_wait)
+    assert replay.starts == [] and replay.halts == []
+    rows = {r["row"]: r for r in _journal(CASE_Q36)}
+    cut = [rows[57], rows[67]]
+    assert all("timed out after 420.0s" in r["output_tail"] for r in cut)
+    assert rows[69]["output_tail"].startswith("Background process started")
+
+
+def test_two_cut_captures_then_background_launch_and_wait_do_not_fire():
+    rows = {r["row"]: r for r in _journal(CASE_Q36)}
+    replay = _Replay(_providers(), hard_stop=True)
+    for row in (rows[57], rows[67], rows[69]):
+        tool, args, result = _journal_call(row)
+        replay.call(tool, args, result, label=row["row"])
+        for extra in _process_wait(row, tool, args):
+            replay.call(*extra)
+    assert replay.starts == [] and replay.halts == []
+
+
+def test_process_polls_never_fire():
+    replay = _Replay(_providers())
+    poll = ("process", {"action": "poll", "session_id": "proc_1"}, json.dumps({"status": "running"}))
+    for _ in range(12):
+        replay.call(*poll)
+    assert replay.starts == []
+    # A poller neither counts nor breaks a run of unchanged calls.
+    same = ("terminal", {"command": "ls build | wc -l"}, json.dumps({"output": "3", "exit_code": 0}))
+    replay = _Replay(_providers(same_result_count=None))
+    for k in range(4):
+        replay.call(same[0], same[1], json.dumps({"output": f"{k}", "exit_code": 0}))
+        replay.call(*poll)
+    assert replay.starts == []
+    replay.call(same[0], same[1], json.dumps({"output": "9", "exit_code": 0}))
+    assert [kind for _i, _l, kind in replay.starts] == ["same-call"]
+
+
+def test_near_duplicates_with_differing_results_do_not_fire():
+    replay = _Replay(_providers())
+    for n in (100, 200, 400, 800, 1600):
+        replay.call("terminal", {"command": f"cat out.json | tail -c {n}"},
+                    json.dumps({"output": "x" * n, "exit_code": 0}))
+    assert replay.starts == []
+
+
+def _paging_cases():
+    """The paging cases of patch 0015's tests (test_tool_guardrails_near_duplicate)."""
+    def term(command, output):
+        return ("terminal", {"command": command}, json.dumps({"output": output, "exit_code": 0, "error": None}))
+
+    records = [f'"detail": "cannot find symbol DataAccessException", "id": "err:{i:04x}", "line": {i}' for i in range(2000)]
+    dao = [term(f'python3 brief.py --section items | grep -A{30 * k} "EmptyResultDataAccessException"',
+                "\n".join(records[:30 * k])) for k in range(1, 30)]
+    base = [f"artifact field {i}" for i in range(35)]
+    artifacts = [term(f"sed -n '{k + 1},{k + 36}p' artifacts.txt",
+                      "\n".join(base + [f"artifact {k} sha256={'%064x' % (0xabc123 + k * 7919)}"]))
+                 for k in range(25)]
+    rows = [f"[ERROR] src/main/java/a/S{i}.java:[{i},8] cannot find symbol" for i in range(60)]
+    diagnostics = [term(f"python3 brief.py --section items | head -{20 + k}", "\n".join(rows[:20 + k]))
+                   for k in range(40)]
+    return {"dao-growing-pages": dao, "distinct-artifact-ids": artifacts, "one-new-diagnostic-per-page": diagnostics}
+
+
+@pytest.mark.parametrize("case", sorted(_paging_cases()))
+def test_paging_cases_of_patch_0015_do_not_fire(case):
+    replay = _Replay(_providers())
+    for call in _paging_cases()[case]:
+        replay.call(*call)
+    assert replay.starts == [] and replay.halts == []
+
+
+def test_an_edit_restarts_the_count():
+    replay = _Replay(_providers())
+    call = ("terminal", {"command": "ls build"})
+    for k in range(3):
+        replay.call(*call, json.dumps({"output": f"{k}", "exit_code": 0}))
+    replay.call("write_file", {"path": "src/A.java", "content": "x"}, json.dumps({"success": True}))
+    for k in range(4):
+        replay.call(*call, json.dumps({"output": f"{k}", "exit_code": 0}))
+    assert replay.starts == []
+    replay.call(*call, json.dumps({"output": "4", "exit_code": 0}))
+    assert [kind for _i, _l, kind in replay.starts] == ["same-call"]
+
+
+# ── absent keys: today's behaviour ──────────────────────────────────────
+
+
+@pytest.mark.parametrize("case", [CASE_A, CASE_B])
+def test_absent_keys_mean_the_identical_trigger_only(case):
+    providers = _providers(same_result_count=None, same_call_count=None, max_starts_per_signature=None)
+    replay = _Replay(providers).journal(case)
+    assert replay.starts == [] and replay.halts == []
+
+
+def test_identical_trigger_unchanged_and_named_in_the_log(caplog):
+    le = LoopEscalation({"p": {"loop_escalation": _block(same_result_count=None, same_call_count=None,
+                                                          max_starts_per_signature=None)}})
+    with caplog.at_level(logging.INFO, logger="agent.loop_escalation"):
+        outcome = le.on_tool_result("terminal", {"command": "ls"}, third_note=True, provider="custom:p")
+    assert le.active and le.trigger["kind"] == "identical" and outcome.note == "" and outcome.halt is None
+    assert any(" trigger=identical " in r.getMessage() for r in caplog.records)
+
+
+def test_identical_trigger_counts_toward_the_restart_bound():
+    le = LoopEscalation({"p": {"loop_escalation": _block(max_turns=1)}})
+    for expected in (1, 2):
+        le.on_tool_result("terminal", {"command": "ls"}, third_note=True, provider="custom:p")
+        assert le.active and le.started == expected
+        le.end("cap")
+    outcome = le.on_tool_result("terminal", {"command": "ls"}, third_note=True, provider="custom:p")
+    assert not le.active and outcome.halt is not None and outcome.halt.code == RESTART_HALT_CODE
+
+
+def test_config_keys():
+    cfg = LoopEscalationConfig.from_mapping(_block())
+    assert (cfg.same_result_count, cfg.same_call_count, cfg.max_starts_per_signature) == (3, 5, 2)
+    absent = LoopEscalationConfig.from_mapping(
+        _block(same_result_count=None, same_call_count=None, max_starts_per_signature=None)
+    )
+    assert (absent.same_result_count, absent.same_call_count, absent.max_starts_per_signature) == (0, 0, 0)
+    bad = LoopEscalationConfig.from_mapping(
+        _block(same_result_count=1, same_call_count="x", max_starts_per_signature=True)
+    )
+    assert (bad.same_result_count, bad.same_call_count, bad.max_starts_per_signature) == (0, 0, 0)
