+# ---------------------------------------------------------------------------
+# RHOAI3: local request-allowance deferral (V15-1)
+# ---------------------------------------------------------------------------
+# A worker that stops because the run's local request allowance is full writes
+# a ``local_budget_deferral`` event bound to its run before exiting with
+# KANBAN_RATE_LIMIT_EXIT_CODE. The reaper then ends that run with the neutral
+# ``rate_limited`` outcome (no _record_task_failure), even if the exit status
+# was lost (dispatcher restart), and the respawn guard holds the same card
+# until ``retry_not_before`` and a free slot in the shared ledger.
+
+LOCAL_BUDGET_DEFERRAL_EVENT = "local_budget_deferral"
+
+
+def record_local_budget_deferral(conn, task_id: str, run_id: int, deferral: dict) -> None:
+    """Persist one deferral record for (task, worker run); idempotent."""
+    with write_txn(conn):
+        exists = conn.execute(
+            "SELECT 1 FROM task_events WHERE task_id = ? AND run_id = ? AND kind = ?",
+            (task_id, int(run_id), LOCAL_BUDGET_DEFERRAL_EVENT),
+        ).fetchone()
+        if exists:
+            return
+        payload = {k: v for k, v in dict(deferral).items() if k not in ("messages",)}
+        _append_event(conn, task_id, LOCAL_BUDGET_DEFERRAL_EVENT, payload, run_id=int(run_id))
+
+
+def _local_deferral_for_run(conn, task_id: str, run_id) -> Optional[dict]:
+    if run_id is None:
+        return None
+    row = conn.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND run_id = ? AND kind = ? "
+        "ORDER BY id DESC LIMIT 1",
+        (task_id, int(run_id), LOCAL_BUDGET_DEFERRAL_EVENT),
+    ).fetchone()
+    try:
+        payload = json.loads(row["payload"]) if row and row["payload"] else None
+    except (TypeError, ValueError):
+        payload = None
+    return payload if isinstance(payload, dict) else None
+
+
+def _request_capacity() -> "tuple[bool, Optional[float]]":
+    """Whether the run's shared request ledger has a free slot now (peek, no
+    slot taken), and the next slot time when it has not. No pacer => free."""
+    try:
+        from agent import request_pacer
+    except Exception:
+        return True, None
+    cfg = request_pacer.config()
+    if cfg is None:
+        return True, None
+    ok, next_at = request_pacer._try_take(cfg, "dispatcher-peek", False)
+    return ok, (None if ok else next_at)
+
+
