+# Exit code a dispatcher-owned kanban worker must leave with (None = default).
+_kanban_exit_code: "int | None" = None
+
+
+def kanban_worker_exit_code() -> "int | None":
+    """Exit code requested by a kanban turn stop (``KANBAN_RATE_LIMIT_EXIT_CODE``
+    after a local budget deferral), or None."""
+    return _kanban_exit_code
+
+
+def _record_kanban_local_deferral(
+    kanban_task: str,
+    deferral: dict,
+    reason: str,
+    logger: logging.Logger,
+) -> bool:
+    """Persist a local request-allowance deferral for this worker run.
+
+    Written while the task is still ``running`` and before the process exits,
+    so the dispatcher can classify the ended run as the neutral
+    ``rate_limited`` outcome even after its own restart. The task, claim and
+    counters are not touched here; the native reaper does the requeue.
+    """
+    global _kanban_exit_code
+    try:
+        from agent.delegation_context import is_dispatcher_owned_worker_context
+
+        if not is_dispatcher_owned_worker_context():
+            return False
+        from hermes_cli import kanban_db as _kb
+
+        _conn = _kb.connect()
+        try:
+            row = _conn.execute(
+                "SELECT status, current_run_id FROM tasks WHERE id = ?",
+                (kanban_task,),
+            ).fetchone()
+            if row is None or row["status"] != "running":
+                return False
+            expected_run = (os.environ.get("HERMES_KANBAN_RUN_ID") or "").strip()
+            if expected_run and str(row["current_run_id"]) != expected_run:
+                return False
+            _kb.record_local_budget_deferral(
+                _conn, kanban_task, int(row["current_run_id"]),
+                {**deferral, "reason": reason},
+            )
+        finally:
+            try:
+                _conn.close()
+            except Exception:
+                pass
+        _kanban_exit_code = _kb.KANBAN_RATE_LIMIT_EXIT_CODE
+        return True
+    except Exception:
+        logger.warning("Failed to record local budget deferral for task %s", kanban_task, exc_info=True)
+        return False
+
