+def _observe_refusal(agent, function_name, function_args, block_message, result):
+    """Feed a pre-execution refusal to the tool-loop guardrails (RHOAI3 V16-9).
+
+    A refused call never reaches ``_append_guardrail_observation``; without
+    this, an identical call refused hundreds of times is never halted.
+    """
+    try:
+        from agent.tool_guardrails import (
+            ToolCallGuardrailController,
+            append_toolguard_guidance,
+        )
+
+        controller = getattr(agent, "_tool_guardrails", None)
+        if not isinstance(controller, ToolCallGuardrailController):
+            return result
+        decision = controller.after_refusal(function_name, function_args, str(block_message))
+        if decision.should_halt:
+            setter = getattr(type(agent), "_set_tool_guardrail_halt", None)
+            if callable(setter):
+                setter(agent, decision)
+            result = append_toolguard_guidance(result, decision)
+    except Exception:
+        logger.debug("refusal guardrail observation failed", exc_info=True)
+    return result
+
