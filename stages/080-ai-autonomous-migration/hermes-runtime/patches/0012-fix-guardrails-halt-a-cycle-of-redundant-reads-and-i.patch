+    def _new_phase(self) -> None:
+        """An evidence-changing call: reads before it prove nothing about after."""
+        self._read_families.clear()
+        self._phase_seen.clear()
+        self._redundant_reads.clear()
+        self._read_descriptions.clear()
+
+    def _observe_read_cycle(
+        self,
+        tool_name: str,
+        args: Mapping[str, Any],
+        result: str | None,
+        description: str,
+    ) -> ToolGuardrailDecision | None:
+        """Bounded cycle guard over read-only calls (RHOAI3 V16-7).
+
+        A read is new when it shows an output line no read has shown since the
+        last evidence-changing call; any new read clears the history. Reads
+        that show nothing new are kept by their exact identity (tool, workdir,
+        canonical arguments -- nothing is normalised). When the trailing
+        ``READ_CYCLE_ROUNDS * L`` of them consist of exactly ``L`` distinct
+        calls (2 <= L <= ``READ_CYCLE_MAX_LENGTH``), each made
+        ``READ_CYCLE_ROUNDS`` times, in any order, the model is cycling over
+        the same set of reads and the turn halts, naming the cycle.
+        A single call repeated is left to the identical-call guard (L >= 2).
+        """
+        key = ToolCallSignature.from_call(tool_name, args).args_hash + ":" + tool_name
+        new = False
+        for line in _result_content_lines(result):
+            digest = hashlib.sha256(line.encode("utf-8", "surrogatepass")).digest()[:16]
+            if digest not in self._phase_seen:
+                self._phase_seen.add(digest)
+                new = True
+        if new:
+            self._redundant_reads.clear()
+            return None
+        self._read_descriptions.setdefault(key, description)
+        self._redundant_reads.append(key)
+        cap = READ_CYCLE_ROUNDS * READ_CYCLE_MAX_LENGTH
+        if len(self._redundant_reads) > cap:
+            del self._redundant_reads[:-cap]
+        if not self.config.hard_stop_enabled or self._halt_decision is not None:
+            return None
+        history = self._redundant_reads
+        for length in range(2, READ_CYCLE_MAX_LENGTH + 1):
+            span = READ_CYCLE_ROUNDS * length
+            if len(history) < span:
+                break
+            tail = history[-span:]
+            counts: dict[str, int] = {}
+            for k in tail:
+                counts[k] = counts.get(k, 0) + 1
+            if len(counts) != length or any(c != READ_CYCLE_ROUNDS for c in counts.values()):
+                continue
+            members = list(dict.fromkeys(tail))
+            shown = "; ".join(self._read_descriptions.get(k, "?") for k in members[:4])
+            more = f"; and {len(members) - 4} more" if len(members) > 4 else ""
+            cycle = f"{length} read-only calls: {shown}{more}"
+            decision = ToolGuardrailDecision(
+                action="halt",
+                code=READ_CYCLE_HALT_CODE,
+                message=(
+                    f"Stopped {tool_name}: the same {length} read-only calls were repeated "
+                    f"{READ_CYCLE_ROUNDS} more times with no new output line and no change "
+                    f"in between ({cycle}). Nothing on disk was changed by this stop: the "
+                    "working tree and any retained candidate stay as they are. Use the "
+                    "content already shown, make the change, or end the run with the "
+                    "card's stated terminator."
+                ),
+                tool_name=tool_name,
+                count=READ_CYCLE_ROUNDS,
+                signature=ToolCallSignature(
+                    tool_name=tool_name, args_hash=_sha256(json.dumps(sorted(members)))
+                ),
+                family=cycle,
+            )
+            self._halt_decision = decision
+            return decision
+        return None
+
+    def after_refusal(
+        self,
+        tool_name: str,
+        args: Mapping[str, Any] | None,
+        refusal: str,
+    ) -> ToolGuardrailDecision:
+        """Count a call refused before execution (a pre_tool_call hook or
+        scope denial) (RHOAI3 V16-9).
+
+        A refusal is a failed call of that tool: it feeds the exact-failure
+        and same-tool-failure counts like an executed failure. Consecutive
+        refusals of the identical call with the identical refusal text halt
+        at ``REFUSED_CALL_HALT_AFTER`` (hard stops only), naming the tool and
+        the refusal. Executed calls keep their own thresholds.
+        """
+        args = _coerce_args(args)
+        signature = ToolCallSignature.from_call(tool_name, args)
+        text = str(refusal or "")
+        if self._refusal_sig == signature and self._refusal_text == text:
+            self._refusal_count += 1
+        else:
+            self._refusal_sig = signature
+            self._refusal_text = text
+            self._refusal_count = 1
+        # The identical-call streak (executed calls) is broken by a refusal.
+        self._identical_streak_sig = None
+        self._identical_streak_count = 0
+        self._exact_failure_counts[signature] = self._exact_failure_counts.get(signature, 0) + 1
+        same_count = self._same_tool_failure_counts.get(tool_name, 0) + 1
+        self._same_tool_failure_counts[tool_name] = same_count
+        if not self.config.hard_stop_enabled or self._halt_decision is not None:
+            return ToolGuardrailDecision(tool_name=tool_name, count=self._refusal_count, signature=signature)
+        if self._refusal_count >= REFUSED_CALL_HALT_AFTER:
+            decision = ToolGuardrailDecision(
+                action="halt",
+                code=REFUSED_CALL_HALT_CODE,
+                message=(
+                    f"Stopped {tool_name}: the identical call was refused before execution "
+                    f"{self._refusal_count} times in a row with the same refusal: "
+                    f"{text[:300]}. Repeating it cannot succeed; change the call or end "
+                    "the run with the card's stated terminator."
+                ),
+                tool_name=tool_name,
+                count=self._refusal_count,
+                signature=signature,
+                family=f"{tool_name} refused: {text[:200]}",
+            )
+            self._halt_decision = decision
+            return decision
+        if same_count >= self.config.same_tool_failure_halt_after:
+            decision = ToolGuardrailDecision(
+                action="halt",
+                code="same_tool_failure_halt",
+                message=(
+                    f"Stopped {tool_name}: it failed {same_count} times this turn "
+                    f"(the last was refused before execution: {text[:200]}). "
+                    "Stop retrying the same failing tool path and choose a different approach."
+                ),
+                tool_name=tool_name,
+                count=same_count,
+                signature=signature,
+            )
+            self._halt_decision = decision
+            return decision
+        return ToolGuardrailDecision(tool_name=tool_name, count=self._refusal_count, signature=signature)
+
     def _is_idempotent(self, tool_name: str) -> bool:
         if tool_name in self.config.mutating_tools:
             return False
