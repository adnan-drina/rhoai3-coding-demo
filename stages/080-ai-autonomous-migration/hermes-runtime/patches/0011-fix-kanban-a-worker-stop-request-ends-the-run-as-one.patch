--- /dev/null
+++ b/agent/kanban_stop_request.py
@@ -0,0 +1,152 @@
+"""Worker stop requests: a documented signal that ends a kanban worker's run.
+
+A dispatcher-spawned worker gets ``HERMES_KANBAN_STOP_REQUEST`` in its
+environment: a per-run file path (``<board>/stop-requests/<task>.run<id>.json``)
+that does not exist when the run starts. A tool the worker runs (a skill
+script, a verification step) may create it to say that this run's work phase
+is over and the card needs something only a human or another actor can
+supply::
+
+    {"kind": "needs_input", "reason": "VERIFICATION_PENDING c:488e7e2d ..."}
+
+``kind`` is ``needs_input`` (default) or ``capability``; ``reason`` is required
+and is what the board shows. An optional ``task`` must equal the worker's task.
+
+After every tool result the runtime checks the file. When it is present and
+valid, the runtime blocks the task natively (``kanban_db.block_task`` with that
+kind, bound to this run) exactly once, refuses any further tool call in the
+batch, and ends the turn without another model request. The candidate and
+every file on disk stay as they are. The card stays ``blocked`` until an
+``unblock``; the resumed run gets a new run id and therefore a new, absent
+request path, so a request from an earlier run can never stop a later one.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+from dataclasses import dataclass, field
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+ENV_VAR = "HERMES_KANBAN_STOP_REQUEST"
+_ALLOWED_KINDS = ("needs_input", "capability")
+_MAX_REASON = 2000
+_MAX_BYTES = 64 * 1024
+
+
+@dataclass
+class StopRequest:
+    path: str
+    kind: str
+    reason: str
+    raw: dict = field(default_factory=dict)
+    error: str = ""  # set when the file exists but is not a valid request
+
+    @property
+    def valid(self) -> bool:
+        return not self.error
+
+
+def request_path() -> str:
+    return (os.environ.get(ENV_VAR) or "").strip()
+
+
+def read_stop_request() -> StopRequest | None:
+    """Return the pending stop request for this worker run, or None.
+
+    A file that exists but is malformed still stops the run (it was meant to),
+    with ``needs_input`` and a reason that says the request was unreadable.
+    """
+    path = request_path()
+    if not path or not os.environ.get("HERMES_KANBAN_TASK"):
+        return None
+    try:
+        if not os.path.isfile(path):
+            return None
+        with open(path, "rb") as fh:
+            data = fh.read(_MAX_BYTES + 1)
+    except OSError:
+        return None
+    task = (os.environ.get("HERMES_KANBAN_TASK") or "").strip()
+    try:
+        raw: Any = json.loads(data[:_MAX_BYTES].decode("utf-8", "replace"))
+    except ValueError:
+        raw = None
+    if not isinstance(raw, dict):
+        return StopRequest(path, "needs_input",
+                           f"STOP WORKER_STOP_REQUEST: unreadable request at {path}",
+                           {}, error="unreadable")
+    other_task = raw.get("task")
+    if other_task not in (None, "") and str(other_task) != task:
+        # Addressed to another card: not ours to honour.
+        return None
+    kind = str(raw.get("kind") or "needs_input")
+    if kind not in _ALLOWED_KINDS:
+        kind = "needs_input"
+    reason = str(raw.get("reason") or "").strip()
+    if not reason:
+        return StopRequest(path, kind,
+                           f"STOP WORKER_STOP_REQUEST: request without a reason at {path}",
+                           raw, error="no-reason")
+    if len(reason) > _MAX_REASON:
+        reason = reason[:_MAX_REASON] + " …"
+    return StopRequest(path, kind, reason, raw)
+
+
+def honour_stop_request(req: StopRequest) -> str:
+    """Block this worker's task natively for ``req``; return what happened.
+
+    ``blocked``   the block was recorded for this run (the one native block);
+    ``not-live``  the task is no longer running under this run (already
+                  blocked, completed or reclaimed): nothing recorded again;
+    ``error``     the board could not be written; the caller still ends the
+                  turn and the finaliser records the stop as a failed run.
+    """
+    task = (os.environ.get("HERMES_KANBAN_TASK") or "").strip()
+    try:
+        from agent.delegation_context import is_dispatcher_owned_worker_context
+
+        if not task or not is_dispatcher_owned_worker_context():
+            return "not-live"
+        from hermes_cli import kanban_db as kb
+
+        conn = kb.connect()
+        try:
+            row = conn.execute(
+                "SELECT status, current_run_id FROM tasks WHERE id = ?", (task,)
+            ).fetchone()
+            if row is None or row["status"] != "running":
+                return "not-live"
+            expected = (os.environ.get("HERMES_KANBAN_RUN_ID") or "").strip()
+            run_id = row["current_run_id"]
+            if expected and str(run_id) != expected:
+                return "not-live"
+            ok = kb.block_task(
+                conn, task, reason=req.reason, kind=req.kind,
+                expected_run_id=int(run_id) if run_id is not None else None,
+            )
+            if not ok:
+                return "not-live"
+            with kb.write_txn(conn):
+                kb._append_event(
+                    conn, task, "worker_stop_request",
+                    {
+                        "kind": req.kind,
+                        "reason": req.reason,
+                        "request": os.path.basename(req.path),
+                        "error": req.error or None,
+                    },
+                    run_id=int(run_id) if run_id is not None else None,
+                )
+            return "blocked"
+        finally:
+            try:
+                conn.close()
+            except Exception:
+                pass
+    except Exception:
+        logger.warning("Failed to honour worker stop request for %s", task, exc_info=True)
+        return "error"
