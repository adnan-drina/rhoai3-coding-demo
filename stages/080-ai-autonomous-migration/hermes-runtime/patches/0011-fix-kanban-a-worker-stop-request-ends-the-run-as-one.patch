+    def _observe_read_family(
+        self,
+        tool_name: str,
+        args: Mapping[str, Any],
+        result: str | None,
+    ) -> ToolGuardrailDecision | None:
+        """Bounded repetition family for read-only log context searches.
+
+        The identical-call guard keys on exact arguments, so a model that
+        re-reads the same log with only grep's context size changed
+        (``grep -B 10``, ``-B 20`` … ``-B 20000000000``) never trips it. Such
+        calls form one family: same tool, same working directory, and the
+        same command once grep's context-size options (``-A``/``-B``/``-C``,
+        ``-NUM`` and their long forms) are removed; nothing else is
+        normalised, so any other number, pattern, file or option is a
+        different family. A read that shows at least one output line the
+        family has not shown before is progress and resets the count; five
+        reads in a row that show nothing new halt the turn.
+
+        The family state is per turn and is dropped by any call that can
+        change the evidence (a file write/patch, code execution, or a
+        terminal command that is not a plain read-only pipeline).
+        """
+        if tool_name in _PHASE_CHANGING_TOOLS:
+            self._read_families.clear()
+            return None
+        if tool_name != "terminal":
+            return None
+        command = args.get("command")
+        if not isinstance(command, str) or args.get("background"):
+            self._read_families.clear()
+            return None
+        parsed = _parse_read_command(command)
+        if parsed is None:
+            # Not a recognisable read-only pipeline: treat as a phase change.
+            self._read_families.clear()
+            return None
+        if not parsed.is_search:
+            return None  # read-only but not a grep search: neutral
+        cwd = str(args.get("workdir") or "")
+        key = _sha256(json.dumps(["terminal", cwd, parsed.family_tokens], ensure_ascii=False))
+        fam = self._read_families.get(key)
+        if fam is None:
+            if len(self._read_families) >= _READ_FAMILY_MAX:
+                self._read_families.pop(next(iter(self._read_families)))
+            fam = _ReadFamily(description=parsed.describe(cwd))
+            self._read_families[key] = fam
+        fam.note_context(parsed.context_options)
+        new = False
+        for line in _result_content_lines(result):
+            digest = hashlib.sha256(line.encode("utf-8", "surrogatepass")).digest()[:16]
+            if digest not in fam.seen:
+                fam.seen.add(digest)
+                new = True
+        fam.redundant = 0 if new else fam.redundant + 1
+        if (
+            self.config.hard_stop_enabled
+            and fam.redundant >= self.config.no_progress_block_after
+            and self._halt_decision is None
+        ):
+            decision = ToolGuardrailDecision(
+                action="halt",
+                code=READ_FAMILY_HALT_CODE,
+                message=(
+                    f"Stopped {tool_name}: {fam.redundant} reads in a row of the same "
+                    f"log context search showed no new content ({fam.description}; "
+                    f"only grep's context size changed: {fam.context_summary()}). "
+                    "Nothing on disk was changed by this stop: the working tree and "
+                    "any retained candidate stay as they are. Use the content already "
+                    "shown, or end the run with the card's stated terminator."
+                ),
+                tool_name=tool_name,
+                count=fam.redundant,
+                signature=ToolCallSignature(tool_name=tool_name, args_hash=key),
+                family=fam.description,
+            )
+            self._halt_decision = decision
+            return decision
+        return None
+
     def _is_idempotent(self, tool_name: str) -> bool:
