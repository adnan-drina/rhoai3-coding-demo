     return _result_hash(result)
 
 
+# ── Read-only log context search families (_observe_read_family) ─────────
+
+READ_FAMILY_HALT_CODE = "read_family_no_new_content_halt"
+_READ_FAMILY_MAX = 32
+# Tool calls that can change what a later read shows.
+_PHASE_CHANGING_TOOLS = frozenset(
+    {"write_file", "patch", "execute_code", "delegate_task", "skill_manage"}
+)
+_GREP_PROGRAMS = frozenset({"grep", "egrep", "fgrep", "zgrep"})
+# Programs whose pipelines only read. ``cd`` only moves the shell.
+_READ_ONLY_PROGRAMS = _GREP_PROGRAMS | frozenset(
+    {"cat", "zcat", "head", "tail", "wc", "sort", "uniq", "cut", "nl", "tr",
+     "ls", "pwd", "echo", "printf", "stat", "file", "du", "df", "true", "cd"}
+)
+_SEGMENT_OPERATORS = frozenset({"|", "||", "&&", ";"})
+_FD_REDIRECTS = frozenset({">", ">>", ">&", "&>"})
+_REDIRECT_SINKS = frozenset({"/dev/null", "1", "2"})
+# GNU grep context-size options (the ONLY options a family ignores).
+_GREP_CONTEXT_SHORT = "ABC"
+_GREP_CONTEXT_LONG = frozenset({"--after-context", "--before-context", "--context"})
+# Other grep options that take an argument (kept verbatim with it).
+_GREP_SHORT_WITH_ARG = "Ddefm"
+_GREP_LONG_WITH_ARG = frozenset(
+    {"--regexp", "--file", "--max-count", "--label", "--include", "--exclude",
+     "--exclude-from", "--exclude-dir", "--devices", "--directories",
+     "--binary-files", "--group-separator"}
+)
+_ENV_ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
+_TRUNCATION_NOTICE = re.compile(
+    r"^\.\.\. \[OUTPUT TRUNCATED - [\d,]+ chars omitted out of [\d,]+ total\] \.\.\.$"
+)
+
+
+@dataclass
+class _ReadFamily:
+    description: str
+    seen: set = field(default_factory=set)
+    redundant: int = 0
+    first_context: str = ""
+    last_context: str = ""
+
+    def note_context(self, options: list[str]) -> None:
+        text = " ".join(options) or "none"
+        if not self.first_context:
+            self.first_context = text
+        self.last_context = text
+
+    def context_summary(self) -> str:
+        if self.first_context == self.last_context:
+            return self.first_context
+        return f"{self.first_context} … {self.last_context}"
+
+
+@dataclass
+class _ParsedRead:
+    family_tokens: list
+    is_search: bool
+    context_options: list
+    patterns: list
+    files: list
+
+    def describe(self, cwd: str) -> str:
+        pat = ", ".join(repr(p) for p in self.patterns) or "?"
+        files = ", ".join(self.files) or "stdin"
+        where = f" (workdir {cwd})" if cwd else ""
+        return f"terminal grep {pat} in {files}{where}"
+
+
+def _strip_grep_context(args: list) -> tuple[list, list, list, list]:
+    """Remove grep's context-size options from ``args``.
+
+    Returns (kept_args, removed_context_options, patterns, operands).
+    Only -A/-B/-C (separate or attached value, also inside a short-option
+    cluster), -NUM and --after-context/--before-context/--context are removed.
+    """
+    kept: list = []
+    removed: list = []
+    patterns: list = []
+    operands: list = []
+    i = 0
+    options_done = False
+    while i < len(args):
+        a = args[i]
+        if options_done or a == "-" or not a.startswith("-"):
+            kept.append(a)
+            operands.append(a)
+            i += 1
+            continue
+        if a == "--":
+            kept.append(a)
+            options_done = True
+            i += 1
+            continue
+        if a.startswith("--"):
+            name, eq, value = a.partition("=")
+            if name in _GREP_CONTEXT_LONG:
+                if eq:
+                    removed.append(a)
+                    i += 1
+                else:
+                    removed.append(" ".join(args[i:i + 2]))
+                    i += 2
+                continue
+            kept.append(a)
+            if name in _GREP_LONG_WITH_ARG:
+                if eq:
+                    if name in ("--regexp",):
+                        patterns.append(value)
+                    i += 1
+                elif i + 1 < len(args):
+                    kept.append(args[i + 1])
+                    if name == "--regexp":
+                        patterns.append(args[i + 1])
+                    i += 2
+                else:
+                    i += 1
+                continue
+            i += 1
+            continue
+        body = a[1:]
+        out = ""
+        j = 0
+        skip_next = False
+        keep_next = False
+        next_is_pattern = False
+        while j < len(body):
+            c = body[j]
+            if c.isdigit():
+                k = j
+                while k < len(body) and body[k].isdigit():
+                    k += 1
+                removed.append("-" + body[j:k])
+                j = k
+                continue
+            if c in _GREP_CONTEXT_SHORT:
+                value = body[j + 1:]
+                if value:
+                    removed.append(f"-{c}{value}")
+                else:
+                    removed.append(" ".join([f"-{c}"] + args[i + 1:i + 2]))
+                    skip_next = True
+                j = len(body)
+                break
+            if c in _GREP_SHORT_WITH_ARG:
+                out += body[j:]
+                value = body[j + 1:]
+                if value:
+                    if c == "e":
+                        patterns.append(value)
+                else:
+                    keep_next = True
+                    next_is_pattern = c == "e"
+                j = len(body)
+                break
+            out += c
+            j += 1
+        if out:
+            kept.append("-" + out)
+        i += 1
+        if skip_next:
+            i += 1
+        elif keep_next and i < len(args):
+            kept.append(args[i])
+            if next_is_pattern:
+                patterns.append(args[i])
+            i += 1
+    if not patterns and operands:
+        patterns.append(operands[0])
+        operands = operands[1:]
+    return kept, removed, patterns, operands
+
+
+def _parse_read_command(command: str) -> _ParsedRead | None:
+    """Parse a read-only pipeline; None when it is anything else.
+
+    Accepted: segments joined by ``|``, ``||``, ``&&`` or ``;`` whose programs
+    are all in ``_READ_ONLY_PROGRAMS`` (optionally after ``VAR=value``
+    prefixes), with no subshells, command substitution, background ``&`` or
+    output redirection other than to ``/dev/null`` or another descriptor.
+    """
+    if "`" in command or "$(" in command or "\n" in command.strip():
+        return None
+    try:
+        lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
+        lexer.whitespace_split = True
+        tokens = list(lexer)
+    except ValueError:
+        return None
+    if not tokens:
+        return None
+    segments: list = [[]]
+    for tok in tokens:
+        if tok in _SEGMENT_OPERATORS:
+            segments.append([])
+        else:
+            segments[-1].append(tok)
+    family_tokens: list = []
+    context: list = []
+    patterns: list = []
+    files: list = []
+    is_search = False
+    for seg in segments:
+        if not seg:
+            return None
+        k = 0
+        while k < len(seg) and _ENV_ASSIGNMENT.match(seg[k]):
+            k += 1
+        if k >= len(seg):
+            return None
+        program = seg[k].rsplit("/", 1)[-1]
+        if program not in _READ_ONLY_PROGRAMS:
+            return None
+        args: list = []
+        m = k + 1
+        while m < len(seg):
+            tok = seg[m]
+            if tok in ("(", ")", "&", "<<", "<<<", ">|"):
+                return None
+            if tok in _FD_REDIRECTS or tok == "<":
+                if m + 1 >= len(seg):
+                    return None
+                target = seg[m + 1]
+                if tok != "<" and target not in _REDIRECT_SINKS:
+                    return None
+                if args and args[-1] in ("1", "2") and tok != "<":
+                    args.pop()  # the descriptor number of ``2>``
+                m += 2
+                continue
+            if any(ch in tok for ch in "()&<>|;"):
+                return None
+            args.append(tok)
+            m += 1
+        if program in _GREP_PROGRAMS:
+            is_search = True
+            kept, removed, pats, operands = _strip_grep_context(args)
+            context.extend(removed)
+            patterns.extend(pats)
+            files.extend(operands)
+            family_tokens.append([seg[:k], program, kept])
+        else:
+            if program in ("cat", "zcat", "head", "tail"):
+                skip = False
+                for a in args:
+                    if skip:
+                        skip = False
+                    elif a in ("-n", "-c", "--lines", "--bytes"):
+                        skip = True
+                    elif not a.startswith("-"):
+                        files.append(a)
+            family_tokens.append([seg[:k], program, args])
+    return _ParsedRead(family_tokens, is_search, context, patterns, files)
+
+
+def _result_content_lines(result: str | None) -> list:
+    """Output lines a read showed (terminal envelope ``output``), minus grep
+    group separators and the runtime's truncation notice."""
+    text = result or ""
+    parsed = safe_json_loads(text)
+    if isinstance(parsed, dict) and isinstance(parsed.get("output"), str):
+        text = parsed["output"]
+    lines = []
+    for raw in text.splitlines():
+        line = raw.rstrip()
+        if not line or line == "--" or _TRUNCATION_NOTICE.match(line.strip()):
+            continue
+        lines.append(line)
+    return lines
