+def _record_kanban_provider_throttle(
+    kanban_task: str,
+    evidence: dict,
+    logger: logging.Logger,
+) -> bool:
+    """Persist a provider quota stop for this worker run; request exit 75.
+
+    Written while the task is still ``running`` and before the process
+    exits. The task, claim and counters are not touched: the native reaper
+    ends the run ``rate_limited`` and requeues the card without counting a
+    failure (also when the exit status was lost, from this record). No-op
+    (False) for a delegated child or in-process cron job, or when the open
+    run is not this worker's.
