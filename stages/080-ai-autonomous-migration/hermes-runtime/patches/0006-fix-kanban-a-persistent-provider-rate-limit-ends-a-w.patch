+# ---------------------------------------------------------------------------
+# RHOAI3: provider quota stop evidence (patch 0006)
+# ---------------------------------------------------------------------------
+# A worker whose turn exhausted its provider retries on a quota wall (HTTP 429
+# rate limit, billing) writes a ``provider_throttle`` event bound to its run
+# before exiting with KANBAN_RATE_LIMIT_EXIT_CODE. The native reaper ends that
+# run ``rate_limited`` (no failure counted) with the reason, attempts and
+# Retry-After in the run metadata; check_respawn_guard's native
+# ``rate_limit_cooldown`` holds the card before the next spawn.
+
+PROVIDER_THROTTLE_EVENT = "provider_throttle"
+
+
+def record_provider_throttle(conn, task_id: str, run_id: int, evidence: dict) -> None:
+    """Persist one provider quota stop record for (task, worker run); idempotent."""
+    with write_txn(conn):
+        exists = conn.execute(
+            "SELECT 1 FROM task_events WHERE task_id = ? AND run_id = ? AND kind = ?",
+            (task_id, int(run_id), PROVIDER_THROTTLE_EVENT),
+        ).fetchone()
+        if exists:
+            return
+        _append_event(conn, task_id, PROVIDER_THROTTLE_EVENT, dict(evidence), run_id=int(run_id))
+
+
+def _provider_throttle_for_run(conn, task_id: str, run_id) -> Optional[dict]:
+    if run_id is None:
+        return None
+    row = conn.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND run_id = ? AND kind = ? "
+        "ORDER BY id DESC LIMIT 1",
+        (task_id, int(run_id), PROVIDER_THROTTLE_EVENT),
+    ).fetchone()
+    try:
+        payload = json.loads(row["payload"]) if row and row["payload"] else None
+    except (TypeError, ValueError):
+        payload = None
+    return payload if isinstance(payload, dict) else None
+
+
