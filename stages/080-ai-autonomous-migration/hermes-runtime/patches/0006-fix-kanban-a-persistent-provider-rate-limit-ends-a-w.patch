+                return False
+            expected_run = (os.environ.get("HERMES_KANBAN_RUN_ID") or "").strip()
+            if expected_run and str(row["current_run_id"]) != expected_run:
+                return False
+            _kb.record_provider_throttle(
+                _conn, kanban_task, int(row["current_run_id"]), evidence,
+            )
+        finally:
+            try:
+                _conn.close()
+            except Exception:
+                pass
+        _kanban_exit_code = _kb.KANBAN_RATE_LIMIT_EXIT_CODE
+        return True
+    except Exception:
+        logger.warning("Failed to record provider quota stop for task %s", kanban_task, exc_info=True)
+        return False
+
+
