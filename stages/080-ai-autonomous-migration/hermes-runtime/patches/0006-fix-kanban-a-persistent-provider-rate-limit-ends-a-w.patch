diff --git a/tests/agent/test_kanban_provider_throttle.py b/tests/agent/test_kanban_provider_throttle.py
new file mode 100644
index 0000000..420cc8a
--- /dev/null
+++ b/tests/agent/test_kanban_provider_throttle.py
@@ -0,0 +1,173 @@
+"""A provider quota wall ends a kanban worker run neutrally (RHOAI3 patch 0006).
+
+An exhausted provider-429 turn is not a task failure. The worker records the
+evidence for its run and exits KANBAN_RATE_LIMIT_EXIT_CODE (EX_TEMPFAIL); the
+native reaper books the run ``rate_limited``, requeues the card without
+counting a failure, and the native rate-limit cooldown holds the next spawn.
+Authentication and configuration errors stay failures.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+import agent.turn_finalizer as tf
+from agent.delegation_context import non_dispatcher_owned_context
+from hermes_cli import kanban_db as kb
+
+THROTTLED = {
+    "failed": True,
+    "completed": False,
+    "failure_reason": "rate_limit",
+    "api_attempts": 3,
+    "retry_after": "120",
+    "error": "HTTP 429 rate limited",
+}
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_KANBAN_CRASH_GRACE_SECONDS", "0")
+    monkeypatch.delenv("HERMES_KANBAN_RATE_LIMIT_COOLDOWN_SECONDS", raising=False)
+    monkeypatch.setattr(tf, "_kanban_exit_code", None)
+    kb.init_db()
+    conn = kb.connect()
+    yield conn
+    conn.close()
+
+
+def _start_run(conn, tid, monkeypatch, pid):
+    host = kb._claimer_id().split(":", 1)[0]
+    assert kb.claim_task(conn, tid, claimer=f"{host}:worker") is not None
+    kb._set_worker_pid(conn, tid, pid)
+    run_id = conn.execute("SELECT current_run_id FROM tasks WHERE id = ?", (tid,)).fetchone()[0]
+    monkeypatch.setenv("HERMES_KANBAN_TASK", tid)
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", str(run_id))
+    monkeypatch.setattr(tf, "_kanban_exit_code", None)
+    return run_id
+
+
+def _reap(conn, monkeypatch, pid, exit_code):
+    if exit_code is not None:
+        kb._record_worker_exit(pid, exit_code << 8)  # W_EXITCODE(code, 0)
+    monkeypatch.setattr(kb, "_pid_alive", lambda p: False)
+    kb.detect_crashed_workers(conn)
+
+
+def _task(conn, tid):
+    return conn.execute(
+        "SELECT status, consecutive_failures, current_run_id FROM tasks WHERE id = ?", (tid,)
+    ).fetchone()
+
+
+def _last_run(conn, tid):
+    return conn.execute(
+        "SELECT outcome, metadata FROM task_runs WHERE task_id = ? ORDER BY id DESC LIMIT 1", (tid,)
+    ).fetchone()
+
+
+def test_two_exhausted_429_turns_are_neutral_requeues_with_cooldown(board, monkeypatch):
+    tid = kb.create_task(board, title="throttled", assignee="implementer", max_retries=2)
+    for attempt, pid in enumerate((91001, 91002), 1):
+        _start_run(board, tid, monkeypatch, pid)
+        assert tf.record_kanban_turn_stop(SimpleNamespace(_api_max_retries=3), dict(THROTTLED)) is True
+        assert tf.kanban_worker_exit_code() == kb.KANBAN_RATE_LIMIT_EXIT_CODE == 75
+        # The worker records evidence only: the run stays open for the reaper.
+        assert _task(board, tid)["status"] == "running"
+        _reap(board, monkeypatch, pid, tf.kanban_worker_exit_code())
+        row = _task(board, tid)
+        assert row["status"] == "ready", attempt
+        assert row["consecutive_failures"] == 0, attempt
+        assert row["current_run_id"] is None
+        run = _last_run(board, tid)
+        assert run["outcome"] == "rate_limited"
+        meta = json.loads(run["metadata"])
+        assert meta["provider_throttle"] is True
+        assert meta["failure_reason"] == "rate_limit"
+        assert meta["api_attempts"] == 3 and meta["retry_after"] == "120"
+        assert meta["http_status"] == 429
+        # The native cooldown holds the card: no immediate respawn.
+        assert kb.check_respawn_guard(board, tid) == "rate_limit_cooldown"
+    events = [r["kind"] for r in board.execute(
+        "SELECT kind FROM task_events WHERE task_id = ? ORDER BY id", (tid,))]
+    assert events.count("provider_throttle") == 2
+    assert "gave_up" not in events and "crashed" not in events
+
+
+def test_cooldown_elapsed_allows_the_next_probe(board, monkeypatch):
+    tid = kb.create_task(board, title="throttled", assignee="implementer", max_retries=2)
+    _start_run(board, tid, monkeypatch, 91003)
+    tf.record_kanban_turn_stop(SimpleNamespace(), dict(THROTTLED))
+    _reap(board, monkeypatch, 91003, tf.kanban_worker_exit_code())
+    assert kb.check_respawn_guard(board, tid) == "rate_limit_cooldown"
+    monkeypatch.setenv("HERMES_KANBAN_RATE_LIMIT_COOLDOWN_SECONDS", "0")
+    # The stamped quota text must not re-trap the card as blocker_auth.
+    assert kb.check_respawn_guard(board, tid) is None
+
+
+def test_lost_exit_status_still_ends_the_run_neutrally(board, monkeypatch):
+    # Dispatcher restarted: the reap registry has no status for the pid.
+    tid = kb.create_task(board, title="throttled", assignee="implementer", max_retries=2)
+    _start_run(board, tid, monkeypatch, 91004)
+    tf.record_kanban_turn_stop(SimpleNamespace(), dict(THROTTLED))
+    _reap(board, monkeypatch, 91004, None)
+    row = _task(board, tid)
+    assert (row["status"], row["consecutive_failures"]) == ("ready", 0)
+    assert _last_run(board, tid)["outcome"] == "rate_limited"
+
+
+def test_billing_wall_is_neutral_too(board, monkeypatch):
+    tid = kb.create_task(board, title="billing", assignee="implementer", max_retries=2)
+    _start_run(board, tid, monkeypatch, 91005)
+    result = {"failed": True, "failure_reason": "billing", "error": "credit exhausted"}
+    assert tf.record_kanban_turn_stop(SimpleNamespace(), result) is True
+    _reap(board, monkeypatch, 91005, tf.kanban_worker_exit_code())
+    assert _last_run(board, tid)["outcome"] == "rate_limited"
+    assert _task(board, tid)["consecutive_failures"] == 0
+
+
+@pytest.mark.parametrize("reason", ["auth", "auth_permanent", "model_not_found"])
+def test_auth_or_config_error_still_fails(board, monkeypatch, reason):
+    tid = kb.create_task(board, title="auth", assignee="implementer", max_retries=2)
+    _start_run(board, tid, monkeypatch, 91006)
+    result = {"failed": True, "failure_reason": reason, "error": "HTTP 401 invalid api key"}
+    assert tf.record_kanban_turn_stop(SimpleNamespace(), result) is False
+    assert tf.kanban_worker_exit_code() is None
+    # The quiet branch exits 1 for it: a real failure, counted.
+    _reap(board, monkeypatch, 91006, 1)
+    row = _task(board, tid)
+    assert row["consecutive_failures"] == 1
+    assert _last_run(board, tid)["outcome"] == "crashed"
+    assert not board.execute(
+        "SELECT 1 FROM task_events WHERE task_id = ? AND kind = 'provider_throttle'", (tid,)
+    ).fetchone()
+
+
+def test_child_or_cron_does_not_record_for_the_parent_run(board, monkeypatch):
+    tid = kb.create_task(board, title="parent", assignee="implementer", max_retries=2)
+    _start_run(board, tid, monkeypatch, 91007)
+    with non_dispatcher_owned_context():
+        assert tf.record_kanban_turn_stop(SimpleNamespace(), dict(THROTTLED)) is False
+    assert tf.kanban_worker_exit_code() is None
+    assert not board.execute(
+        "SELECT 1 FROM task_events WHERE task_id = ? AND kind = 'provider_throttle'", (tid,)
+    ).fetchone()
+
+
+def test_record_is_idempotent_per_run(board, monkeypatch):
+    tid = kb.create_task(board, title="twice", assignee="implementer", max_retries=2)
+    _start_run(board, tid, monkeypatch, 91008)
+    tf.record_kanban_turn_stop(SimpleNamespace(), dict(THROTTLED))
+    tf.record_kanban_turn_stop(SimpleNamespace(), dict(THROTTLED))
+    n = board.execute(
+        "SELECT COUNT(*) FROM task_events WHERE task_id = ? AND kind = 'provider_throttle'", (tid,)
+    ).fetchone()[0]
+    assert n == 1
