diff --git a/agent/run_compaction.py b/agent/run_compaction.py
new file mode 100644
index 0000000..83923e8
--- /dev/null
+++ b/agent/run_compaction.py
@@ -0,0 +1,228 @@
+"""Run-scoped context compaction and the request ceiling (RHOAI3 patch 0021).
+
+A Kanban card run is one turn. The stock pre-API and post-tool compaction gates
+share a per-turn attempt budget (``compression.max_attempts``) and an
+"insufficient progress" block, and both stay closed until the provider reports
+a prompt below the trigger. In v32 (q36, t_2a95f8c1 run 44) three deterministic
+passes (Phase-1 prune only, no summary, 58-92 ms, no message removed) used the
+whole budget; no compaction ran again, the real prompt grew from ~80K to 121K
+tokens against a 110K configured window, and the next request got no stream
+chunk for 900 s.
+
+With ``compression.run_scoped: true`` this guard replaces both gates for the
+whole run (the turn-prologue preflight and the provider-error handlers are
+unchanged):
+
+* **Projection.** Every decision uses the projected real prompt of the request
+  about to be sent: the provider's last reported prompt count plus the rough
+  size of what was added since, with a margin on that addition only
+  (``ContextCompressor.project_request_tokens``). Without a provider figure in
+  the run the rough estimate is used.
+* **Always available.** At or above ``threshold_tokens`` a pass runs. There is
+  no attempt budget and no block: after a pass the next one waits until the
+  projection has grown by ``rearm_runway`` tokens, so a pass cannot run on
+  every request.
+* **Summarise after prune.** A pass that made no summary progress (the
+  compressor returned only its Phase-1 prune) while the projection is still at
+  or above the threshold is followed, before any request is sent, by a forced
+  summarising pass with half the tail budget.
+* **Ceiling.** If the projection plus the output cap exceeds the configured
+  window (``model.context_length``), a forced pass runs regardless of runway,
+  cooldown or anti-thrash state: first with half the tail budget, then with
+  the minimum tail. If the request still does not fit, the run ends at once
+  with ``context_ceiling_unreachable``; it is never sent to wait out the
+  stream stale timeout.
+"""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+LOG_PREFIX = "[run-compaction]"
+CEILING_STOP_CODE = "context_ceiling_unreachable"
+DEFAULT_GROWTH_MARGIN = 0.25
+# Forced-pass tail budgets, as fractions of the configured tail budget.
+_SUMMARY_FOLLOWUP_TAIL = 0.5
+_CEILING_TAILS = (0.5, 0.0)
+
+DECISION_SEND = "send"
+DECISION_COMPACT = "compact"
+DECISION_UNREACHABLE = "unreachable"
+
+
+@dataclass
+class PassPlan:
+    reason: str  # threshold | summary-followup | ceiling
+    tail_fraction: float | None  # None = the compressor's own tail budget
+    force: bool
+
+
+def _as_bool(value: Any) -> bool:
+    if isinstance(value, str):
+        return value.strip().lower() in {"1", "true", "yes", "on"}
+    return bool(value)
+
+
+def _as_margin(value: Any) -> float:
+    try:
+        margin = float(value)
+    except (TypeError, ValueError):
+        return DEFAULT_GROWTH_MARGIN
+    return margin if 0.0 <= margin <= 1.0 else DEFAULT_GROWTH_MARGIN
+
+
+class RunCompactionGuard:
+    """Per-run compaction decisions for one agent (see module docstring)."""
+
+    def __init__(self, enabled: bool = False, growth_margin: Any = DEFAULT_GROWTH_MARGIN,
+                 rearm_runway: Any = None):
+        self.enabled = _as_bool(enabled)
+        self.growth_margin = _as_margin(growth_margin)
+        try:
+            self._rearm_runway = int(rearm_runway) if rearm_runway is not None else None
+        except (TypeError, ValueError):
+            self._rearm_runway = None
+        self.reset()
+
+    @classmethod
+    def from_config(cls, compression_cfg: Any) -> "RunCompactionGuard":
+        cfg = compression_cfg if isinstance(compression_cfg, dict) else {}
+        return cls(
+            enabled=cfg.get("run_scoped", False),
+            growth_margin=cfg.get("ceiling_growth_margin", DEFAULT_GROWTH_MARGIN),
+            rearm_runway=cfg.get("rearm_runway_tokens"),
+        )
+
+    def reset(self) -> None:
+        self._last_pass_projection: int | None = None
+        self._summary_followup_due = False
+        self._ceiling_level = 0
+        self.passes = 0
+        self.forced_passes = 0
+        self.events: list = []
+
+    # ── arithmetic ──────────────────────────────────────────────────
+    @staticmethod
+    def window_and_cap(agent: Any) -> tuple:
+        compressor = getattr(agent, "context_compressor", None)
+        window = int(getattr(compressor, "context_length", 0) or 0)
+        cap = getattr(agent, "max_tokens", None) or getattr(compressor, "max_tokens", None) or 0
+        try:
+            cap = int(cap)
+        except (TypeError, ValueError):
+            cap = 0
+        return window, max(0, cap)
+
+    def runway(self, threshold: int) -> int:
+        if self._rearm_runway is not None and self._rearm_runway >= 0:
+            return self._rearm_runway
+        return max(4096, int(threshold * 0.1))
+
+    def project(self, compressor: Any, rough_tokens: int) -> int:
+        project = getattr(compressor, "project_request_tokens", None)
+        if callable(project):
+            return int(project(rough_tokens, self.growth_margin))
+        return int(rough_tokens)
+
+    # ── decisions ───────────────────────────────────────────────────
+    def plan(self, projected: int, threshold: int, window: int, cap: int) -> PassPlan | None | str:
+        """Decide before a request is sent: a ``PassPlan``, ``None`` (send), or
+        ``DECISION_UNREACHABLE``."""
+        if window > 0 and projected + cap > window:
+            if self._ceiling_level >= len(_CEILING_TAILS):
+                return DECISION_UNREACHABLE
+            fraction = _CEILING_TAILS[self._ceiling_level]
+            self._ceiling_level += 1
+            return PassPlan("ceiling", fraction, True)
+        self._ceiling_level = 0
+        if threshold <= 0 or projected < threshold:
+            self._summary_followup_due = False
+            return None
+        if self._summary_followup_due:
+            self._summary_followup_due = False
+            return PassPlan("summary-followup", _SUMMARY_FOLLOWUP_TAIL, True)
+        if (
+            self._last_pass_projection is not None
+            and projected < self._last_pass_projection + self.runway(threshold)
+        ):
+            return None
+        return PassPlan("threshold", None, False)
+
+    def note_pass(self, plan: PassPlan, made_summary_progress: bool, projected_after: int,
+                  threshold: int) -> None:
+        self.passes += 1
+        if plan.force:
+            self.forced_passes += 1
+        self._last_pass_projection = projected_after
+        self._summary_followup_due = (
+            plan.reason == "threshold"
+            and not made_summary_progress
+            and projected_after >= threshold
+        )
+
+    def note_sent(self) -> None:
+        self._ceiling_level = 0
+
+    def _log(self, line: str) -> None:
+        self.events.append(line)
+        logger.info("%s %s", LOG_PREFIX, line)
+
+    # ── one pre-API step ────────────────────────────────────────────
+    def preflight(self, agent: Any, messages: list, system_message: Any,
+                  request_pressure_tokens: int, task_id: str = "") -> tuple:
+        """Run before a request. Returns ``(decision, messages, system_prompt)``
+        where decision is ``send``, ``compact`` (the caller rebuilds the request)
+        or ``unreachable``."""
+        compressor = agent.context_compressor
+        threshold = int(getattr(compressor, "threshold_tokens", 0) or 0)
+        window, cap = self.window_and_cap(agent)
+        projected = self.project(compressor, request_pressure_tokens)
+        plan = self.plan(projected, threshold, window, cap)
+        if plan is None:
+            return DECISION_SEND, messages, None
+        if plan == DECISION_UNREACHABLE:
+            self._log(
+                f"{CEILING_STOP_CODE}: projected={projected} + output_cap={cap} > window={window} "
+                "after the forced passes"
+            )
+            return DECISION_UNREACHABLE, messages, None
+        tail = None
+        if plan.tail_fraction is not None:
+            tail = int(int(getattr(compressor, "tail_token_budget", 0) or 0) * plan.tail_fraction)
+        self._log(
+            f"pass reason={plan.reason} projected={projected} threshold={threshold} "
+            f"window={window} output_cap={cap} tail_budget={tail if tail is not None else 'default'}"
+        )
+        before_rough = _messages_rough(messages)
+        summarized_before = int(getattr(compressor, "summarized_passes", 0) or 0)
+        previous_forced = getattr(compressor, "_forced_tail_token_budget", None)
+        try:
+            compressor._forced_tail_token_budget = tail
+            compressed, system_prompt = agent._compress_context(
+                messages, system_message, approx_tokens=projected,
+                task_id=task_id, force=plan.force,
+            )
+        finally:
+            compressor._forced_tail_token_budget = previous_forced
+        made_progress = int(getattr(compressor, "summarized_passes", 0) or 0) > summarized_before
+        after_rough = request_pressure_tokens - before_rough + _messages_rough(compressed)
+        projected_after = self.project(compressor, after_rough)
+        self.note_pass(plan, made_progress, projected_after, threshold)
+        self._log(
+            f"done reason={plan.reason} messages={len(messages)}->{len(compressed)} "
+            f"summary_progress={str(made_progress).lower()} projected_after={projected_after}"
+        )
+        return DECISION_COMPACT, compressed, system_prompt
+
+
+def _messages_rough(messages: list) -> int:
+    from agent.model_metadata import estimate_messages_tokens_rough
+
+    try:
+        return int(estimate_messages_tokens_rough(messages))
+    except Exception:
+        return 0
