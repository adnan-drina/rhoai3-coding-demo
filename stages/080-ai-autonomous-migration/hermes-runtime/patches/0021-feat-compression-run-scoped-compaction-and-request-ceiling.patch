+    def project_request_tokens(self, rough_tokens: int, growth_margin: float = 0.25) -> int:
+        """Projected real prompt tokens of a request whose rough estimate is
+        ``rough_tokens`` (RHOAI3 patch 0021).
+
+        The provider's last reported prompt count for a request plus the rough
+        size of what was added since, with ``growth_margin`` applied to that
+        addition only (a removal, e.g. after a compaction, is credited at
+        ``1 - growth_margin``). The rough estimate errs in both directions in
+        one session (it over-counted ~70% early in v32 q36 and under-counted
+        10-15% later), so only the delta is estimated. Without a provider
+        figure yet in this run the rough estimate itself is returned.
+        """
+        rough = max(0, int(rough_tokens or 0))
+        anchor_rough = int(getattr(self, "_ceiling_anchor_rough", 0) or 0)
+        anchor_real = int(getattr(self, "_ceiling_anchor_real", 0) or 0)
+        if anchor_rough <= 0 or anchor_real <= 0:
+            return rough
+        delta = rough - anchor_rough
+        factor = (1.0 + growth_margin) if delta >= 0 else max(0.0, 1.0 - growth_margin)
+        return max(0, int(round(anchor_real + delta * factor)))
