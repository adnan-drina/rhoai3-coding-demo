diff --git a/tests/agent/test_run_compaction.py b/tests/agent/test_run_compaction.py
new file mode 100644
index 0000000..f708064
--- /dev/null
+++ b/tests/agent/test_run_compaction.py
@@ -0,0 +1,472 @@
+"""Run-scoped compaction, the request ceiling and pruned-stub refusal (RHOAI3 patch 0021).
+
+v32-qwen36 card t_2a95f8c1 run 44 (one Kanban turn, ~100 calls): three
+prune-only compaction passes used the per-turn attempt budget, compaction never
+ran again, the real prompt grew to 121,375 tokens against a 110,000-token
+configured window, and the next request waited 900 s without a stream chunk.
+Pruned write_file arguments ("<200 chars>...[truncated]") were then replayed
+as file content.
+
+Provider figures used below are the session's real ones (agent.log API calls
+#1, #19, #50, #81, #96 and the 20:36Z 80,021-token estimate).
+"""
+
+from __future__ import annotations
+
+import contextlib
+import copy
+import io
+import json
+import os
+import sqlite3
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from agent.context_compressor import (
+    PRUNED_ARGUMENT_MARKER,
+    ContextCompressor,
+    _truncate_tool_call_args_json,
+)
+from agent.model_metadata import estimate_messages_tokens_rough
+from agent.run_compaction import (
+    CEILING_STOP_CODE,
+    DECISION_COMPACT,
+    DECISION_SEND,
+    DECISION_UNREACHABLE,
+    PassPlan,
+    RunCompactionGuard,
+)
+
+WINDOW = 110_000
+CAP = 8_192
+THRESHOLD = 72_000
+OVERHEAD = 22_000  # request minus messages, measured on the v32 session
+
+Q36_COMPRESSION = {  # gitops model-profiles.json qwen3-6-27b + the base block
+    "enabled": True,
+    "threshold": 0.8,
+    "target_ratio": 0.2,
+    "protect_last_n": 12,
+    "threshold_tokens": 72000,
+    "proactive_prune_tokens": 48000,
+    "run_scoped": True,
+}
+
+
+def _compressor(**overrides):
+    kwargs = dict(
+        model="qwen3-6-27b", threshold_percent=0.8, protect_last_n=12, summary_target_ratio=0.2,
+        quiet_mode=True, config_context_length=WINDOW, provider="custom", max_tokens=CAP,
+        threshold_tokens_cap=THRESHOLD, proactive_prune_tokens=48000,
+    )
+    kwargs.update(overrides)
+    c = ContextCompressor(**kwargs)
+    c.summary_calls = []
+
+    def _summary(turns, **_kw):
+        c.summary_calls.append(len(turns))
+        return f"Summary of {len(turns)} turns."
+
+    c._generate_summary = _summary
+    return c
+
+
+def _anchor(compressor, rough, real):
+    compressor.note_request_rough_estimate(rough)
+    compressor.update_from_response({"prompt_tokens": real, "completion_tokens": 100, "total_tokens": real + 100})
+
+
+# ── projection: provider figure + margin on the addition only ─────────────
+
+
+def test_projection_without_a_provider_figure_is_the_rough_estimate():
+    c = _compressor()
+    assert c.project_request_tokens(80_021) == 80_021
+
+
+def test_overcounting_estimate_does_not_force_a_needless_compaction():
+    """20:36Z: 7 messages estimated at 80,021 while the provider reported
+    46,939 (call #1) and 62,771 (call #7) around it."""
+    c = _compressor()
+    _anchor(c, 79_000, 46_939)
+    projected = c.project_request_tokens(80_021)
+    assert projected == 46_939 + round(1_021 * 1.25)
+    guard = RunCompactionGuard(enabled=True)
+    assert guard.plan(projected, THRESHOLD, WINDOW, CAP) is None  # send
+    # The rough figure alone would have compacted.
+    assert RunCompactionGuard(enabled=True).plan(80_021, THRESHOLD, WINDOW, CAP).reason == "threshold"
+
+
+def test_undercounting_estimate_cannot_let_a_request_past_the_window():
+    """After 21:18Z the provider reported 104,668 (call #81) while the rough
+    estimate ran ~12% low."""
+    c = _compressor()
+    _anchor(c, 92_000, 104_668)
+    projected = c.project_request_tokens(93_000)
+    assert projected == 104_668 + 1_250
+    assert 93_000 + CAP <= WINDOW  # the rough estimate alone would have sent it
+    plan = RunCompactionGuard(enabled=True).plan(projected, THRESHOLD, WINDOW, CAP)
+    assert plan.reason == "ceiling" and plan.force
+
+
+def test_removal_is_credited_below_its_estimate():
+    c = _compressor()
+    _anchor(c, 100_000, 119_766)  # call #96
+    assert c.project_request_tokens(60_000) == 119_766 - round(40_000 * 0.75)
+
+
+# ── the guard's decisions ─────────────────────────────────────────────────
+
+
+def test_no_pass_below_the_threshold():
+    guard = RunCompactionGuard(enabled=True)
+    for projected in (10_000, 60_000, THRESHOLD - 1):
+        assert guard.plan(projected, THRESHOLD, WINDOW, CAP) is None
+
+
+def test_compaction_never_switches_off_but_waits_for_regrowth():
+    guard = RunCompactionGuard(enabled=True)
+    for k in range(10):  # far beyond the old per-turn budget of 3, never rearmed by the provider
+        plan = guard.plan(81_000, THRESHOLD, WINDOW, CAP)
+        assert isinstance(plan, PassPlan) and plan.reason == "threshold"
+        guard.note_pass(plan, True, 73_000, THRESHOLD)
+        # Still over the threshold, but no new pass until the runway regrows.
+        assert guard.plan(73_000 + 100, THRESHOLD, WINDOW, CAP) is None
+        assert guard.plan(73_000 + guard.runway(THRESHOLD) - 1, THRESHOLD, WINDOW, CAP) is None
+    assert guard.passes == 10 and guard.runway(THRESHOLD) == 7_200
+
+
+def test_prune_only_pass_is_followed_by_a_summarising_pass_before_sending():
+    guard = RunCompactionGuard(enabled=True)
+    first = guard.plan(75_735, THRESHOLD, WINDOW, CAP)  # the 20:49:47Z pass
+    guard.note_pass(first, False, 72_300, THRESHOLD)  # "~75,735 -> ~72,300", no summary
+    follow = guard.plan(72_300, THRESHOLD, WINDOW, CAP)
+    assert follow.reason == "summary-followup" and follow.force and follow.tail_fraction == 0.5
+    guard.note_pass(follow, True, 45_000, THRESHOLD)
+    assert guard.plan(45_000, THRESHOLD, WINDOW, CAP) is None
+
+
+def test_ceiling_forces_two_passes_then_the_named_stop():
+    guard = RunCompactionGuard(enabled=True)
+    p1 = guard.plan(121_375, THRESHOLD, WINDOW, CAP)
+    p2 = guard.plan(121_000, THRESHOLD, WINDOW, CAP)
+    assert (p1.reason, p1.tail_fraction, p2.reason, p2.tail_fraction) == ("ceiling", 0.5, "ceiling", 0.0)
+    assert guard.plan(120_000, THRESHOLD, WINDOW, CAP) == DECISION_UNREACHABLE
+
+
+def test_disabled_unless_configured():
+    assert RunCompactionGuard.from_config({}).enabled is False
+    # The Qwen 3.8 profile carries no compression block: base config only.
+    assert RunCompactionGuard.from_config({"enabled": True, "threshold": 0.8, "target_ratio": 0.2,
+                                           "protect_last_n": 20}).enabled is False
+    assert RunCompactionGuard.from_config(Q36_COMPRESSION).enabled is True
+
+
+# ── guard + real compressor (FakeAgent forwards to compress()) ────────────
+
+
+class _FakeAgent:
+    def __init__(self, compressor):
+        self.context_compressor = compressor
+        self.max_tokens = CAP
+        self.compress_calls = 0
+
+    def _compress_context(self, messages, system_message, approx_tokens=None, task_id="", force=False):
+        self.compress_calls += 1
+        out = self.context_compressor.compress(
+            [copy.deepcopy(m) for m in messages], current_tokens=approx_tokens, force=force,
+        )
+        return out, None
+
+
+def _request_rough(messages):
+    return estimate_messages_tokens_rough(messages) + OVERHEAD
+
+
+def _drive(guard, agent, messages, max_steps=8):
+    """Run guard.preflight until it says send/unreachable; return (decision, messages)."""
+    for _ in range(max_steps):
+        decision, out, _sp = guard.preflight(agent, messages, None, _request_rough(messages))
+        if decision != DECISION_COMPACT:
+            return decision, messages
+        messages = out
+    raise AssertionError("guard did not settle")
+
+
+def _write_call(i, chars):
+    content = f"// file {i}\n" + "".join(f"line {i}.{k} {'x' * 60}\n" for k in range(chars // 70))
+    return [
+        {"role": "assistant", "content": "", "tool_calls": [{
+            "id": f"call_{i}", "type": "function",
+            "function": {"name": "write_file",
+                         "arguments": json.dumps({"path": f"src/F{i}.java", "content": content})}}]},
+        {"role": "tool", "tool_call_id": f"call_{i}", "content": json.dumps({"success": True, "bytes": len(content)})},
+    ]
+
+
+def test_e1_shape_protected_tail_of_large_results_fits_after_the_ceiling():
+    """E-1 (v31): a protected tail holding large tool results kept the request
+    over the window; the forced ceiling passes bring it under, or stop."""
+    c = _compressor()
+    agent = _FakeAgent(c)
+    msgs = [{"role": "user", "content": "work kanban task t_e1"}]
+    for i in range(20):
+        msgs += [{"role": "assistant", "content": "", "tool_calls": [{
+            "id": f"r{i}", "type": "function",
+            "function": {"name": "terminal", "arguments": json.dumps({"command": f"cat out{i}.log"})}}]},
+            {"role": "tool", "tool_call_id": f"r{i}", "content": f"log {i}\n" + "y" * 24_000}]
+    assert _request_rough(msgs) + CAP > WINDOW
+    guard = RunCompactionGuard(enabled=True)
+    decision, final = _drive(guard, agent, msgs)
+    assert decision == DECISION_SEND
+    assert c.project_request_tokens(_request_rough(final)) + CAP <= WINDOW
+    assert c.summary_calls  # the passes summarised, not only pruned
+
+
+def test_e1_shape_tail_that_alone_exceeds_the_window_is_the_named_stop():
+    c = _compressor()
+    agent = _FakeAgent(c)
+    msgs = [{"role": "user", "content": "work kanban task t_e1"}]
+    for i in range(12):
+        msgs += [{"role": "assistant", "content": "x" * 60_000}, {"role": "user", "content": "y" * 60_000}]
+    guard = RunCompactionGuard(enabled=True)
+    decision, _ = _drive(guard, agent, msgs)
+    assert decision == DECISION_UNREACHABLE
+    assert any(CEILING_STOP_CODE in e for e in guard.events)
+
+
+# ── end to end: the v32 shape through AIAgent.run_conversation ────────────
+
+
+def _config():
+    return {
+        "model": {"context_length": WINDOW},
+        "compression": dict(Q36_COMPRESSION),
+        "tool_loop_guardrails": {"hard_stop_enabled": True},
+        "auxiliary": {"title_generation": {"enabled": False}},
+        "prompt_caching": {"cache_ttl": "5m"},
+        "sessions": {},
+        "bedrock": {},
+    }
+
+
+class _Provider:
+    """Scripted tool calls; reports prompt usage from the request it got
+    (rough estimate x ratio, the v32 late under-count)."""
+
+    def __init__(self, script, ratio=1.12):
+        self.script = list(script)
+        self.ratio = ratio
+        self.prompts = []
+
+    def create(self, **kwargs):
+        rough = estimate_messages_tokens_rough(kwargs.get("messages") or []) + OVERHEAD
+        prompt = int(rough * self.ratio)
+        self.prompts.append(prompt)
+        usage = SimpleNamespace(prompt_tokens=prompt, completion_tokens=200, total_tokens=prompt + 200)
+        if self.script:
+            name, args, call_id = self.script.pop(0)
+            msg = SimpleNamespace(content=None, reasoning=None, tool_calls=[SimpleNamespace(
+                id=call_id, type="function", function=SimpleNamespace(name=name, arguments=json.dumps(args)))])
+            return SimpleNamespace(choices=[SimpleNamespace(message=msg, finish_reason="tool_calls")], usage=usage)
+        msg = SimpleNamespace(content="done", reasoning=None, tool_calls=[])
+        return SimpleNamespace(choices=[SimpleNamespace(message=msg, finish_reason="stop")], usage=usage)
+
+
+def _agent(monkeypatch, tmp_path, script, compression=None, ratio=1.12):
+    from hermes_cli import config as config_mod
+    from hermes_state import SessionDB
+    from run_agent import AIAgent
+
+    cfg = _config()
+    if compression is not None:
+        cfg["compression"] = compression
+    monkeypatch.setattr(config_mod, "load_config", lambda: cfg)
+    monkeypatch.setattr(config_mod, "load_config_readonly", lambda: cfg)
+    provider = _Provider(script, ratio=ratio)
+    client = SimpleNamespace(chat=SimpleNamespace(completions=provider))
+    monkeypatch.setattr("run_agent.OpenAI", lambda **kwargs: client)
+    monkeypatch.setattr(
+        "run_agent.get_tool_definitions",
+        lambda *a, **k: [{"type": "function", "function": {
+            "name": "write_file", "description": "write", "parameters": {"type": "object", "properties": {}}}}],
+    )
+    monkeypatch.setattr(
+        "run_agent.handle_function_call",
+        lambda name, args, task_id=None, **kw: json.dumps({"success": True, "bytes": len(str(args.get("content", "")))}),
+    )
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    summary_calls = []
+    monkeypatch.setattr(
+        ContextCompressor, "_generate_summary",
+        lambda self, turns, **kw: summary_calls.append(len(turns)) or f"Summary of {len(turns)} turns.",
+    )
+    with contextlib.redirect_stdout(io.StringIO()):
+        agent = AIAgent(model="qwen3-6-27b", provider="custom", api_key="k", base_url="http://localhost:8080/v1",
+                        platform="cli", max_iterations=400, quiet_mode=True, skip_memory=True,
+                        skip_context_files=True, max_tokens=CAP,
+                        session_db=SessionDB(db_path=tmp_path / "state.db"), session_id="v32-shape")
+    agent._disable_streaming = True
+    agent.context_compressor.update_model(model="qwen3-6-27b", context_length=WINDOW, max_tokens=CAP)
+    return agent, provider, summary_calls
+
+
+def _v32_script(n=100, chars=7000):
+    script = []
+    for i in range(n):
+        content = f"// file {i}\n" + "".join(f"line {i}.{k} {'x' * 60}\n" for k in range(chars // 70))
+        script.append(("write_file", {"path": f"src/F{i}.java", "content": content}, f"call_{i}"))
+    return script
+
+
+def test_v32_shape_requests_never_exceed_the_window_and_compaction_keeps_running(monkeypatch, tmp_path):
+    agent, provider, summary_calls = _agent(monkeypatch, tmp_path, _v32_script())
+    assert agent._run_compaction.enabled and agent.context_compressor.threshold_tokens == THRESHOLD
+    with contextlib.redirect_stdout(io.StringIO()):
+        result = agent.run_conversation("work kanban task t_v32")
+    assert result["completed"] is True
+    assert len(provider.prompts) == 101
+    # Every request the provider received fitted the window with its output cap.
+    assert max(provider.prompts) + CAP <= WINDOW, max(provider.prompts)
+    guard = agent._run_compaction
+    # Compaction ran far past the old per-turn budget of 3, and summarised.
+    assert guard.passes > 3 and len(summary_calls) > 3
+    # ...but not on every request.
+    assert len(summary_calls) < len(provider.prompts) / 3
+    done = [e for e in guard.events if e.startswith("done ")]
+    assert all("summary_progress=true" in e for e in done), done
+
+
+def test_v32_shape_overcounting_provider_compacts_less(monkeypatch, tmp_path):
+    agent, provider, summary_calls = _agent(monkeypatch, tmp_path, _v32_script(), ratio=0.6)
+    with contextlib.redirect_stdout(io.StringIO()):
+        agent.run_conversation("work kanban task t_v32")
+    assert max(provider.prompts) + CAP <= WINDOW
+    (tmp_path / "b").mkdir()
+    agent2, provider2, summary_calls2 = _agent(monkeypatch, tmp_path / "b", _v32_script(), ratio=1.12)
+    with contextlib.redirect_stdout(io.StringIO()):
+        agent2.run_conversation("work kanban task t_v32")
+    assert len(summary_calls) < len(summary_calls2)
+
+
+def test_without_run_scoped_the_stock_gates_are_unchanged(monkeypatch, tmp_path):
+    compression = {k: v for k, v in Q36_COMPRESSION.items() if k != "run_scoped"}
+    agent, provider, _ = _agent(monkeypatch, tmp_path, _v32_script(n=5), compression=compression)
+    assert agent._run_compaction.enabled is False
+    with contextlib.redirect_stdout(io.StringIO()):
+        agent.run_conversation("work kanban task t_v32")
+    assert agent._run_compaction.passes == 0
+
+
+def test_no_compaction_below_the_threshold(monkeypatch, tmp_path):
+    agent, provider, summary_calls = _agent(monkeypatch, tmp_path, _v32_script(n=3, chars=2000))
+    with contextlib.redirect_stdout(io.StringIO()):
+        agent.run_conversation("work kanban task t_v32")
+    assert agent._run_compaction.passes == 0 and summary_calls == []
+
+
+# ── item 4: a pruned stub can never become file content ───────────────────
+
+
+def test_pruned_arguments_name_themselves_and_stay_stable():
+    content = "/*\n * Copyright 2016-2018\n */\n" + "class A {}\n" * 800
+    shrunk = json.loads(_truncate_tool_call_args_json(json.dumps({"path": "A.java", "content": content})))
+    assert shrunk["path"] == "A.java"
+    assert shrunk["content"].startswith(content[:200])
+    assert PRUNED_ARGUMENT_MARKER in shrunk["content"] and f"{len(content):,} chars" in shrunk["content"]
+    again = _truncate_tool_call_args_json(json.dumps(shrunk))
+    assert json.loads(again) == shrunk  # pruning a stub again changes nothing
+
+
+def test_write_file_refuses_a_pruned_stub(tmp_path):
+    from tools.file_tools import write_file_tool
+
+    target = tmp_path / "BindingErrorsResponse.java"
+    stub = json.loads(_truncate_tool_call_args_json(json.dumps({"content": "/*\n" + "x" * 5000})))["content"]
+    out = json.loads(write_file_tool(str(target), stub))
+    assert "refused" in out["error"] and "context-compression stub" in out["error"]
+    assert not target.exists()
+    # The v32 legacy stub shape: 200 characters + "...[truncated]".
+    legacy = ("/*\n * Copyright 2016-2018 the original author or authors.\n" + " *" * 80)[:200] + "...[truncated]"
+    out = json.loads(write_file_tool(str(target), legacy))
+    assert "refused" in out["error"] and not target.exists()
+
+
+def test_write_file_normal_content_is_unchanged(tmp_path):
+    from tools.file_tools import write_file_tool
+
+    target = tmp_path / "A.java"
+    body = "class A {\n  // see ...[truncated] notes below\n}\n" + "// x\n" * 200
+    out = json.loads(write_file_tool(str(target), body))
+    assert "error" not in out, out
+    assert target.read_text() == body
+
+
+def test_patch_refuses_a_pruned_stub(tmp_path):
+    from tools.file_tools import patch_tool
+
+    target = tmp_path / "A.java"
+    target.write_text("class A {}\n")
+    stub = "class A {" + " x" * 120 + " " + PRUNED_ARGUMENT_MARKER + " 9,000 chars, first 200 shown]...[truncated]"
+    out = json.loads(patch_tool(mode="replace", path=str(target), old_string="class A {}", new_string=stub))
+    assert "refused" in out["error"]
+    assert target.read_text() == "class A {}\n"
+
+
+# ── fixture replay (needs the read-only v32 session copy; not committed) ──
+
+_FIXTURE = os.environ.get("HERMES_V32_COMPRESSION_FIXTURE", "")
+_SID = "20261002_203549_30eecd"
+
+
+def _fixture_messages(path):
+    """The session's messages in order, each with the content it had when it
+    first appeared (the store archives every committed transcript)."""
+    con = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
+    con.row_factory = sqlite3.Row
+    rows = con.execute("select * from messages where session_id=? order by id", (_SID,)).fetchall()
+    seen, ordered = set(), []
+    for r in rows:
+        if (r["content"] or "").startswith("[CONTEXT COMPACTION"):
+            continue
+        key = (r["role"], round(r["timestamp"], 4), r["tool_call_id"] or "")
+        if key in seen:
+            continue
+        seen.add(key)
+        m = {"role": r["role"], "content": r["content"] or ""}
+        if r["tool_calls"]:
+            m["tool_calls"] = json.loads(r["tool_calls"])
+        if r["tool_call_id"]:
+            m["tool_call_id"] = r["tool_call_id"]
+        ordered.append((r["timestamp"], m))
+    ordered.sort(key=lambda x: x[0])
+    return [m for _, m in ordered]
+
+
+@pytest.mark.skipif(not _FIXTURE or not Path(_FIXTURE).is_file(), reason="v32 compression fixture not present")
+def test_fixture_session_replay_through_the_compressor():
+    msgs = _fixture_messages(_FIXTURE)
+    c = _compressor()
+    agent = _FakeAgent(c)
+    guard = RunCompactionGuard(enabled=True)
+    live, max_projected, requests = [], 0, 0
+    for m in msgs:
+        live.append(m)
+        if m["role"] == "assistant":
+            continue  # a request follows each user/tool step
+        decision, live = _drive(guard, agent, live)
+        assert decision == DECISION_SEND
+        requests += 1
+        rough = _request_rough(live)
+        projected = c.project_request_tokens(rough, guard.growth_margin)
+        max_projected = max(max_projected, projected)
+        c.note_request_rough_estimate(rough)
+        c.update_from_response({"prompt_tokens": int(rough * 1.12), "completion_tokens": 200})
+    print(f"\nfixture replay: {len(msgs)} messages, {requests} requests, {guard.passes} passes "
+          f"({guard.forced_passes} forced), {len(c.summary_calls)} summary calls, "
+          f"max projected request {max_projected} + cap {CAP} vs window {WINDOW}")
+    assert max_projected + CAP <= WINDOW
+    assert len(c.summary_calls) >= 1
