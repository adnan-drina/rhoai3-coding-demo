@@ -1642,13 +1646,71 @@ class ShellFileOperations(FileOperations):
                 ),
             )
 
+        clipped = self._clipped_line_report(path, read_output, offset)
+        if clipped:
+            truncated = True
+            hint = f"{hint} {clipped[1]}" if hint else clipped[1]
         return ReadResult(
             content=self._add_line_numbers(read_output, offset),
             total_lines=total_lines,
             file_size=file_size,
             truncated=truncated,
-            hint=hint
+            hint=hint,
+            clipped_lines=clipped[0] if clipped else None,
         )
+
+    # At most this many cut lines are listed one by one.
+    _CLIPPED_LINES_LISTED = 50
+
+    def _clipped_line_report(self, path: str, read_output: str, offset: int):
+        """``(entries, statement)`` for the lines of this page that
+        ``_add_line_numbers`` cuts at the per-line cap, or None when none is.
+
+        The shell pipeline already clamped each line to a byte budget, so a
+        cut line's full length is probed from the file (bytes, ``LC_ALL=C``
+        awk), only when a line was cut. The content itself is unchanged: a
+        cut line still ends with ``... [truncated]``.
+        """
+        from tools.tool_output_limits import get_max_line_length
+
+        cap = get_max_line_length()
+        numbers = [
+            n for n, line in enumerate(read_output.split("\n"), start=offset)
+            if len(line) > cap
+        ]
+        if not numbers:
+            return None
+        lengths: Dict[int, int] = {}
+        probe = (
+            f"LC_ALL=C awk -v s={numbers[0]} -v e={numbers[-1]} -v m={cap} "
+            "'NR>e {exit} NR>=s && length($0)>m {print NR\" \"length($0)}' "
+            f"{self._escape_shell_arg(path)}"
+        )
+        probe_result = self._exec(probe)
+        if probe_result.exit_code == 0:
+            for row in _strip_terminal_fence_leaks(probe_result.stdout).splitlines():
+                parts = row.split()
+                if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
+                    lengths[int(parts[0])] = int(parts[1])
+        entries = [
+            {"line": n, "length_bytes": lengths.get(n), "shown_chars": cap}
+            for n in numbers[: self._CLIPPED_LINES_LISTED]
+        ]
+        if len(numbers) == 1:
+            full = lengths.get(numbers[0])
+            what = f"Line {numbers[0]} was cut at {cap} characters" + (
+                f" of {full:,} bytes" if full else ""
+            )
+        else:
+            what = (
+                f"{len(numbers)} lines were cut at {cap} characters "
+                "(full lengths in clipped_lines)"
+            )
+        statement = (
+            f"{what}; the cut is marked '... [truncated]'. offset and limit page "
+            "by LINE, so the cut part of a line cannot be reached by paging."
+        )
+        return entries, statement
     
     def _unicode_variant_match(self, path: str) -> Optional[str]:
         """Find an existing file whose name is unicode-equivalent to ``path``.
