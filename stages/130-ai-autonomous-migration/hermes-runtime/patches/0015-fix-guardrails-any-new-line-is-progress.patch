From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "adnan.drina" <adnan.drina@gmail.com>
Date: Tue, 29 Sep 2026 01:13:36 +0200
Subject: [PATCH] fix(guardrails): any new line is progress in the
 near-duplicate guard

RHOAI3 v24 (2026-09-29): the near-duplicate guard (0014) halted a worker paging a
143K section whose pages each showed new diagnostic lines, and would halt paging
that yields one new diagnostic per page, reporting both as "no new output". A
call now makes progress when it shows at least min_new_lines (1) line not shown
before since the last edit or transition. Identifiers, digests and timestamps
the tool printed are content: a page of distinct artifact SHA-256s is new
information. Only the runtime's own appended notices (loop warnings, hard stops,
identical-call notes) are excluded, and the terminal envelope is read even when
such notices follow it, so a changing notice count is never new output. Exact
repetitions and unchanged-output loops still halt as near_duplicate_loop_halt.
---
 agent/tool_guardrails.py                      | 42 +++++++--
 .../test_tool_guardrails_near_duplicate.py    | 88 ++++++++++++++++++-
 2 files changed, 121 insertions(+), 9 deletions(-)

diff --git a/agent/tool_guardrails.py b/agent/tool_guardrails.py
index 4fca31b..9b1e0c2 100644
--- a/agent/tool_guardrails.py
+++ b/agent/tool_guardrails.py
@@ -249,6 +249,14 @@ class NearDuplicateConfig:
       of its output lines were not shown since the last edit or transition.
       A call that names a new operand (query term, literal or path) makes
       progress whatever its output.
+    - ``min_new_lines``: a call that shows at least this many lines not shown
+      before also makes progress, whatever their share (RHOAI3 v24: a page of
+      850 lines with 26 new diagnostic lines, and pages that each added ONE new
+      diagnostic, were halted as "no new output"). Default 1: any new line is
+      information, including identifiers, digests and timestamps the tool
+      printed. Only the runtime's own appended notices (loop warnings, hard
+      stops, identical-call notes) are excluded, so a changing notice count is
+      never new output; exact repetitions and unchanged-output loops still halt.
     """
 
     enabled: bool = True
@@ -259,6 +267,7 @@ class NearDuplicateConfig:
     warn_after: int = 8
     similarity: float = 0.75
     new_output_share: float = 0.5
+    min_new_lines: int = 1
 
     @classmethod
     def from_mapping(cls, data: Mapping[str, Any] | None) -> "NearDuplicateConfig":
@@ -276,6 +285,7 @@ class NearDuplicateConfig:
             warn_after=_positive_int(data.get("warn_after"), d.warn_after),
             similarity=_unit_float(data.get("similarity"), d.similarity),
             new_output_share=_unit_float(data.get("new_output_share"), d.new_output_share),
+            min_new_lines=_positive_int(data.get("min_new_lines"), d.min_new_lines),
         )
 
 
@@ -828,7 +838,8 @@ class ToolCallGuardrailController:
             if digest not in self._nd_seen:
                 self._nd_seen.add(digest)
                 new += 1
-        progressing = novel or (bool(lines) and new > cfg.new_output_share * len(lines))
+        progressing = novel or (bool(lines) and (new > cfg.new_output_share * len(lines) or new >= cfg.min_new_lines))
+        novelty = "progress" if progressing else "none"
         entry = _NearDuplicateCall(
             tool_name=tool_name,
             tokens=shape,
@@ -837,6 +848,7 @@ class ToolCallGuardrailController:
             exact=exact,
             operands=operands,
             head=head,
+            novelty=novelty,
         )
         self._nd_history.append(entry)
         keep = max(cfg.window, cfg.cycle_laps * cfg.max_cycle_period)
@@ -852,6 +864,8 @@ class ToolCallGuardrailController:
         ]
         count = len(similar)
         loop = ""
+        code = NEAR_DUPLICATE_HALT_CODE
+        counted = similar
         if count >= cfg.similar_calls:
             loop = (
                 f"{count} of the last {min(len(history), cfg.window)} {tool_name} calls "
@@ -863,17 +877,20 @@ class ToolCallGuardrailController:
                 if laps >= cfg.cycle_laps:
                     members = "; ".join(e.description for e in history[-period:])
                     count = laps
+                    counted = history[-min(len(history), laps * period):]
                     loop = (
                         f"a cycle of {period} near-duplicate calls was repeated "
                         f"{laps} times ({members})"
                     )
                     break
+        zero = sum(1 for e in counted if e.novelty == "none")
         if loop and self.config.hard_stop_enabled:
             decision = ToolGuardrailDecision(
                 action="halt",
                 code=NEAR_DUPLICATE_HALT_CODE,
                 message=(
-                    f"Stopped {tool_name}: {loop}, with no new output, no file edit "
+                    f"Stopped {tool_name}: {loop}; {zero} of them showed no new output "
+                    "(incidental timestamps, durations and digests aside), with no file edit "
                     "and no board transition in between. Only numbers, a growing "
                     "quoted argument or a chained part changed between these "
                     "calls, and none of them asked about a new term or file, so "
@@ -902,7 +919,7 @@ class ToolCallGuardrailController:
                 action="warn",
                 code=NEAR_DUPLICATE_WARN_CODE,
                 message=(
-                    f"{loop}, with no new output and no edit in between. This "
+                    f"{loop}, with little or no new output and no edit in between. This "
                     "looks like a loop: use what was already shown, make the "
                     "change, or stop."
                 ),
@@ -1706,17 +1723,31 @@ def _parse_read_command(command: str) -> _ParsedRead | None:
     return _ParsedRead(family_tokens, is_search, context, patterns, files)
 
 
+# Notices the RUNTIME appends to a tool result (loop warnings, hard stops, identical-call
+# notes). They carry changing counts and are not the tool's output, so they are never new
+# information. Only these recognized runtime lines are excluded; everything the tool itself
+# printed -- identifiers, digests, timestamps -- keeps its content (RHOAI3 v24 review: a page
+# of distinct artifact SHA-256s is new information, not incidental metadata).
+_RUNTIME_NOTICE = re.compile(r"^\[(hermes note:|Tool loop (warning|hard stop):)")
+
+
 def _result_content_lines(result: str | None) -> list:
     """Output lines a read showed (terminal envelope ``output``), minus grep
-    group separators and the runtime's truncation notice."""
+    group separators, the runtime's truncation notice and the runtime's own
+    appended notices. The envelope is read even when notices follow it."""
     text = result or ""
     parsed = safe_json_loads(text)
+    if not isinstance(parsed, dict) and text.lstrip().startswith("{"):
+        try:
+            parsed, _end = json.JSONDecoder().raw_decode(text.lstrip())
+        except ValueError:
+            parsed = None
     if isinstance(parsed, dict) and isinstance(parsed.get("output"), str):
         text = parsed["output"]
     lines = []
     for raw in text.splitlines():
         line = raw.rstrip()
-        if not line or line == "--" or _TRUNCATION_NOTICE.match(line.strip()):
+        if not line or line == "--" or _TRUNCATION_NOTICE.match(line.strip()) or _RUNTIME_NOTICE.match(line.strip()):
             continue
         lines.append(line)
     return lines
@@ -1777,6 +1808,7 @@ class _NearDuplicateCall:
     exact: tuple = ()  # digit runs as ``#``, quoted text kept
     operands: tuple = ()  # query terms, literals and paths, digit-normalised
     head: tuple = ()  # exact tokens of the first chain element
+    novelty: str = "none"  # "progress" or "none" (no new line, incidental tokens masked)
 
 
 def _shell_tokens(command: str) -> list:
diff --git a/tests/agent/test_tool_guardrails_near_duplicate.py b/tests/agent/test_tool_guardrails_near_duplicate.py
index 758a634..e80f1b9 100644
--- a/tests/agent/test_tool_guardrails_near_duplicate.py
+++ b/tests/agent/test_tool_guardrails_near_duplicate.py
@@ -120,8 +120,13 @@ def test_sed_window_walk_run37_halts():
         calls.append(window(45, 80))
         calls.extend(window(n, n + 5) for n in range(45, 0, -1))
     index, halt, _ = _replay(_hard_stop(), calls)
+    # Each window of the first walk shows one source line not shown before: new
+    # information, so the walk is not stopped (RHOAI3 v24 review: legitimate
+    # paging that yields one new line per page must not halt). The loop is the
+    # second walk over windows already shown: it halts twelve calls into it.
+    first_walk = 1 + 45
     assert halt is not None and halt.code == NEAR_DUPLICATE_HALT_CODE
-    assert index <= 13
+    assert first_walk <= index <= first_walk + 12
 
 
 def test_widening_context_run39_halts_when_it_keeps_widening():
@@ -136,11 +141,14 @@ def test_widening_context_run39_halts_when_it_keeps_widening():
     # The seven logged calls alone stay under the threshold ...
     index, halt, _ = _replay(_hard_stop(), [before(n) for n in series])
     assert halt is None
-    # ... the loop halts once the widening goes on without new output.
-    more = [2000, 3000, 5000, 10000, 20000, 50000, 100000, 200000]
+    # ... the loop halts once the widening goes on without new output. Each of
+    # the seven logged widenings showed at least three records not shown before
+    # (RHOAI3 v24 review: new facts are progress however small their share), so
+    # the count starts when the output stops changing: twelve unchanged widenings.
+    more = [2000 * (k + 1) for k in range(14)]
     index, halt, _ = _replay(_hard_stop(), [before(n) for n in series + more])
     assert halt is not None and halt.code == NEAR_DUPLICATE_HALT_CODE
-    assert index <= 13
+    assert index <= len(series) + 12 - 1 + 1
 
 
 def test_exact_alternation_run44_halts_even_when_each_call_shows_its_lines():
@@ -391,3 +399,75 @@ def test_terminal_write_classifier():
     ]
     assert all(_terminal_command_mutates(c) for c in writes), [c for c in writes if not _terminal_command_mutates(c)]
     assert not any(_terminal_command_mutates(c) for c in reads), [c for c in reads if _terminal_command_mutates(c)]
+
+
+# ── RHOAI3 v24 review (2026-09-29): low novelty is not zero novelty ──────
+
+
+def test_dao_growing_pages_with_new_diagnostics_do_not_halt():
+    """v24 DAO run 23: grep -A<n> over a 143K items section; each page repeats
+    most of the last one and adds 20-30 new diagnostic lines."""
+    records = [f'"detail": "cannot find symbol DataAccessException", "id": "err:{i:04x}", "line": {i}' for i in range(2000)]
+    calls = []
+    for k in range(1, 30):
+        n = 30 * k
+        calls.append(_term(f'python3 brief.py --section items | grep -A{n} "EmptyResultDataAccessException"', "\n".join(records[:n])))
+    index, halt, _ = _replay(_hard_stop(), calls)
+    assert halt is None, (index, halt)
+
+
+def test_distinct_artifact_ids_are_new_output():
+    """RHOAI3 v24 review: pages of a frozen artifact list, each with a different
+    SHA-256, are new information; an identifier the tool printed is never masked."""
+    base = [f"artifact field {i}" for i in range(35)]
+    calls = []
+    for k in range(25):
+        digest = "%064x" % (0xabc123 + k * 7919)
+        calls.append(_term(f"sed -n '{k + 1},{k + 36}p' artifacts.txt", "\n".join(base + [f"artifact {k} sha256={digest}"])))
+    index, halt, _ = _replay(_hard_stop(), calls)
+    assert halt is None, (index, halt)
+
+
+def test_runtime_notices_alone_are_not_new_output():
+    """Only the runtime's own appended notices are incidental: the same tool
+    output with a changing loop-warning count still halts."""
+    calls = []
+    for k in range(20):
+        envelope = json.dumps({"output": "BUILD FAILURE\n[ERROR] Pet.java:[42,8] cannot find symbol", "exit_code": 1, "error": None})
+        notice = (f"\n\n[Tool loop warning: near_duplicate_loop_warning; count={k}; {k} of the last 16 terminal calls "
+                  f"were near-duplicates]\n\n[hermes note: this is the {k}th consecutive identical call]")
+        calls.append(("terminal", {"command": f"mvn -q compile | head -{10 + k % 3}"}, envelope + notice))
+    index, halt, _ = _replay(_hard_stop(), calls)
+    assert halt is not None and halt.code in (NEAR_DUPLICATE_HALT_CODE, "read_family_no_new_content_halt")
+
+
+def test_unchanged_pom_grep_still_halts():
+    """v24 controller run 27: pom greps whose output stopped changing."""
+    calls = []
+    for k in range(20):
+        calls.append(_term(f'grep -A{5 + k % 3} "quarkus-rest" pom.xml | head -{10 + k % 2}', "<artifactId>quarkus-rest</artifactId>\n<artifactId>quarkus-rest-jackson</artifactId>"))
+    index, halt, _ = _replay(_hard_stop(), calls)
+    # whichever unchanged-output guard fires first (0012's read-family guard here), it still stops
+    assert halt is not None and halt.code in (NEAR_DUPLICATE_HALT_CODE, "read_family_no_new_content_halt")
+    assert index <= 12
+
+
+def test_five_identical_reads_still_halt():
+    calls = [_term('grep -E "RootRestController" build.out', "") for _ in range(8)]
+    controller = _hard_stop()
+    halted = None
+    for index, (tool, args, result) in enumerate(calls):
+        decision = controller.after_call(tool, args, result, failed=False)
+        controller.observe_call(tool, args, result)
+        if decision.should_halt or controller.halt_decision is not None:
+            halted = index
+            break
+    assert halted is not None and halted <= 5
+
+
+def test_one_new_diagnostic_per_page_does_not_halt():
+    """The audit's regression (v24): each page repeats the last one and adds ONE new diagnostic."""
+    rows = [f"[ERROR] src/main/java/a/S{i}.java:[{i},8] cannot find symbol" for i in range(60)]
+    calls = [_term(f"python3 brief.py --section items | head -{20 + k}", "\n".join(rows[:20 + k])) for k in range(40)]
+    index, halt, _ = _replay(_hard_stop(), calls)
+    assert halt is None, (index, halt)
