+@pytest.mark.parametrize("provider", ["custom:qwen27b", "custom"])
+def test_escalated_body_after_third_identical_call_normal_before(monkeypatch, provider):
+    agent, fake = _agent(
+        monkeypatch,
+        _loop_script([
+            _tool_response("terminal", {"command": "cat pom.xml"}, "esc_1"),
+            _tool_response("write_file", {"path": "src/A.java", "content": "x"}, "edit_1"),
+            _text_response(),
+        ]),
+        provider=provider,
+    )
+    agent.run_conversation("fix it")
+
+    reqs = fake.requests
+    assert len(reqs) == 6
+    # Requests 1-3 precede the third note: the normal body, unchanged.
+    assert all(_is_normal(r) for r in reqs[:3]), [r.get("extra_body") for r in reqs[:3]]
+    # Requests 4-5 are escalated (the read in turn 1 ends nothing).
+    assert _is_escalated(reqs[3]) and _is_escalated(reqs[4])
+    assert reqs[3]["extra_body"]["chat_template_kwargs"]["reasoning_effort"] == "xhigh"
+    # The write_file ended it: request 6 is normal again.
+    assert _is_normal(reqs[5])
+    snap = agent._loop_escalation.snapshot()
+    assert snap["active"] is False and snap["last_end_reason"] == "edit"
+    assert snap["started"] == 1
+    assert snap["trigger"]["tool"] == "terminal" and len(snap["trigger"]["args_digest"]) == 16
+    assert snap["events"] == ["start", "turn:1", "turn:2", "end:edit"]
+    # The configured bodies were not mutated.
+    assert agent.request_overrides["extra_body"] == NORMAL_BODY
