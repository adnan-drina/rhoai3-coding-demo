+def test_turn_cap_ends_escalation_and_guard_still_halts_on_fifth_call(monkeypatch, caplog):
+    name, args = LOOP_CALL
+    providers = {"qwen27b": {"loop_escalation": _escalation_block(max_turns=1)}}  # provider-wide
+    agent, fake = _agent(
+        monkeypatch,
+        _loop_script([
+            _tool_response(name, args, "loop_4"),  # escalated turn 1/1
+            _tool_response(name, args, "loop_5"),  # normal again: 5th identical call
+            _text_response("should not be reached"),
