diff --git a/agent/loop_escalation.py b/agent/loop_escalation.py
new file mode 100644
index 0000000..bac71e0
--- /dev/null
+++ b/agent/loop_escalation.py
@@ -0,0 +1,280 @@
+"""Per-worker loop escalation to a thinking request profile.
+
+When the identical-call stall guard emits its notice for the THIRD
+consecutive identical call (``STALL_GUARD_IDENTICAL_CALL_THRESHOLD``), the
+worker's following model requests use an escalation request body taken from
+the active provider's config instead of the normal one. Escalation ends at
+the first of:
+
+* an edit: a ``write_file`` / ``patch`` call, or a ``terminal`` command that
+  writes (``sed -i``, ``> src/``, ``tee src/``);
+* a verification: a ``terminal`` command naming ``run-verify.sh`` or
+  ``advance.py``;
+* ``max_turns`` escalated model requests (the cap).
+
+After any of these the normal body is sent again. The guardrails are not
+touched: the identical-call streak keeps counting and can still halt.
+
+Config (read from the raw ``providers:`` section; absent or disabled means no
+behaviour change)::
+
+    providers:
+      <provider>:
+        loop_escalation: {...}          # provider-wide fallback
+        models:
+          <model>:
+            loop_escalation:            # wins over the provider-wide block
+              enabled: true
+              max_turns: 8
+              request_body: {...}       # replaces extra_body; max_tokens is the output cap
+
+Every transition is written to agent.log with the ``[loop-escalation]``
+prefix (start, turn k/N, end reason=..., cap-hit).
+"""
+
+from __future__ import annotations
+
+import copy
+import logging
+import os
+import re
+from dataclasses import dataclass, field
+from typing import Any, Mapping
+
+logger = logging.getLogger(__name__)
+
+LOG_PREFIX = "[loop-escalation]"
+DEFAULT_MAX_TURNS = 8
+
+EDIT_TOOLS = frozenset({"write_file", "patch"})
+# A terminal command that writes source: in-place sed, a redirect into src/,
+# or tee into src/.
+_TERMINAL_EDIT_RE = re.compile(
+    r"\bsed\s+(?:-[^\s]*\s+)*-i|>\s*src/|\btee\s+(?:-[^\s]+\s+)*src/"
+)
+_TERMINAL_VERIFY_RE = re.compile(r"run-verify\.sh|advance\.py")
+
+
+@dataclass(frozen=True)
+class LoopEscalationConfig:
+    enabled: bool = False
+    max_turns: int = DEFAULT_MAX_TURNS
+    request_body: dict = field(default_factory=dict)
+
+    @classmethod
+    def from_mapping(cls, data: Any) -> "LoopEscalationConfig | None":
+        """Return the config for one ``loop_escalation`` block, or None when
+        the block is absent, disabled or carries no request body."""
+        if not isinstance(data, Mapping):
+            return None
+        enabled = data.get("enabled", True)
+        if isinstance(enabled, str):
+            enabled = enabled.strip().lower() in {"1", "true", "yes", "on"}
+        if not enabled:
+            return None
+        body = data.get("request_body")
+        if not isinstance(body, Mapping) or not body:
+            return None
+        max_turns = data.get("max_turns", DEFAULT_MAX_TURNS)
+        try:
+            max_turns = DEFAULT_MAX_TURNS if isinstance(max_turns, bool) else int(max_turns)
+        except (TypeError, ValueError):
+            max_turns = DEFAULT_MAX_TURNS
+        if max_turns < 1:
+            max_turns = DEFAULT_MAX_TURNS
+        return cls(enabled=True, max_turns=max_turns, request_body=copy.deepcopy(dict(body)))
+
+
+def _norm(name: Any) -> str:
+    return str(name or "").strip().lower().replace(" ", "-")
+
+
+def _lookup(mapping: Mapping, key: str) -> Any:
+    if not isinstance(mapping, Mapping) or not key:
+        return None
+    if key in mapping:
+        return mapping[key]
+    for k, v in mapping.items():
+        if _norm(k) == _norm(key):
+            return v
+    return None
+
+
+def resolve_config(
+    providers: Any, provider: str, model: str, default_provider: str = ""
+) -> LoopEscalationConfig | None:
+    """``providers.<provider>.models.<model>.loop_escalation``, falling back to
+    ``providers.<provider>.loop_escalation``. ``custom:<key>`` resolves to
+    ``<key>``; a bare ``custom`` runtime provider resolves to the configured
+    ``model.provider``."""
+    if not isinstance(providers, Mapping) or not providers:
+        return None
+    candidates = []
+    p = _norm(provider)
+    if p.startswith("custom:"):
+        candidates.append(p.split(":", 1)[1])
+    if p and p != "custom":
+        candidates.append(p)
+    d = _norm(default_provider)
+    if d.startswith("custom:"):
+        d = d.split(":", 1)[1]
+    if d and (p in {"", "custom"} or not candidates):
+        candidates.append(d)
+    for key in candidates:
+        entry = _lookup(providers, key)
+        if not isinstance(entry, Mapping):
+            continue
+        models = entry.get("models")
+        if isinstance(models, Mapping):
+            meta = _lookup(models, str(model or ""))
+            if isinstance(meta, Mapping) and "loop_escalation" in meta:
+                return LoopEscalationConfig.from_mapping(meta.get("loop_escalation"))
+        return LoopEscalationConfig.from_mapping(entry.get("loop_escalation"))
+    return None
+
+
+def classify_end_call(tool_name: str, args: Any) -> str | None:
+    """``edit`` / ``verification`` when this executed call ends an escalation."""
+    if tool_name in EDIT_TOOLS:
+        return "edit"
+    if tool_name != "terminal" or not isinstance(args, Mapping):
+        return None
+    command = args.get("command")
+    if not isinstance(command, str):
+        return None
+    if _TERMINAL_VERIFY_RE.search(command):
+        return "verification"
+    if _TERMINAL_EDIT_RE.search(command):
+        return "edit"
+    return None
+
+
+class LoopEscalation:
+    """Escalation state of one worker (one AIAgent)."""
+
+    def __init__(self, providers: Any = None, default_provider: str = ""):
+        self._providers = providers if isinstance(providers, Mapping) else {}
+        self._default_provider = default_provider or ""
+        self.reset()
+
+    # ── state ────────────────────────────────────────────────────────
+    def reset(self) -> None:
+        self.active = False
+        self.turns = 0
+        self.max_turns = 0
+        self.config: LoopEscalationConfig | None = None
+        self.started = 0
+        self.last_end_reason = ""
+        self.request_escalated = False
+        self.trigger: dict = {}
+        self.events: list = []
+
+    def snapshot(self) -> dict:
+        return {
+            "active": self.active,
+            "turns": self.turns,
+            "max_turns": self.max_turns,
+            "started": self.started,
+            "last_end_reason": self.last_end_reason,
+            "request_escalated": self.request_escalated,
+            "trigger": dict(self.trigger),
+            "events": list(self.events),
+        }
+
+    def config_for(self, provider: str, model: str) -> LoopEscalationConfig | None:
+        try:
+            return resolve_config(self._providers, provider, model, self._default_provider)
+        except Exception as exc:  # never break a request over config shape
+            logger.debug("%s config ignored: %s", LOG_PREFIX, exc)
+            return None
+
+    def _log(self, event: str, line: str) -> None:
+        self.events.append(event)
+        logger.info("%s %s", LOG_PREFIX, line)
+
+    # ── transitions ──────────────────────────────────────────────────
+    def on_tool_result(
+        self,
+        tool_name: str,
+        args: Any,
+        *,
+        third_note: bool,
+        args_digest: str = "",
+        provider: str = "",
+        model: str = "",
+        task_id: str = "",
+    ) -> None:
+        """Observe one executed tool call (after the guardrail observation)."""
+        if self.active:
+            reason = classify_end_call(tool_name, args)
+            if reason:
+                self.end(reason)
+        if third_note and not self.active:
+            cfg = self.config_for(provider, model)
+            if cfg is None:
+                return
+            self.active = True
+            self.turns = 0
+            self.max_turns = cfg.max_turns
+            self.config = cfg
+            self.started += 1
+            self.trigger = {"task": task_id, "tool": tool_name, "args_digest": args_digest}
+            self._log(
+                "start",
+                f"start task={task_id or '-'} tool={tool_name} args={args_digest or '-'} "
+                f"max_turns={cfg.max_turns}",
+            )
+
+    def end(self, reason: str) -> None:
+        if not self.active:
+            return
+        self.active = False
+        self.last_end_reason = reason
+        self._log(f"end:{reason}", f"end reason={reason} turns={self.turns}/{self.max_turns}")
+        self.turns = 0
+        self.config = None
+
+    def begin_request(self) -> bool:
+        """Called once per model request (loop iteration, not per retry).
+        Returns whether this request is escalated."""
+        if self.active and self.turns >= self.max_turns:
+            self.end("cap")
+        if self.active:
+            self.turns += 1
+            self._log(f"turn:{self.turns}", f"turn {self.turns}/{self.max_turns}")
+        self.request_escalated = self.active
+        return self.request_escalated
+
+    def observe_finish(self, finish_reason: str) -> None:
+        """Log an escalated response that stopped on the output cap, before the
+        runtime discards the truncated response."""
+        if self.request_escalated and finish_reason == "length":
+            self._log(
+                "cap-hit",
+                f"cap-hit turn {self.turns}/{self.max_turns} finish_reason=length",
+            )
+
+    def request_shape(
+        self, request_overrides: Any, max_tokens: Any, provider: str, model: str
+    ) -> tuple:
+        """Return (request_overrides, max_tokens) for the request being built.
+
+        Normal requests get the inputs unchanged. An escalated request gets the
+        escalation body as ``extra_body`` (replacing the normal one) and its
+        ``max_tokens`` (when given) as the output cap."""
+        if not (self.active and self.request_escalated):
+            return request_overrides, max_tokens
+        cfg = self.config_for(provider, model)
+        if cfg is None:  # the active provider has no escalation profile
+            return request_overrides, max_tokens
+        body = copy.deepcopy(cfg.request_body)
+        cap = body.pop("max_tokens", None)
+        overrides = dict(request_overrides or {})
+        overrides["extra_body"] = body
+        if isinstance(cap, int) and not isinstance(cap, bool) and cap > 0:
+            max_tokens = cap
+        return overrides, max_tokens
+
+
+def current_task_id(agent: Any) -> str:
+    return os.environ.get("HERMES_KANBAN_TASK", "") or str(getattr(agent, "_current_task_id", "") or "")
