@@ -0,0 +1,416 @@
+"""Loop escalation to a thinking request profile (agent/loop_escalation.py).
+
+A fake provider records every request's kwargs. The model repeats one
+identical terminal call three times; the third identical-call note starts an
+escalation, and the following requests carry the configured escalation body
+until an edit, a verification command or the turn cap ends it.
+"""
+
+import copy
+import json
+import logging
+from types import SimpleNamespace
+
+import pytest
+
+from agent.loop_escalation import (
+    LOG_PREFIX,
+    LoopEscalation,
+    LoopEscalationConfig,
+    classify_end_call,
+    resolve_config,
+)
+from agent.tool_guardrails import ToolCallGuardrailConfig, ToolCallGuardrailController
+
+NORMAL_BODY = {
+    "chat_template_kwargs": {"enable_thinking": False},
+    "min_p": 0.0,
+    "presence_penalty": 1.5,
+    "repetition_penalty": 1.0,
+    "temperature": 0.7,
+    "top_k": 20,
+    "top_p": 0.8,
+    "normal_only_marker": 1,
+}
+ESCALATION_BODY = {
+    "temperature": 1.0,
+    "top_p": 0.95,
+    "top_k": 20,
+    "min_p": 0.0,
+    "presence_penalty": 0.0,
+    "repetition_penalty": 1.0,
+    "max_tokens": 8192,
+    "chat_template_kwargs": {
+        "enable_thinking": True,
+        "preserve_thinking": True,
+        "reasoning_effort": "xhigh",
+    },
+}
+ESCALATED_EXTRA_BODY = {k: v for k, v in ESCALATION_BODY.items() if k != "max_tokens"}
+NORMAL_MAX_TOKENS = 4096  # differs from the escalation cap so the switch is visible
+LOOP_CALL = ("terminal", {"command": "ls build"})
+
+
+def _escalation_block(max_turns=8, enabled=True):
+    return {"enabled": enabled, "max_turns": max_turns, "request_body": copy.deepcopy(ESCALATION_BODY)}
+
+
+# ── fake provider ───────────────────────────────────────────────────────
+
+
+def _tool_response(name, args, call_id, reasoning_content=None, finish_reason="tool_calls"):
+    msg = SimpleNamespace(
+        content=None,
+        reasoning=None,
+        tool_calls=[
+            SimpleNamespace(
+                id=call_id,
+                type="function",
+                function=SimpleNamespace(name=name, arguments=json.dumps(args)),
+            )
+        ],
+    )
+    if reasoning_content is not None:
+        msg.reasoning_content = reasoning_content
+    return SimpleNamespace(
+        choices=[SimpleNamespace(message=msg, finish_reason=finish_reason)], usage=None
+    )
+
+
+def _text_response(text="done", finish_reason="stop"):
+    return SimpleNamespace(
+        choices=[
+            SimpleNamespace(
+                message=SimpleNamespace(content=text, reasoning=None, tool_calls=[]),
+                finish_reason=finish_reason,
+            )
+        ],
+        usage=None,
+    )
+
+
+class _FakeCompletions:
+    """Returns the scripted responses in order; records each request's kwargs."""
+
+    def __init__(self, script):
+        self.script = list(script)
+        self.requests = []
+
+    def create(self, **kwargs):
+        self.requests.append(copy.deepcopy(kwargs))
+        if self.script:
+            return self.script.pop(0)
+        return _text_response()
+
+
+def _loop_script(after):
+    """Three identical calls, then ``after`` (responses for escalated turns on)."""
+    name, args = LOOP_CALL
+    return [_tool_response(name, args, f"loop_{i}") for i in range(1, 4)] + list(after)
+
+
+def _results(name, args, task_id=None, **_kw):
+    if name == "terminal":
+        return json.dumps({"output": f"out of {args.get('command')}\n", "exit_code": 0})
+    if name == "write_file":
+        return json.dumps({"success": True, "path": args.get("path")})
+    return json.dumps({"ok": True})
+
+
+def _agent(monkeypatch, script, *, provider="custom:qwen27b", providers=None,
+           hard_stop=False, reasoning_echo=False):
+    from run_agent import AIAgent
+
+    completions = _FakeCompletions(script)
+    client = SimpleNamespace(chat=SimpleNamespace(completions=completions))
+    monkeypatch.setattr("run_agent.OpenAI", lambda **kwargs: client)
+    monkeypatch.setattr(
+        "run_agent.get_tool_definitions",
+        lambda *a, **k: [
+            {"type": "function", "function": {"name": n, "description": n,
+                                              "parameters": {"type": "object", "properties": {}}}}
+            for n in ("terminal", "write_file", "patch", "read_file")
+        ],
+    )
+    monkeypatch.setattr("run_agent.handle_function_call", _results)
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+
+    agent = AIAgent(
+        model="qwen3-6-27b",
+        provider=provider,
+        api_key="test-key",
+        base_url="http://localhost:8080/v1",
+        platform="cli",
+        max_iterations=20,
+        quiet_mode=True,
+        skip_memory=True,
+    )
+    agent._disable_streaming = True
+    agent.request_overrides = {"extra_body": copy.deepcopy(NORMAL_BODY)}
+    agent.max_tokens = NORMAL_MAX_TOKENS
+    agent._tool_guardrails = ToolCallGuardrailController(
+        ToolCallGuardrailConfig(hard_stop_enabled=hard_stop, no_progress_block_after=5)
+    )
+    if providers is None:
+        providers = {"qwen27b": {"models": {"qwen3-6-27b": {"loop_escalation": _escalation_block()}}}}
+    agent._loop_escalation = LoopEscalation(providers, "qwen27b")
+    agent._reasoning_echo_flag = reasoning_echo
+    agent._thinking_pad_cache = None
+    return agent, completions
+
+
+def _max_tokens(kwargs):
+    return kwargs.get("max_tokens", kwargs.get("max_completion_tokens"))
+
+
+def _is_normal(kwargs):
+    eb = kwargs.get("extra_body") or {}
+    return (
+        eb.get("normal_only_marker") == 1
+        and eb.get("chat_template_kwargs") == {"enable_thinking": False}
+        and _max_tokens(kwargs) == NORMAL_MAX_TOKENS
+    )
+
+
+def _is_escalated(kwargs):
+    eb = kwargs.get("extra_body") or {}
+    return (
+        "normal_only_marker" not in eb
+        and all(eb.get(k) == v for k, v in ESCALATED_EXTRA_BODY.items())
+        and "max_tokens" not in eb
+        and _max_tokens(kwargs) == 8192
+        and "reasoning_effort" not in kwargs  # travels inside chat_template_kwargs only
+    )
+
