-    A halted worker makes no further model request, so it can never call
-    ``kanban_complete`` / ``kanban_block``; without this record its clean
-    exit is classified by the dispatcher as a protocol violation whose
-    retry guidance tells the next worker to verify and complete. Mirrors
-    ``_record_kanban_budget_exhausted``: the failure goes through
-    ``_record_task_failure`` so it counts toward the task's ``max_retries``
-    / ``kanban.failure_limit`` circuit breaker, and the run is closed with
-    the halt reason. No raw tool arguments are recorded, only their hash.
-    No-op when the task is no longer running or the run is not ours.
+def _record_kanban_worker_stop(
+    kanban_task: str,
+    error: str,
+    logger: logging.Logger,
+    *,
+    event_payload_extra: dict | None = None,
+) -> bool:
+    """Close this worker's kanban run as failed with a named stop reason.
+
+    Shared by every runtime stop that ends a worker turn without a board
+    transition (tool-loop guardrail halt, incomplete model output, persistent
+    provider rate limit). A worker in that state makes no further model
+    request, so it can never call ``kanban_complete`` / ``kanban_block``;
+    without this record its clean exit is classified by the dispatcher as a
+    protocol violation whose retry guidance tells the next worker to verify
+    and complete. Mirrors ``_record_kanban_budget_exhausted``: the failure
+    goes through ``_record_task_failure`` so it counts toward the task's
+    ``max_retries`` / ``kanban.failure_limit`` circuit breaker and the run is
+    closed with the reason. No-op (returns False) for a delegated child or an
+    in-process cron job (they do not own the task), when the task is no
+    longer running, or when the open run is not this worker's.
     """
     try:
+        from agent.delegation_context import is_dispatcher_owned_worker_context
+
+        if not is_dispatcher_owned_worker_context():
+            return False
         from hermes_cli import kanban_db as _kb
 
         _conn = _kb.connect()
@@ -139,28 +152,21 @@ def _record_kanban_guardrail_halt(kanban_task: str, decision, logger: logging.Lo
                 (kanban_task,),
             ).fetchone()
             if row is None or row["status"] != "running":
-                return
+                return False
             expected_run = (os.environ.get("HERMES_KANBAN_RUN_ID") or "").strip()
             if expected_run and str(row["current_run_id"]) != expected_run:
-                return
-            signature = getattr(decision, "signature", None)
-            args_hash = getattr(signature, "args_hash", "") or ""
+                return False
             _kb._record_task_failure(
                 _conn,
                 kanban_task,
-                error=(
-                    f"STOP WORKER_TOOL_LOOP: tool {decision.tool_name}, "
