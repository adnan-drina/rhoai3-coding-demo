+
+def _record_kanban_guardrail_halt(kanban_task: str, decision, logger: logging.Logger) -> None:
+    """Record a tool-loop guardrail halt as a failed kanban run.
+
+    No raw tool arguments are recorded, only their hash.
+    """
+    signature = getattr(decision, "signature", None)
+    args_hash = getattr(signature, "args_hash", "") or ""
+    _record_kanban_worker_stop(
+        kanban_task,
+        (
+            f"STOP WORKER_TOOL_LOOP: tool {decision.tool_name}, "
+            f"guardrail {decision.code}, count {decision.count}, "
+            f"args_sha256 {args_hash[:16]} — the worker was halted "
+            "before another model request; this run did not "
+            "complete the task"
+        ),
+        logger,
+        event_payload_extra={"guardrail": decision.to_metadata()},
+    )
+
+
+def record_kanban_turn_stop(agent, result) -> bool:
+    """Record a turn that ended early on a model/transport stop (kanban workers).
+
+    ``run_conversation`` returns directly (without ``finalize_turn``) when the
+    model output stays incomplete after the bounded recovery, so those turns
+    are recorded here, from ``AIAgent.run_conversation``. Only results that
+    carry an explicit machine-readable stop marker are recorded; every other
+    result is left to the existing paths.
+    """
+    kanban_task = (os.environ.get("HERMES_KANBAN_TASK") or "").strip()
+    if not kanban_task or not isinstance(result, dict):
+        return False
+    if result.get("completed") or result.get("interrupted"):
+        return False
+    logger = logging.getLogger("agent.conversation_loop")
+    kind = result.get("incomplete_output")
+    if kind:
+        cap = getattr(agent, "max_tokens", None) or "default"
+        return _record_kanban_worker_stop(
+            kanban_task,
+            (
+                f"STOP MODEL_OUTPUT_INCOMPLETE: finish_reason=length ({kind}), "
+                f"output_cap={cap}, recovery exhausted; no partial tool call "
+                "was executed and this run did not complete the task"
+            ),
+            logger,
+            event_payload_extra={"incomplete_output": kind, "output_cap": cap},
+        )
+    return False
 
 
