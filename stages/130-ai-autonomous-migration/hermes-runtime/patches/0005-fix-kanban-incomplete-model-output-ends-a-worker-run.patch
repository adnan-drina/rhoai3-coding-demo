@@ -168,10 +174,64 @@ def _record_kanban_guardrail_halt(kanban_task: str, decision, logger: logging.Lo
                 pass
     except Exception:
         logger.warning(
-            "Failed to record guardrail-halt failure for task %s",
+            "Failed to record worker stop for task %s: %s",
             kanban_task,
