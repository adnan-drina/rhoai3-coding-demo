+    def _observe_near_duplicate(
+        self,
+        tool_name: str,
+        args: Mapping[str, Any],
+        result: str | None,
+    ) -> ToolGuardrailDecision | None:
+        """Near-duplicate loop guard over terminal and read calls (RHOAI3 V21).
+
+        The identical-call guard keys on byte-identical arguments and the
+        read-family/read-cycle guards only see recognised read-only
+        pipelines, so a model that alternates two similar probes, grows a
+        quoted argument, varies a chained tail, walks a ``sed -n`` window one
+        line at a time or keeps widening ``grep -B`` over a script's output
+        (``mvn …``, ``find … | xargs grep``, ``brief.py … | grep``) ran for
+        10-40 minutes unhalted.
+
+        Every foreground terminal call and every idempotent read-tool call is
+        normalised (see ``_near_duplicate_call``): digit runs become ``#`` and
+        a leading ``cd DIR &&`` is dropped, while quoted literals, paths and
+        other operands keep their identity. Two calls of the same tool are
+        near-duplicates (``_near_duplicates``) when their normalised token
+        sequences are identical; or when their shapes (quoted text as a
+        placeholder) have a difflib ratio of at least ``similarity`` AND
+        either every operand of one matches an operand of the other (equal
+        after digit normalisation, or a quoted term that grew from / was cut
+        back to the other: the growing-argument loop) or both start with the
+        same chain element and only a chained part differs.
+
+        A call makes progress when it asks something new, i.e. it names an
+        operand (a query term, quoted literal or path) that no call since the
+        last reset named, whatever its output (an empty result for a new
+        query is information); or when more than ``new_output_share`` of its
+        output lines were not shown by any observed call since the last
+        reset. Only non-progressing calls count.
+
+        Halts (hard stops only) with ``near_duplicate_loop_halt`` when
+        ``similar_calls`` of the last ``window`` calls are non-progressing
+        near-duplicates of the latest call, or when the latest calls repeat
+        a cycle of 2..``max_cycle_period`` calls ``cycle_laps`` times, each
+        position a non-progressing near-duplicate of the same position one
+        lap earlier.
+
+        A file edit (write_file, patch, execute_code, delegate_task,
+        skill_manage), a terminal command that visibly writes (see
+        ``_terminal_command_mutates``), a background command, or a Kanban
+        board transition resets the history: calls before it prove nothing
+        about calls after it. Other tools are neither counted nor reset.
+        """
+        cfg = self.config.near_duplicate
+        if not cfg.enabled:
+            return None
+        if (
+            tool_name in _PHASE_CHANGING_TOOLS
+            or tool_name in _KANBAN_TRANSITION_TOOLS
+        ):
+            self._nd_reset()
+            return None
+        if tool_name == "terminal":
+            command = args.get("command")
+            if not isinstance(command, str) or args.get("background"):
+                self._nd_reset()
+                return None
+            if _terminal_command_mutates(command):
+                self._nd_reset()
+                return None
+            entry_parts = _near_duplicate_call(command, str(args.get("workdir") or ""))
+        elif self._is_idempotent(tool_name):
+            entry_parts = _near_duplicate_arg_call(args)
+        else:
+            return None
+
+        shape, exact, operands, head = entry_parts
+        # A new operand (query term, literal or path) is a new question: its
+        # answer is information even when empty. A literal that only grew
+        # from (or was cut back to) one already asked is not new.
+        novel = False
+        for operand in operands:
+            if not any(_operands_match(operand, seen) for seen in self._nd_operands):
+                novel = True
+        for operand in operands:
+            if operand not in self._nd_operands:
+                self._nd_operands.append(operand)
+        lines = _result_content_lines(result)
+        new = 0
+        for line in lines:
+            digest = hashlib.sha256(line.encode("utf-8", "surrogatepass")).digest()[:16]
+            if digest not in self._nd_seen:
+                self._nd_seen.add(digest)
+                new += 1
+        progressing = novel or (bool(lines) and new > cfg.new_output_share * len(lines))
+        entry = _NearDuplicateCall(
+            tool_name=tool_name,
+            tokens=shape,
+            progressing=progressing,
+            description=_describe_call(tool_name, args),
+            exact=exact,
+            operands=operands,
+            head=head,
+        )
+        self._nd_history.append(entry)
+        keep = max(cfg.window, cfg.cycle_laps * cfg.max_cycle_period)
+        if len(self._nd_history) > keep:
+            del self._nd_history[:-keep]
+        if progressing or self._halt_decision is not None:
+            return None
+
+        history = self._nd_history
+        similar = [
+            e for e in history[-cfg.window:]
+            if not e.progressing and _near_duplicates(e, entry, cfg.similarity)
+        ]
+        count = len(similar)
+        loop = ""
+        if count >= cfg.similar_calls:
+            loop = (
+                f"{count} of the last {min(len(history), cfg.window)} {tool_name} calls "
+                f"were near-duplicates of one call ({entry.description})"
+            )
+        else:
+            for period in range(2, cfg.max_cycle_period + 1):
+                laps = _near_duplicate_cycle_laps(history, period, cfg.similarity)
+                if laps >= cfg.cycle_laps:
+                    members = "; ".join(e.description for e in history[-period:])
+                    count = laps
+                    loop = (
+                        f"a cycle of {period} near-duplicate calls was repeated "
+                        f"{laps} times ({members})"
+                    )
+                    break
+        if loop and self.config.hard_stop_enabled:
+            decision = ToolGuardrailDecision(
+                action="halt",
+                code=NEAR_DUPLICATE_HALT_CODE,
+                message=(
+                    f"Stopped {tool_name}: {loop}, with no new output, no file edit "
+                    "and no board transition in between. Only numbers, a growing "
+                    "quoted argument or a chained part changed between these "
+                    "calls, and none of them asked about a new term or file, so "
+                    "repeating them cannot find anything new. Nothing on disk was "
+                    "changed by this stop: the working tree and any retained "
+                    "candidate stay as they are. Use the content already shown, "
+                    "make the change, or end the run with the card's stated "
+                    "terminator."
+                ),
+                tool_name=tool_name,
+                count=count,
+                signature=ToolCallSignature(
+                    tool_name=tool_name,
+                    args_hash=_sha256(json.dumps([tool_name, list(entry.exact)])),
+                ),
+                family=loop[:300],
+            )
+            self._halt_decision = decision
+            return decision
+        if self.config.warnings_enabled and (loop or count >= cfg.warn_after):
+            loop = loop or (
+                f"{count} of the last {min(len(history), cfg.window)} {tool_name} "
+                f"calls were near-duplicates of one call ({entry.description})"
+            )
+            return ToolGuardrailDecision(
+                action="warn",
+                code=NEAR_DUPLICATE_WARN_CODE,
+                message=(
+                    f"{loop}, with no new output and no edit in between. This "
+                    "looks like a loop: use what was already shown, make the "
+                    "change, or stop."
+                ),
+                tool_name=tool_name,
+                count=count,
+            )
+        return None
+
+    def _nd_reset(self) -> None:
+        self._nd_history.clear()
+        self._nd_seen.clear()
+        self._nd_operands.clear()
+
     def _new_phase(self) -> None:
         """An evidence-changing call: reads before it prove nothing about after."""
         self._read_families.clear()
@@ -1464,6 +1721,306 @@ def _result_content_lines(result: str | None) -> list:
         lines.append(line)
     return lines
 
+# ── Near-duplicate loop guard (_observe_near_duplicate) ──────────────────
+
+NEAR_DUPLICATE_HALT_CODE = "near_duplicate_loop_halt"
+NEAR_DUPLICATE_WARN_CODE = "near_duplicate_loop_warning"
+# Board transitions: after one of these the model is on a new step. Reads of
+# the board (kanban_show/kanban_list), heartbeats and comments are not.
+_KANBAN_TRANSITION_TOOLS = frozenset(
+    {"kanban_complete", "kanban_block", "kanban_request_review",
+     "kanban_request_changes", "kanban_create", "kanban_unblock", "kanban_link",
+     "kanban_attach", "kanban_attach_url"}
+)
+# Shell tokens: quoted literals (an unterminated one runs to the end),
+# substitutions, redirections, operators, newlines and plain words.
+_ND_TOKEN = re.compile(
+    r"'[^']*'?"
+    r'|"(?:\\.|[^"\\])*"?'
+    r"|\$\((?:[^()]|\([^()]*\))*\)?"
+    r"|`[^`]*`?"
+    r"|\d*>>?[|&]?\d*-?|&>>?|<<<?-?|<"
+    r"|\|\||&&|[|;&()\n]"
+    r"|[^\s'\"|;&<>()`]+"
+)
+_ND_SEPARATORS = frozenset({"|", "||", "&&", ";", "&", "\n", "(", ")"})
+_ND_DIGITS = re.compile(r"\d+")
+_ND_FD_DUP = re.compile(r">&\d*-?$")
+_ND_SINKS = frozenset({"/dev/null", "/dev/stdout", "/dev/stderr"})
+# Programs that change files or the repository whatever their arguments.
+_ND_WRITING_PROGRAMS = frozenset(
+    {"rm", "mv", "cp", "mkdir", "rmdir", "touch", "tee", "ln", "chmod", "chown",
+     "install", "truncate", "patch", "dd", "rsync", "unzip", "tar", "sponge"}
+)
+_ND_IN_PLACE_PROGRAMS = frozenset({"sed", "gsed", "perl", "ruby"})
+_ND_PREFIX_PROGRAMS = frozenset({"sudo", "env", "command", "time", "xargs", "nohup"})
+_ND_GIT_WRITING = frozenset(
+    {"add", "am", "apply", "checkout", "cherry-pick", "clean", "clone", "commit",
+     "init", "merge", "mv", "pull", "rebase", "reset", "restore", "revert", "rm",
+     "stash", "switch", "tag"}
+)
+# A script body (python -c, heredoc) that writes files.
+_ND_SCRIPT_WRITES = re.compile(
+    r"\.write\(|write_text\(|write_bytes\("
+    r"|\bos\.(?:remove|rename|replace|unlink|makedirs|mkdir)\("
+    r"|\bshutil\."
+    r"|\bopen\([^)]*,\s*(?:mode\s*=\s*)?['\"][^'\"]*[wax]"
+)
+
+
+@dataclass(frozen=True)
+class _NearDuplicateCall:
+    tool_name: str
+    tokens: tuple  # shape: digit runs as ``#``, quoted text as a placeholder
+    progressing: bool
+    description: str
+    exact: tuple = ()  # digit runs as ``#``, quoted text kept
+    operands: tuple = ()  # query terms, literals and paths, digit-normalised
+    head: tuple = ()  # exact tokens of the first chain element
+
+
+def _shell_tokens(command: str) -> list:
+    return _ND_TOKEN.findall(command)
+
+
+def _shell_segments(tokens: list) -> list:
+    segments: list = [[]]
+    for tok in tokens:
+        if tok in _ND_SEPARATORS:
+            segments.append([])
+        else:
+            segments[-1].append(tok)
+    return [seg for seg in segments if seg]
+
+
+def _is_quoted(tok: str) -> bool:
+    return tok[:1] in ("'", '"', "`") or tok.startswith("$(")
+
+
+def _normalise_word(word: str) -> str:
+    return _ND_DIGITS.sub("#", word)
+
+
+# Chain operators: what follows one of these is a separate command.
+_ND_CHAIN = frozenset({"||", "&&", ";", "&", "\n"})
+# Shortest operand for which one containing the other counts as the same
+# question grown or cut back (``spring`` / ``org.springframework``).
+_ND_MIN_CONTAINED = 4
+
+
+def _unquote(tok: str) -> str:
+    if tok[:1] in ("'", '"', "`"):
+        body = tok[1:]
+        if body.endswith(tok[0]):
+            body = body[:-1]
+        return body
+    return tok
+
+
+def _segment_operands(seg: list) -> list:
+    """Operands of one simple command: every argument after the program that
+    is not an option, a redirection or a sink. Quoted text is always kept."""
+    k = 0
+    while k < len(seg):
+        if _ENV_ASSIGNMENT.match(seg[k]):
+            k += 1
+        elif seg[k] in _ND_PREFIX_PROGRAMS:
+            k += 1
+            while k < len(seg) and seg[k].startswith("-"):
+                k += 1
+        else:
+            break
+    out = []
+    for tok in seg[k + 1:]:
+        if _is_quoted(tok):
+            value = _unquote(tok)
+        elif tok.startswith("-") or ">" in tok or "<" in tok or tok in _ND_SINKS:
+            continue
+        else:
+            value = tok
+        value = _normalise_word(value)
+        if value:
+            out.append(value)
+    return out
+
+
+def _near_duplicate_call(command: str, workdir: str = "") -> tuple:
+    """``(shape, exact, operands, head)`` of a terminal command.
+
+    Digit runs become ``#`` and leading ``cd DIR`` segments are dropped.
+    ``shape`` also replaces quoted literals and ``$(...)``/backtick
+    substitutions with ``'…'``; ``exact`` keeps them. ``operands`` are the
+    query terms, literals and paths the command names (see
+    ``_segment_operands``); ``head`` is the exact first chain element.
+    """
+    tokens = _shell_tokens(command)
+    while tokens and tokens[0] == "cd":
+        k = 1
+        while k < len(tokens) and tokens[k] not in _ND_SEPARATORS:
+            k += 1
+        tokens = tokens[k + 1:]
+    shape: list = []
+    exact: list = []
+    for tok in tokens:
+        if tok == "\n":
+            shape.append(";")
+            exact.append(";")
+        elif _is_quoted(tok):
+            shape.append("'…'")
+            exact.append("'" + _normalise_word(_unquote(tok)) + "'")
+        else:
+            word = _normalise_word(tok)
+            shape.append(word)
+            exact.append(word)
+    head: list = []
+    for tok in exact:
+        if tok in _ND_CHAIN or tok == ";":
+            break
+        head.append(tok)
+    operands: list = []
+    if workdir:
+        operands.append(_normalise_word(workdir))
+        shape.insert(0, operands[0])
+        exact.insert(0, operands[0])
+    for seg in _shell_segments(tokens):
+        operands.extend(_segment_operands(seg))
+    return tuple(shape), tuple(exact), tuple(operands), tuple(head)
+
+
+def _near_duplicate_arg_call(args: Mapping[str, Any]) -> tuple:
+    """``(shape, exact, operands, head)`` of a read tool's arguments.
+
+    Tokens are normalised ``key=value`` pairs; the operands are the
+    non-numeric string values (path, pattern, query …), so reading another
+    file or searching another term is a different call.
+    """
+    tokens = []
+    operands = []
+    for key in sorted(args, key=str):
+        value = args[key]
+        if isinstance(value, (dict, list)):
+            value = canonical_tool_args({"v": value})
+        text = _normalise_word(str(value))
+        tokens.append(f"{key}={text}")
+        if isinstance(value, str) and text.strip("#"):
+            operands.append(text)
+    return tuple(tokens), tuple(tokens), tuple(operands), ()
+
+
+def _operands_match(a: str, b: str) -> bool:
+    """Same operand: equal after digit normalisation, or a term (not a path)
+    that grew from or was cut back to the other."""
+    if a == b:
+        return True
+    if "/" in a or "/" in b:
+        return False
+    short, long_ = (a, b) if len(a) <= len(b) else (b, a)
+    return len(short) >= _ND_MIN_CONTAINED and short in long_
+
+
+def _operands_correspond(a: tuple, b: tuple) -> bool:
+    if len(a) != len(b):
+        return False
+    return all(any(_operands_match(x, y) for y in b) for x in a) and all(
+        any(_operands_match(y, x) for x in a) for y in b
+    )
+
+
+def _terminal_command_mutates(command: str) -> bool:
+    """Whether a terminal command visibly writes a file or the repository.
+
+    Deliberately generous: a write resets the near-duplicate history, so a
+    false "writes" only delays a halt. Counted as writes: output redirection
+    to a file, a writing program (``rm``, ``mv``, ``cp``, ``tee`` …), an
+    in-place editor (``sed -i``, ``perl -pi``), a writing git subcommand, or
+    a script body that writes (``open(…, 'w')``, ``.write(``, ``shutil.``).
+    """
+    tokens = _shell_tokens(command)
+    for i, tok in enumerate(tokens):
+        if ">" in tok and not _is_quoted(tok):
+            if _ND_FD_DUP.search(tok):
+                continue  # descriptor duplication such as 2>&1
+            target = tokens[i + 1] if i + 1 < len(tokens) else ""
+            if target not in _ND_SINKS:
+                return True
+    for seg in _shell_segments(tokens):
+        k = 0
+        while k < len(seg):
+            if _ENV_ASSIGNMENT.match(seg[k]):
+                k += 1
+            elif seg[k] in _ND_PREFIX_PROGRAMS:
+                k += 1
+                while k < len(seg) and seg[k].startswith("-"):
+                    k += 1
+            else:
+                break
+        if k >= len(seg):
+            continue
+        program = seg[k].rsplit("/", 1)[-1]
+        rest = seg[k + 1:]
+        if program in _ND_WRITING_PROGRAMS:
+            return True
+        if program in _ND_IN_PLACE_PROGRAMS:
+            for a in rest:
+                if a == "--in-place" or a.startswith("--in-place="):
+                    return True
+                if a.startswith("-") and not a.startswith("--") and "i" in a[1:].split(".")[0]:
+                    return True
+        if program == "git":
+            m = 0
+            while m < len(rest) and rest[m].startswith("-"):
+                m += 2 if rest[m] in ("-C", "-c", "--git-dir", "--work-tree") else 1
+            if m < len(rest) and rest[m] in _ND_GIT_WRITING:
+                return True
+    return bool(_ND_SCRIPT_WRITES.search(command))
+
+
+def _near_duplicates(a: _NearDuplicateCall, b: _NearDuplicateCall, threshold: float) -> bool:
+    """Whether two calls ask the same thing (see ``_observe_near_duplicate``).
+
+    Identical after digit normalisation; or a similar shape whose operands
+    correspond (only numbers changed, or a quoted term grew / was cut back);
+    or a similar shape with the same first chain element (only a chained
+    part changed). A different query term, literal or path is a different
+    call however similar the rest of the command is.
+    """
+    if a.tool_name != b.tool_name:
+        return False
+    if a.exact == b.exact:
+        return True
+    ratio = difflib.SequenceMatcher(None, a.tokens, b.tokens, autojunk=False).ratio()
+    if ratio < threshold:
+        return False
+    if _operands_correspond(a.operands, b.operands):
+        return True
+    return bool(a.head) and a.head == b.head and len(a.head) < len(a.exact) and len(b.head) < len(b.exact)
+
+
+def _near_duplicate_cycle_laps(history: list, period: int, threshold: float) -> int:
+    """Laps of the trailing cycle of ``period`` calls: every call in it is
+    non-progressing and a near-duplicate of the call one period earlier."""
+    run = 0
+    j = len(history) - 1
+    while j - period >= 0:
+        a, b = history[j], history[j - period]
+        if a.progressing or b.progressing or not _near_duplicates(a, b, threshold):
+            break
+        run += 1
+        j -= 1
+    if run == 0:
+        return 0
+    return (run + period) // period
+
+
+def _unit_float(value: Any, default: float) -> float:
+    if value is None or isinstance(value, bool):
+        return default
+    try:
+        parsed = float(value)
+    except (TypeError, ValueError):
+        return default
+    return parsed if 0.0 < parsed <= 1.0 else default
+
 
