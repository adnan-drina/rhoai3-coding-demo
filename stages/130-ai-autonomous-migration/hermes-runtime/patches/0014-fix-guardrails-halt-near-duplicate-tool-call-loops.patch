+def test_terminal_write_classifier():
+    writes = [
+        "cat > src/A.java <<'EOF'\nclass A {}\nEOF",
+        "echo x >> notes.txt",
+        "sed -i.bak 's/a/b/' f",
+        "perl -pi -e 's/a/b/' f",
+        "git apply fix.patch",
+        "git -C repo commit -am x",
+        "cp a b",
+        "cd /projects/app && rm -f target/x",
+        "python3 -c \"open('f', 'w').write('x')\"",
+        "grep -l x src | xargs rm",
+    ]
+    reads = [
+        "grep -rn x src 2>/dev/null",
+        "mvn dependency:tree 2>&1 | grep spring",
+        "sed -n '1,5p' f",
+        "git status --short && git diff",
+        "python3 -c \"print(open('f').read()[:100])\"",
+        "grep -n '>' f",
+        "python3 verification/loop/brief.py --section unit",
+    ]
+    assert all(_terminal_command_mutates(c) for c in writes), [c for c in writes if not _terminal_command_mutates(c)]
+    assert not any(_terminal_command_mutates(c) for c in reads), [c for c in reads if _terminal_command_mutates(c)]
