+@dataclass(frozen=True)
+class NearDuplicateConfig:
+    """Thresholds of the near-duplicate loop guard (RHOAI3 V21, patch 0014).
+
+    Read from ``tool_loop_guardrails.near_duplicate``. The guard only halts
+    when ``hard_stop_enabled`` is set (like every other loop halt) and
+    ``enabled`` is true. See ``_observe_near_duplicate``.
+
+    - ``window`` / ``similar_calls``: halt when ``similar_calls`` of the last
+      ``window`` observed calls are non-progressing near-duplicates of the
+      latest call (16 / 12: the live loops ran 20 to 160+ calls; a
+      fix-until-green iteration edits or transitions within a few calls, and
+      up to 4 interleaved different calls in 16 still halt).
+    - ``cycle_laps`` / ``max_cycle_period``: halt when the latest calls repeat
+      a cycle of 2..``max_cycle_period`` calls ``cycle_laps`` times, position
+      by position near-duplicate and non-progressing (6 laps: 12 calls for a
+      pair, 18 for a triple).
+    - ``warn_after``: from this many near-duplicates on, the current result
+      carries a loop warning (warnings_enabled only).
+    - ``similarity``: token-sequence ratio (difflib) of two normalised calls
+      at or above which they are near-duplicates.
+    - ``new_output_share``: a call makes progress when MORE than this share
+      of its output lines were not shown since the last edit or transition.
+      A call that names a new operand (query term, literal or path) makes
+      progress whatever its output.
+    """
+
+    enabled: bool = True
+    window: int = 16
+    similar_calls: int = 12
+    cycle_laps: int = 6
+    max_cycle_period: int = 3
+    warn_after: int = 8
+    similarity: float = 0.75
+    new_output_share: float = 0.5
+
+    @classmethod
+    def from_mapping(cls, data: Mapping[str, Any] | None) -> "NearDuplicateConfig":
+        if not isinstance(data, Mapping):
+            return cls()
+        d = cls()
+        window = _positive_int(data.get("window"), d.window)
+        similar = min(_positive_int(data.get("similar_calls"), d.similar_calls), window)
+        return cls(
+            enabled=_as_bool(data.get("enabled"), d.enabled),
+            window=window,
+            similar_calls=max(similar, 2),
+            cycle_laps=max(_positive_int(data.get("cycle_laps"), d.cycle_laps), 2),
+            max_cycle_period=max(_positive_int(data.get("max_cycle_period"), d.max_cycle_period), 2),
+            warn_after=_positive_int(data.get("warn_after"), d.warn_after),
+            similarity=_unit_float(data.get("similarity"), d.similarity),
+            new_output_share=_unit_float(data.get("new_output_share"), d.new_output_share),
+        )
+
+
