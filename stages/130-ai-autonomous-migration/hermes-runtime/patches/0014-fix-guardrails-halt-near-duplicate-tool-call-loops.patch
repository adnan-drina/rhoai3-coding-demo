+def test_alternating_pair_run44_halts():
+    spring = "\n".join(
+        [f"[INFO] +- org.springframework:spring-mod{i}:jar:6.1.{i}:compile" for i in range(25)]
+        + [f"[INFO] |  +- io.spring.gradle:spring-extra{i}:jar:1.{i}:compile" for i in range(15)]
+    )
+    org = "\n".join(line for line in spring.splitlines() if "org.springframework" in line)
+    calls = []
+    for _ in range(20):
+        calls.append(_term('mvn dependency:tree | grep "spring"', spring))
+        calls.append(_term('mvn dependency:tree | grep "org.springframework"', org))
+    index, halt, warnings = _replay(_hard_stop(), calls)
+    assert halt is not None and halt.code == NEAR_DUPLICATE_HALT_CODE
+    assert index <= 13  # 12 non-progressing near-duplicates after the first call
+    assert NEAR_DUPLICATE_WARN_CODE in warnings
+    assert "near-duplicate" in halt.message
