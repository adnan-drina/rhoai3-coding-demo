{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "coolstore-inventory-service",
        "namespace": "coolstore-dev",
        "labels": {
          "app.kubernetes.io/name": "coolstore-inventory-service",
          "app.kubernetes.io/component": "inventory",
          "app.kubernetes.io/part-of": "coolstore",
          "app.openshift.io/runtime": "quarkus",
          "backstage.io/kubernetes-id": "coolstore-inventory-service"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "coolstore-inventory-service",
            "app.kubernetes.io/component": "inventory"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "coolstore-inventory-service",
              "app.kubernetes.io/component": "inventory",
              "app.kubernetes.io/part-of": "coolstore",
              "backstage.io/kubernetes-id": "coolstore-inventory-service"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "coolstore-inventory-service",
                "image": "image-registry.openshift-image-registry.svc:5000/coolstore-dev/coolstore-inventory-service:bootstrap",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080,
                    "protocol": "TCP"
                  }
                ],
                "livenessProbe": {
                  "httpGet": {
                    "path": "/q/health/live",
                    "port": "http"
                  },
                  "initialDelaySeconds": 20,
                  "periodSeconds": 20,
                  "timeoutSeconds": 3
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/q/health/ready",
                    "port": "http"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "coolstore-inventory-service",
        "namespace": "coolstore-dev",
        "labels": {
          "app.kubernetes.io/name": "coolstore-inventory-service",
          "app.kubernetes.io/component": "inventory",
          "app.kubernetes.io/part-of": "coolstore",
          "backstage.io/kubernetes-id": "coolstore-inventory-service"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "coolstore-inventory-service",
          "app.kubernetes.io/component": "inventory"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": "http",
            "protocol": "TCP"
          }
        ]
      }
    },
    {
      "apiVersion": "route.openshift.io/v1",
      "kind": "Route",
      "metadata": {
        "name": "coolstore-inventory-service",
        "namespace": "coolstore-dev",
        "labels": {
          "app.kubernetes.io/name": "coolstore-inventory-service",
          "app.kubernetes.io/component": "inventory",
          "app.kubernetes.io/part-of": "coolstore",
          "backstage.io/kubernetes-id": "coolstore-inventory-service"
        }
      },
      "spec": {
        "to": {
          "kind": "Service",
          "name": "coolstore-inventory-service"
        },
        "port": {
          "targetPort": "http"
        },
        "tls": {
          "termination": "edge",
          "insecureEdgeTerminationPolicy": "Redirect"
        }
      }
    }
  ]
}
