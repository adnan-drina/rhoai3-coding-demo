+func TestReplayMigrationRefusesDuplicateHistory(t *testing.T) {
+	for _, source := range []string{"'legacy-source'", "NULL"} {
+		t.Run(source, func(t *testing.T) {
+			s, ctx := openTestStore(t)
+			dsn := replayStoreDSN(t, s, ctx)
+			if _, err := s.db.ExecContext(ctx, `DROP INDEX usage_events_source_event_id;
+				ALTER TABLE usage_events DROP COLUMN raw_event;
+				ALTER TABLE usage_events DROP COLUMN usage_complete;
+				INSERT INTO usage_events (event_id, username, model, source, total_tokens)
+				VALUES ('legacy-id','legacy','synthetic',`+source+`,10), ('legacy-id','legacy','synthetic',`+source+`,20)`); err != nil {
+				t.Fatal(err)
+			}
+			before := usageChecksum(t, s, ctx)
+			failed, err := New(dsn, 0)
+			if err == nil {
+				failed.Close()
+				t.Fatal("duplicate history must refuse migration")
+			}
+			if !strings.Contains(err.Error(), "duplicate source/event_id rows exist") {
+				t.Fatalf("migration lacks actionable conflict: %v", err)
+			}
+			if after := usageChecksum(t, s, ctx); after != before || after.rows != 2 || after.tokens != 30 {
+				t.Fatalf("migration changed historical usage: before=%+v after=%+v", before, after)
+			}
+		})
+	}
+}
