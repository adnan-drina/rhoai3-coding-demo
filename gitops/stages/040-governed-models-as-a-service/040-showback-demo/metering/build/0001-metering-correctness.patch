+++ b/internal/handler/health_test.go
@@ -0,0 +1,54 @@
+package handler
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+type databaseCheckerStub struct {
+	err      error
+	calls    int
+	deadline time.Time
+}
+
+func (s *databaseCheckerStub) CheckDatabase(ctx context.Context) error {
+	s.calls++
+	s.deadline, _ = ctx.Deadline()
+	return s.err
+}
+
+func TestHealthHandler_DatabaseOutageAndRecovery(t *testing.T) {
+	s := &databaseCheckerStub{}
+	h := NewHealthHandler(s)
+	for _, path := range []string{"/health", "/ready"} {
+		for _, status := range []int{200, 503, 200} {
+			s.err = nil
+			if status == 503 {
+				s.err = errors.New("database unavailable")
+			}
+			w := httptest.NewRecorder()
+			h.HandleHealth(w, httptest.NewRequest(http.MethodGet, path, nil))
+			if w.Code != status {
+				t.Fatalf("%s status=%d want=%d", path, w.Code, status)
+			}
+			if s.deadline.IsZero() || time.Until(s.deadline) <= 0 || time.Until(s.deadline) > time.Second {
+				t.Fatal("database check has no bounded one-second deadline")
+			}
+		}
+	}
+	if s.calls != 6 {
+		t.Fatalf("health was cached or skipped: calls=%d", s.calls)
+	}
+}
+
+func TestHealthHandler_MissingStoreIsUnavailable(t *testing.T) {
+	w := httptest.NewRecorder()
+	NewHealthHandler(nil).HandleHealth(w, httptest.NewRequest(http.MethodGet, "/ready", nil))
+	if w.Code != 503 {
+		t.Fatalf("missing database status=%d", w.Code)
+	}
+}
