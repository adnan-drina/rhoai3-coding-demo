+func TestReplayIncompleteUsageStaysUnknownAcrossBackfillAndReopen(t *testing.T) {
+	s, ctx := openTestStore(t)
+	e := replayFixture()
+	e.Timestamp = time.Now().UTC().Add(-2 * time.Hour)
+	complete := false
+	status := 503
+	e.UsageComplete, e.StatusCode = &complete, &status
+	e.PromptTokens, e.CompletionTokens, e.TotalTokens = 0, 0, 0
+	e.RawEvent = json.RawMessage(`{"id":"replay-test","source":"test-source","data":{"status_code":503}}`)
+	if err := s.InsertEvent(ctx, e); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.db.ExecContext(ctx, costBackfillSQL, 0, 1000); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.costStep(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.rebuildStep(ctx); err != nil {
+		t.Fatal(err)
+	}
+	dsn := replayStoreDSN(t, s, ctx)
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	reopened, err := New(dsn, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reopened.Close()
+	if err := reopened.InsertEvent(ctx, e); err != nil {
+		t.Fatal(err)
+	}
+	if err := reopened.refreshRecentHours(ctx); err != nil {
+		t.Fatal(err)
+	}
+	var known bool
+	var cost sql.NullString
+	var tokens, storedStatus int
+	if err := reopened.db.QueryRowContext(ctx, `SELECT usage_complete, cost_usd, total_tokens, status_code
+		FROM usage_events WHERE source=$1 AND event_id=$2`, e.Source, e.EventID).
+		Scan(&known, &cost, &tokens, &storedStatus); err != nil {
+		t.Fatal(err)
+	}
+	if known || cost.Valid || tokens != 0 || storedStatus != 503 {
+		t.Fatalf("unknown audit row became known: complete=%v cost=%+v tokens=%d status=%d", known, cost, tokens, storedStatus)
+	}
+	assertReplayTotals(t, reopened, ctx, 1, 0)
+	complete = true
+	e.EventID, e.RawEvent = "known-zero", json.RawMessage(`{"id":"known-zero","data":{"prompt_tokens":0,"completion_tokens":0,"total_tokens":0}}`)
+	if err := reopened.InsertEvent(ctx, e); err != nil {
+		t.Fatal(err)
+	}
+	if err := reopened.db.QueryRowContext(ctx, `SELECT usage_complete, cost_usd FROM usage_events WHERE event_id='known-zero'`).
+		Scan(&known, &cost); err != nil {
+		t.Fatal(err)
+	}
+	if !known || !cost.Valid || cost.String != "0.00000000" {
+		t.Fatalf("authoritative zero is not distinct: complete=%v cost=%+v", known, cost)
+	}
+}
