+	"time"
+)
+
+// These tests use the existing DATABASE_URL convention and isolated database
+// helper. They exercise actual unique-index and transaction behavior; no mock
+// can establish the concurrent delivery or rollback guarantees.
+func replayFixture() UsageEvent {
+	return UsageEvent{
+		EventID: "replay-test", Timestamp: time.Date(2026, 10, 19, 12, 0, 0, 0, time.UTC),
+		Username: "synthetic", GroupName: "synthetic", Model: "synthetic", Provider: "synthetic",
+		Source: "test-source", PromptTokens: 100, CompletionTokens: 20, TotalTokens: 120,
+		RawEvent: json.RawMessage(`{"id":"replay-test","source":"test-source","extension":{"version":1},"data":{"prompt_tokens":100,"completion_tokens":20,"total_tokens":120}}`),
+	}
+}
+
+func assertReplayTotals(t *testing.T, s *Store, ctx context.Context, requests, tokens int) {
+	t.Helper()
+	var rows, rawTokens, rollRequests, rollTokens int
+	var costEqual bool
+	err := s.db.QueryRowContext(ctx, `SELECT
+		(SELECT COUNT(*) FROM usage_events),
+		(SELECT COALESCE(SUM(total_tokens),0) FROM usage_events),
+		(SELECT COALESCE(SUM(requests),0) FROM usage_hourly),
+		(SELECT COALESCE(SUM(total_tokens),0) FROM usage_hourly),
+		(SELECT COALESCE(SUM(cost_usd),0) FROM usage_events) =
+		(SELECT COALESCE(SUM(cost_usd),0) FROM usage_hourly)`).
+		Scan(&rows, &rawTokens, &rollRequests, &rollTokens, &costEqual)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rows != requests || rollRequests != requests || rawTokens != tokens || rollTokens != tokens || !costEqual {
+		t.Fatalf("raw=(%d,%d) rollup=(%d,%d) costEqual=%v; want=(%d,%d)",
+			rows, rawTokens, rollRequests, rollTokens, costEqual, requests, tokens)
+	}
+}
+
+func TestReplaySemanticEqualityConflictAndSourceScope(t *testing.T) {
+	s, ctx := openTestStore(t)
+	e := replayFixture()
+	if err := s.InsertEvent(ctx, e); err != nil {
+		t.Fatal(err)
+	}
+	// JSONB semantic equality accepts formatting/key order and equal numbers.
+	e.RawEvent = json.RawMessage(`{ "data":{"total_tokens":120,"completion_tokens":20,"prompt_tokens":100}, "extension":{"version":1.0}, "source":"test-source", "id":"replay-test" }`)
+	if err := s.InsertEvent(ctx, e); err != nil {
+		t.Fatalf("identical replay: %v", err)
+	}
+	assertReplayTotals(t, s, ctx, 1, 120)
+	// Unknown fields matter too: comparing only decoded known fields is unsafe.
+	e.RawEvent = json.RawMessage(strings.Replace(string(e.RawEvent), `"version":1.0`, `"version":2`, 1))
+	if err := s.InsertEvent(ctx, e); !errors.Is(err, ErrEventConflict) {
+		t.Fatalf("changed extension: got %v, want conflict", err)
+	}
+	assertReplayTotals(t, s, ctx, 1, 120)
+	e.Source = "different-source"
+	e.RawEvent = json.RawMessage(strings.Replace(string(e.RawEvent), "test-source", e.Source, 1))
+	if err := s.InsertEvent(ctx, e); err != nil {
+		t.Fatalf("same ID in another source: %v", err)
+	}
+	assertReplayTotals(t, s, ctx, 2, 240)
+}
+
+func TestReplayConcurrentIdentical(t *testing.T) {
+	s, base := openTestStore(t)
+	ctx, cancel := context.WithTimeout(base, 15*time.Second)
+	defer cancel()
+	const writers = 16
+	start := make(chan struct{})
+	results := make(chan error, writers)
+	var wg sync.WaitGroup
+	for i := 0; i < writers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			results <- s.InsertEvent(ctx, replayFixture())
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(results)
+	for err := range results {
+		if err != nil {
+			t.Errorf("concurrent replay: %v", err)
+		}
+	}
+	assertReplayTotals(t, s, ctx, 1, 120)
+}
