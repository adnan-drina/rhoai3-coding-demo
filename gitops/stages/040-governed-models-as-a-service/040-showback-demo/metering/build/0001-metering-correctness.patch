+func TestReplayMigrationLeavesLegacyCompletenessUnknownAndCostUnchanged(t *testing.T) {
+	s, ctx := openTestStore(t)
+	if _, err := s.db.ExecContext(ctx, `DROP INDEX usage_events_source_event_id;
+		ALTER TABLE usage_events DROP COLUMN raw_event;
+		ALTER TABLE usage_events DROP COLUMN usage_complete;
+		INSERT INTO usage_events (event_id, username, model, source, prompt_tokens, completion_tokens, total_tokens, cost_usd)
+		VALUES ('legacy-priced','legacy','synthetic','legacy-source',100,20,120,5.25),
+		       ('legacy-unpriced','legacy','synthetic','legacy-source',100,20,120,NULL)`); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.migrate(ctx); err != nil {
+		t.Fatal(err)
+	}
+	for _, backfilled := range []bool{false, true} {
+		if backfilled {
+			if _, err := s.db.ExecContext(ctx, costBackfillSQL, 0, 1000); err != nil {
+				t.Fatal(err)
+			}
+		}
+		var complete sql.NullBool
+		var raw, cost sql.NullString
+		if err := s.db.QueryRowContext(ctx, `SELECT usage_complete, raw_event, cost_usd
+			FROM usage_events WHERE event_id='legacy-priced'`).Scan(&complete, &raw, &cost); err != nil {
+			t.Fatal(err)
+		}
+		if complete.Valid || raw.Valid || !cost.Valid || cost.String != "5.25000000" {
+			t.Fatalf("legacy history changed (backfilled=%v): complete=%+v raw=%+v cost=%+v", backfilled, complete, raw, cost)
+		}
+		if err := s.db.QueryRowContext(ctx, `SELECT usage_complete, raw_event, cost_usd
+			FROM usage_events WHERE event_id='legacy-unpriced'`).Scan(&complete, &raw, &cost); err != nil {
+			t.Fatal(err)
+		}
+		if complete.Valid || raw.Valid || cost.Valid != backfilled || (backfilled && cost.String != "0.00300000") {
+			t.Fatalf("legacy estimate was qualified or behavior changed (backfilled=%v): complete=%+v raw=%+v cost=%+v",
+				backfilled, complete, raw, cost)
+		}
+	}
+}
