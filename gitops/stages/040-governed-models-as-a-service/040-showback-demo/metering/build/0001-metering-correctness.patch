+func TestCheckDatabaseUsesPrimaryAndContext(t *testing.T) {
+	s, ctx := openTestStore(t)
+	if err := s.CheckDatabase(ctx); err != nil {
+		t.Fatal(err)
+	}
+	canceled, cancel := context.WithCancel(ctx)
+	cancel()
+	if err := s.CheckDatabase(canceled); err == nil {
+		t.Fatal("canceled readiness must fail")
+	}
+	replica, err := sql.Open("postgres", replayStoreDSN(t, s, ctx))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer replica.Close()
+	s.readDB = replica
+	if err := s.db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := replica.PingContext(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.CheckDatabase(ctx); err == nil {
+		t.Fatal("a healthy replica cannot hide unavailable primary")
+	}
+}
