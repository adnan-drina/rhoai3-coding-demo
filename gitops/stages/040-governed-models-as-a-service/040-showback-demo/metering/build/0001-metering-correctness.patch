--- /dev/null
+++ b/internal/handler/health.go
@@ -0,0 +1,30 @@
+package handler
+
+import (
+	"context"
+	"net/http"
+	"time"
+)
+
+type databaseChecker interface {
+	CheckDatabase(context.Context) error
+}
+
+type HealthHandler struct {
+	store databaseChecker
+}
+
+func NewHealthHandler(store databaseChecker) *HealthHandler {
+	return &HealthHandler{store: store}
+}
+
+// Both probes check the primary database, which ingestion and entitlements need.
+func (h *HealthHandler) HandleHealth(w http.ResponseWriter, r *http.Request) {
+	ctx, cancel := context.WithTimeout(r.Context(), time.Second)
+	defer cancel()
+	if h.store == nil || h.store.CheckDatabase(ctx) != nil {
+		http.Error(w, "database unavailable", http.StatusServiceUnavailable)
+		return
+	}
+	w.WriteHeader(http.StatusOK)
+}
