+func TestReplayConcurrentConflictingPayloads(t *testing.T) {
+	s, base := openTestStore(t)
+	ctx, cancel := context.WithTimeout(base, 15*time.Second)
+	defer cancel()
+	const writers = 8
+	start := make(chan struct{})
+	results := make(chan error, writers)
+	for i := 0; i < writers; i++ {
+		e := replayFixture()
+		e.RawEvent = json.RawMessage(fmt.Sprintf(`{"id":"replay-test","source":"test-source","extension":%d}`, i%2))
+		go func(event UsageEvent) {
+			<-start
+			results <- s.InsertEvent(ctx, event)
+		}(e)
+	}
+	close(start)
+	accepted, conflicts := 0, 0
+	for i := 0; i < writers; i++ {
+		err := <-results
+		switch {
+		case err == nil:
+			accepted++
+		case errors.Is(err, ErrEventConflict):
+			conflicts++
+		default:
+			t.Fatalf("concurrent delivery: %v", err)
+		}
+	}
+	if accepted != writers/2 || conflicts != writers/2 {
+		t.Fatalf("accepted=%d conflicts=%d; want four of each", accepted, conflicts)
+	}
+	assertReplayTotals(t, s, ctx, 1, 120)
+}
