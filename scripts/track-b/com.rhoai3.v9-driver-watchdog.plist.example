<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Install (example):
    cp scripts/track-b/com.rhoai3.v9-driver-watchdog.plist.example \
       ~/Library/LaunchAgents/com.rhoai3.v9-driver-watchdog.plist
    # edit the WorkingDirectory / ProgramArguments paths
    launchctl load ~/Library/LaunchAgents/com.rhoai3.v9-driver-watchdog.plist
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.rhoai3.v9-driver-watchdog</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/adrina/Sandbox/rhoai3-coding-demo/scripts/track-b/v9-ensure-driver.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/adrina/Sandbox/rhoai3-coding-demo</string>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/v9-driver-watchdog.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/v9-driver-watchdog.err</string>
  </dict>
</plist>
