{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".agents/hooks/session-init.sh"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".agents/hooks/validate-yaml.sh",
        "matcher": "Write"
      },
      {
        "command": ".agents/hooks/check-docs-consistency.sh",
        "matcher": "Write"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .agents/hooks/guard-openshift-command.py",
        "matcher": "\\b(oc|kubectl)\\s|scripts/platform/resume-gpu-demo\\.sh|deploy\\.sh"
      }
    ]
  }
}
